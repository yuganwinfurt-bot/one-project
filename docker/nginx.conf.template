server {
    listen 127.0.0.1:${WEB_PORT};
    server_name _;
    client_max_body_size 110m;

    location = /agent {
        return 301 /agent/;
    }
    location ^~ /agent/ {
        rewrite ^/agent(/.*)$ $1 break;
        proxy_pass http://127.0.0.1:${AGENT_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    location = /rag {
        return 301 /rag/;
    }
    location ^~ /rag/api/ {
        rewrite ^/rag(/api/.*)$ $1 break;
        proxy_pass http://127.0.0.1:${RAG_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_buffering off;
        proxy_read_timeout 600s;
    }
    location ^~ /rag/ {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /rag/index.html;
    }

    location = /ecommerce {
        return 301 /ecommerce/;
    }
    location ^~ /ecommerce/api/ {
        rewrite ^/ecommerce(/api/.*)$ $1 break;
        proxy_pass http://127.0.0.1:${ECOMMERCE_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_buffering off;
        proxy_read_timeout 600s;
    }
    location ^~ /uploads/ {
        proxy_pass http://127.0.0.1:${ECOMMERCE_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location ^~ /ecommerce/ {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /ecommerce/index.html;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:${HUB_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
    location / {
        proxy_pass http://127.0.0.1:${HUB_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}
