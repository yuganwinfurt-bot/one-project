DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/ecom_analysis_agent
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256
SERVER_AUTH_STATUS_URL=http://127.0.0.1:8020/api/auth/status

# 大模型（OpenAI 兼容接口）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1

# 向量模型（课程默认：百炼 qwen3.7-text-embedding-flash，便宜的中文向量模型）
# EMBEDDING_API_KEY 留空时回退使用 LLM_API_KEY（同一百炼账号的 Key 可直接复用）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_TIMEOUT=60
# 注意：换向量模型后必须重跑 python -m data.seed.index_vectors 重建向量库

# 独立 RAG 服务（电商语义检索与商品/评价同步）
RAG_BASE_URL=http://127.0.0.1:8000
RAG_ECOM_KNOWLEDGE_BASE_ID=ecommerce-analysis-platform
RAG_SYNC_TOKEN=replace-with-the-same-long-random-token-as-rag
RAG_SEARCH_TIMEOUT_SECONDS=30
RAG_SYNC_TIMEOUT_SECONDS=600

# Chroma 本地目录（相对 backend/）
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=ecom_docs
