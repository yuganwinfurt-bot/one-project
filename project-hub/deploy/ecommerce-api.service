[Unit]
Description=Ecommerce Analysis API
Wants=network-online.target
After=network-online.target mysql.service rag-assistant.service yugan-agent.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/one-project/customer-service-system/customer-service-system/backend
# 模型请求和 LangGraph 检查点暂存在进程中，当前必须只启动 1 个 worker。
ExecStart=/home/ubuntu/one-project/customer-service-system/customer-service-system/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
