(() => {
  'use strict';

  const BUTTON_CLASS = 'bqa-quick-apply';
  const DISMISS_CLASS = 'bqa-not-interested';
  const COMPANY_DISMISS_CLASS = 'bqa-company-dismiss';
  const HIDDEN_COMPANIES_KEY = 'bqa-hidden-companies';
  const DISMISSED_JOBS_KEY = 'bqa-dismissed-jobs';
  const SETTINGS_KEY = 'bqa-ai-settings';
  const SETTINGS_BACKUP_KEY = 'bqa-ai-settings-backup';
  const DELIVERED_KEY = 'bqa-delivered-jobs';
  const DELIVERY_RECORDS_KEY = 'bqa-delivery-records';
  const DELIVERY_TASK_QUEUE_KEY = 'bqa-delivery-task-queue-v2';
  const SCREENING_RECORDS_KEY = 'bqa-screening-records';
  const SEARCH_RUN_STATUS_KEY = 'bqa-search-run-status';
  // 仅作为兼容内部调用的标记；不再写入独立全局批次存储。
  // 实际执行状态始终内聚在 bqa-delivery-task-queue-v2.active.execution。
  const BATCH_KEY = '__bqa_active_delivery_execution__';
  const PENDING_CHAT_KEY = 'bqa-pending-chat';
  const LAUNCHER_CLASS = 'bqa-ai-launcher';
  const MODAL_CLASS = 'bqa-modal';
  const BATCH_PROGRESS_CLASS = 'bqa-batch-progress';
  const LAUNCHER_POSITION_KEY = 'bqa-ai-launcher-position';
  const DEFAULT_DAILY_DELIVERY_LIMIT = 150;
  const DEFAULT_API_URL = 'https://api.deepseek.com/chat/completions';
  const DEFAULT_MODEL = 'deepseek-flash';
  const DEFAULT_SCREENING_PROMPT = '你是谨慎的求职助手。仅依据求职者简历、多个目标岗位画像与岗位信息判断岗位是否匹配。每个岗位画像必须独立判断；岗位方向明显无关、要求明显超出简历时应判为不匹配。判断理由要具体、简洁，且只能基于已提供的信息。';
  const MAX_LIVE_EXCLUDED_JOBS = 150;
  // 人工确认模式每批判断 3 个岗位，减少逐个请求的等待；自动投递仍逐个判断，便于尽早入队。
  const SCREENING_CHUNK_SIZE = 3;
  const AUTO_SCREENING_CHUNK_SIZE = 1;
  const TIMEOUT_MS = 15000;
  const POLL_MS = 120;
  const CITY_CODES = {
    全国: '100010000', 北京: '101010100', 上海: '101020100', 广州: '101280100', 深圳: '101280600',
    杭州: '101210100', 成都: '101270100', 武汉: '101200100', 南京: '101190100', 苏州: '101190400',
    西安: '101110100', 重庆: '101040100', 天津: '101030100', 长沙: '101250100', 郑州: '101180100',
    厦门: '101230200', 青岛: '101120200', 济南: '101120100', 合肥: '101220100', 佛山: '101280800',
  };
  const status = new WeakMap();
  let persistedHiddenCompanies = new Set();
  let persistedDismissedJobs = new Map();
  let persistedDeliveredJobs = new Map();
  let persistedDeliveryRecords = new Map();
  let dailyDeliveryLimit = DEFAULT_DAILY_DELIVERY_LIMIT;
  let cachedPageAuth = null;
  let activeLiveReview = null;
  let activeAiFlowSettings = null;
  let startedQueuedTaskLease = '';
  let batchTabLookupRetryTimer = 0;
  let cachedPageAuthAt = 0;
  let cachedChatCredentials = null;
  let lastStorageWriteError = '';
  let unreadMessageCount = null;
  let unreadBadgeSyncTimer = 0;
  let unreadBadgePollTimer = 0;
  let lastUnreadTabClickAt = 0;
  let pageClickRecoveryTimer = 0;
  let pageClickRecoveryAttempts = 0;
  let pageClickRecoveryRunning = false;
  let lastButtonCardSignature = '';
  const contactedCardCache = new WeakMap();
  let scheduleTimer = 0;
  // 快速投递复用批量投递的全局任务状态，必须串行执行，避免后一次覆盖前一次任务。
  let quickApplyQueue = Promise.resolve();

  function recordDeliveryDiagnostic(event) {
    try {
      const request = chrome.runtime.sendMessage({ type: 'BQA_RECORD_DELIVERY_DIAGNOSTIC', event });
      if (request?.catch) request.catch(() => {});
    } catch {
      // 诊断日志只是辅助信息，不能影响岗位识别或沟通流程。
    }
  }

  function isExtensionNode(node) {
    return node instanceof Element && Boolean(node.closest('[class^="bqa-"], [class*=" bqa-"]'));
  }

  function mutationAddsJobCard(mutation) {
    if (mutation.type !== 'childList' || isExtensionNode(mutation.target)) return false;
    const nodes = [...mutation.addedNodes, ...mutation.removedNodes];
    return nodes.some(node => node instanceof Element
      && !isExtensionNode(node)
      && (node.matches('.job-card-wrapper, .job-card-box')
        || node.querySelector('.job-card-wrapper, .job-card-box')));
  }

  // 识别结果依赖简历、岗位画像和提示词。用内容指纹而不是递增数字作为版本，
  // 这样不同入口保存配置、扩展重启或配置恢复后，完全相同的输入仍能复用识别结果。
  const screeningConfigValue = value => String(value ?? '').trim();
  function screeningVersionFor(settings) {
    const snapshot = JSON.stringify({
      resumePdfText: screeningConfigValue(settings?.resumePdfText),
      targetProfile: screeningConfigValue(settings?.targetProfile),
      screeningPrompt: screeningConfigValue(settings?.screeningPrompt || DEFAULT_SCREENING_PROMPT),
      profiles: Array.isArray(settings?.profiles) ? settings.profiles.map(profile => ({ id: profile.id, name: profile.name, targetProfile: profile.targetProfile, enabled: profile.enabled !== false })) : [],
    });
    let hash = 2166136261;
    for (let index = 0; index < snapshot.length; index += 1) {
      hash ^= snapshot.charCodeAt(index);
      hash = Math.imul(hash, 16777619);
    }
    return `v1-${(hash >>> 0).toString(16).padStart(8, '0')}`;
  }

  // 筛选缓存按岗位画像分别计算版本。新增一个岗位条件时，只筛新画像，
  // 不让旧画像的“不匹配”结果覆盖新画像；简历或提示词变化仍会刷新所有画像。
  function screeningProfilesFor(settings) {
    const profiles = Array.isArray(settings?.profiles) ? settings.profiles : [];
    const configured = profiles.length ? profiles.filter(profile => profile && profile.enabled !== false) : [{
      id: 'legacy-default',
      name: '默认岗位',
      targetProfile: String(settings?.targetProfile || '').trim(),
      enabled: true,
    }];
    return configured.map((profile, index) => {
      const normalized = {
        id: String(profile.id || `profile-${index + 1}`),
        name: String(profile.name || `岗位条件 ${index + 1}`).trim(),
        targetProfile: String(profile.targetProfile ?? profile.description ?? '').trim(),
      };
      const version = String(profile.version || screeningVersionFor({
        ...settings,
        targetProfile: `${normalized.name}\n${normalized.targetProfile}`,
        profiles: [],
      }));
      return { ...normalized, version };
    });
  }

  function validProfileResults(record, profiles, globalVersion) {
    const results = new Map();
    for (const result of Array.isArray(record?.profileMatches) ? record.profileMatches : []) {
      const profile = profiles.find(item => String(item.id) === String(result?.profileId));
      if (!profile) continue;
      const storedVersion = String(result.profileVersion || '');
      if (storedVersion === profile.version || (!storedVersion && String(record.screeningVersion || '') === String(globalVersion || ''))) {
        results.set(String(profile.id), { ...result, profileId: profile.id, profileName: profile.name, profileVersion: profile.version });
      }
    }
    // 兼容较早版本只保存了岗位整体判断、没有 profileMatches 的记录。
    if (!results.size && profiles.length === 1 && record?.id
      && String(record.screeningVersion || '') === String(globalVersion || '')) {
      const profile = profiles[0];
      results.set(String(profile.id), {
        profileId: profile.id,
        profileName: profile.name,
        profileVersion: profile.version,
        match: Boolean(record.match),
        reason: String(record.reason || '历史筛选记录'),
      });
    }
    return results;
  }

  function profileCategoryKeywords(profile) {
    const generic = /人工智能|ai|实习生?|岗位条件?\s*\d*|岗位|职位|招聘|工程师|开发|研发|助理|经理|专员|方向|全职|兼职|应届|校招/gi;
    const name = String(profile?.name || '').replace(generic, '').trim();
    const source = name || String(profile?.targetProfile || '').replace(generic, '').trim();
    const chinese = source.match(/[\u4e00-\u9fff]{2,}/g) || [];
    const latin = source.match(/[a-z][a-z0-9+#.-]{1,}/gi) || [];
    return [...new Set([...chinese, ...latin].map(value => normalize(value).toLowerCase()).filter(Boolean))];
  }

  function profileCategoryMatchesRecord(record, profile) {
    const keywords = profileCategoryKeywords(profile);
    if (!keywords.length) return false;
    const titleAndTags = normalize(`${record?.title || ''} ${record?.tags || ''}`).toLowerCase();
    return keywords.some(keyword => titleAndTags.includes(keyword));
  }

  function screeningRecordWasDelivered(record, delivered) {
    const recordIds = [record?.detailUrl, record?.jobUrl, record?.id, record?.jobId, record?.encryptJobId]
      .map(canonicalJobId).filter(Boolean);
    if (recordIds.some(id => delivered?.has(id))) return true;
    const deliveredRecords = [
      ...persistedDeliveredJobs.values(),
      ...[...persistedDeliveryRecords.values()].filter(item => item?.deliveryStatus === '已投递'),
    ];
    return deliveredRecords.some(item => [item?.detailUrl, item?.jobUrl, item?.id, item?.jobId, item?.encryptJobId]
      .map(canonicalJobId).some(id => id && recordIds.includes(id)));
  }

  function screeningRecordWasManuallyDismissed(record) {
    const recordId = canonicalJobId(record?.detailUrl || record?.jobUrl || record?.id || record?.jobId || record?.encryptJobId);
    const recordUrl = comparableJobUrl(record?.detailUrl || record?.jobUrl);
    const title = normalize(record?.title);
    const company = normalize(record?.company);
    return [...persistedDismissedJobs.values()].some(item => {
      const itemId = canonicalJobId(item?.detailUrl || item?.jobUrl || item?.id || item?.jobId || item?.encryptJobId);
      return (recordId && itemId === recordId)
        || (recordUrl && comparableJobUrl(item?.detailUrl || item?.jobUrl) === recordUrl)
        || (title && company && normalize(item?.title) === title && normalize(item?.company) === company);
    });
  }

  function screeningRecordWasCompanyHidden(record) {
    const company = normalize(record?.company);
    if (!company) return false;
    return [...persistedHiddenCompanies].some(name => normalize(name) === company);
  }

  function combineProfileScreeningResult(job, previousRecord, freshResults, settings, profiles) {
    const previous = validProfileResults(previousRecord, profiles, settings.screeningVersion);
    const allResults = new Map();
    for (const item of Array.isArray(previousRecord?.profileMatches) ? previousRecord.profileMatches : []) {
      if (item?.profileId) allResults.set(`${item.profileId}:${item.profileVersion || ''}`, item);
    }
    for (const item of Array.isArray(job?.profileMatches) ? job.profileMatches : []) {
      if (item?.profileId) allResults.set(`${item.profileId}:${item.profileVersion || ''}`, item);
    }
    for (const item of Array.isArray(freshResults) ? freshResults : []) {
      if (item?.profileId) allResults.set(`${item.profileId}:${item.profileVersion || ''}`, item);
    }
    const active = new Map(previous);
    for (const item of Array.isArray(freshResults) ? freshResults : []) {
      const profile = profiles.find(candidate => String(candidate.id) === String(item?.profileId));
      if (profile && String(item.profileVersion || profile.version) === profile.version) {
        active.set(String(profile.id), { ...item, profileId: profile.id, profileName: profile.name, profileVersion: profile.version });
      }
    }
    const matchedProfiles = profiles
      .filter(profile => active.get(String(profile.id))?.match)
      .map(profile => ({ id: profile.id, name: profile.name, version: profile.version }));
    const profileMatches = [...allResults.values()];
    const reasons = profiles
      .map(profile => ({ profile, result: active.get(String(profile.id)) }))
      .filter(item => item.result)
      .map(({ profile, result }) => `${profile.name}：${result.reason || (result.match ? '匹配' : '不匹配')}`);
    const bestProfile = profiles.find(profile => active.get(String(profile.id))?.match) || null;
    const manualOverride = Boolean(job.manualOverride || previousRecord?.manualOverride);
    return {
      ...job,
      match: manualOverride || matchedProfiles.length > 0,
      reason: reasons.join('；') || job.reason || 'AI 未返回判断',
      manualOverride,
      profileMatches,
      matchedProfiles,
      bestProfile,
      screeningVersion: settings.screeningVersion,
    };
  }

  function hasExtensionContext() {
    try { return Boolean(chrome?.runtime?.id && chrome?.storage?.local); } catch { return false; }
  }

  function badgeCount(element) {
    if (!element || !visible(element)) return null;
    const text = String(element.getAttribute('aria-label') || element.innerText || '').trim();
    const count = text.match(/^\d{1,4}$/)?.[0];
    return count ? Number(count) : null;
  }

  function nearbyUnreadBadge(label) {
    const labelRect = label.getBoundingClientRect();
    const candidates = [
      ...label.querySelectorAll('[class*="badge" i], [class*="unread" i], [class*="notice" i], sup, [aria-label*="未读"]'),
      ...[...label.parentElement?.children || []].filter(element => element !== label),
    ];
    for (const candidate of candidates) {
      const count = badgeCount(candidate);
      if (!Number.isFinite(count)) continue;
      const rect = candidate.getBoundingClientRect();
      // BOSS 的未读数是“消息”文字右上角的小徽标；不接受导航或页面其它区域的数字。
      const isNearby = rect.left >= labelRect.left - 4 && rect.left <= labelRect.right + 32
        && rect.bottom >= labelRect.top - 12 && rect.top <= labelRect.bottom + 14
        && rect.width <= 40 && rect.height <= 40;
      if (isNearby) return count;
    }
    return null;
  }

  function currentUnreadMessageCount() {
    const labels = [...document.querySelectorAll('a, button, [role="link"], [role="button"]')]
      .filter(element => {
        const href = element.getAttribute('href') || '';
        const text = normalize(element.innerText || element.getAttribute('aria-label'));
        return /\/chat(?:[/?#]|$)/i.test(href) || /(?:消息|聊天|沟通)/.test(text);
      });
    for (const label of labels) {
      const text = `${label.getAttribute('aria-label') || ''} ${label.innerText || ''}`.replace(/\s+/g, ' ');
      const embeddedCount = text.match(/(?:消息|聊天|沟通)\D{0,4}(\d{1,4})(?:\s*(?:条|个))?/);
      if (embeddedCount) return Math.min(Number(embeddedCount[1]), 9999);
      const count = nearbyUnreadBadge(label);
      if (Number.isFinite(count)) return Math.min(count, 9999);
      // 已识别到消息导航但没有数字徽标，才确认未读数为 0。
      return 0;
    }
    // 未找到消息导航时不更新全局角标，防止其它 BOSS 页面误把已保存数清零。
    return null;
  }

  function syncUnreadMessageBadge(force = false) {
    clearTimeout(unreadBadgeSyncTimer);
    unreadBadgeSyncTimer = setTimeout(() => {
      const count = currentUnreadMessageCount();
      if (!Number.isFinite(count)) return;
      if (!force && count === unreadMessageCount) return;
      unreadMessageCount = count;
      chrome.runtime.sendMessage({ type: 'BQA_SET_UNREAD_MESSAGE_COUNT', count }).catch(() => {});
    }, 120);
  }

  function scheduleUnreadBadgePoll() {
    if (!onChatPage()) return;
    clearTimeout(unreadBadgePollTimer);
    unreadBadgePollTimer = setTimeout(() => {
      syncUnreadMessageBadge();
      scheduleUnreadBadgePoll();
    }, 10000);
  }

  function readStorage(key, fallback) {
    return new Promise(resolve => {
      try {
        if (!hasExtensionContext()) return resolve(fallback);
        chrome.storage.local.get(key, data => {
          try { resolve(chrome.runtime.lastError ? fallback : (data[key] ?? fallback)); } catch { resolve(fallback); }
        });
      } catch { resolve(fallback); }
    });
  }

  function writeStorage(operation) {
    return new Promise(resolve => {
      try {
        if (!hasExtensionContext()) {
          lastStorageWriteError = '扩展上下文已失效，请刷新当前 BOSS 页面后再试。';
          return resolve(false);
        }
        operation(() => {
          try {
            lastStorageWriteError = chrome.runtime.lastError?.message || '';
            resolve(!lastStorageWriteError);
          } catch {
            lastStorageWriteError = '浏览器未返回存储结果。';
            resolve(false);
          }
        });
      } catch (error) {
        lastStorageWriteError = error?.message || '浏览器未能写入本地存储。';
        resolve(false);
      }
    });
  }

  const isEmptySettings = settings => !settings || !Object.keys(settings).length;
  const usesBossNativeGreeting = settings => settings?.aiGreetingEnabled === false;
  const pluginGreetingEnabled = settings => !usesBossNativeGreeting(settings);
  async function getSettings() {
    const settings = await readStorage(SETTINGS_KEY, {});
    // 仅在当前配置被意外清空时使用备份；首次安装仍保持空配置。
    if (!isEmptySettings(settings)) {
      const clean = { ...settings };
      delete clean.resumeImage;
      return { ...clean, screeningVersion: screeningVersionFor(clean) };
    }
    const backup = await readStorage(SETTINGS_BACKUP_KEY, {});
    if (isEmptySettings(backup)) return settings;
    const clean = { ...backup };
    delete clean.resumeImage;
    return { ...clean, screeningVersion: screeningVersionFor(clean) };
  }
  async function saveSettings(updates) {
    // 所有设置入口做合并写入，避免自动搜索、自动投递等局部保存覆盖基础配置。
    const current = await readStorage(SETTINGS_KEY, {});
    const merged = { ...(current || {}), ...(updates || {}) };
    delete merged.resumeImage;
    merged.screeningVersion = screeningVersionFor(merged);
    const backupSource = isEmptySettings(current) ? await readStorage(SETTINGS_BACKUP_KEY, {}) : current;
    const backup = { ...(backupSource || {}) };
    delete backup.resumeImage;
    return writeStorage(done => chrome.storage.local.set({
      [SETTINGS_KEY]: merged,
      [SETTINGS_BACKUP_KEY]: backup,
    }, done));
  }
  const getDelivered = async () => new Set((await readStorage(DELIVERED_KEY, [])
    ).map(job => canonicalJobId(typeof job === 'string' ? job : job?.id || job?.jobId || job?.encryptJobId)).filter(Boolean));
  async function getActiveDeliveryBatch() {
    const queue = await readStorage(DELIVERY_TASK_QUEUE_KEY, {});
    return queue?.active?.execution;
  }

  function deliveryTaskLeaseKey(task) {
    if (!task?.id) return '';
    return `${task.id}:${Number(task.claimedAt || task.queueLeaseAt || 0)}:${Number(task.claimedTabId || task.tabId || 0)}`;
  }

  function setActiveDeliveryBatch(batch) {
    if (!batch?.queueTaskId) return Promise.resolve(false);
    return chrome.runtime.sendMessage({ type: 'BQA_SET_DELIVERY_TASK_EXECUTION', id: batch.queueTaskId, claimedAt: batch.queueLeaseAt, execution: batch })
      .then(response => {
        lastStorageWriteError = response?.error || '';
        return Boolean(response?.ok);
      })
      .catch(error => {
        lastStorageWriteError = error?.message || '后台未能保存投递执行状态。';
        return false;
      });
  }

  async function clearActiveDeliveryBatch() {
    const batch = await getActiveDeliveryBatch();
    if (!batch?.queueTaskId) return true;
    try {
      const response = await chrome.runtime.sendMessage({ type: 'BQA_CLEAR_DELIVERY_TASK_EXECUTION', id: batch.queueTaskId, claimedAt: batch.queueLeaseAt });
      lastStorageWriteError = response?.error || '';
      return Boolean(response?.ok);
    } catch (error) {
      lastStorageWriteError = error?.message || '后台未能清理投递执行状态。';
      return false;
    }
  }

  const getStored = key => key === BATCH_KEY ? getActiveDeliveryBatch() : readStorage(key, undefined);
  const setStored = (key, value) => key === BATCH_KEY ? setActiveDeliveryBatch(value) : writeStorage(done => chrome.storage.local.set({ [key]: value }, done));
  const removeStored = key => key === BATCH_KEY ? clearActiveDeliveryBatch() : writeStorage(done => chrome.storage.local.remove(key, done));

  async function saveScreeningRecords(jobs, screeningVersion) {
    if (!jobs?.length) return;
    const existing = await readStorage(SCREENING_RECORDS_KEY, []);
    const analyzedAt = Date.now();
    const existingById = new Map((Array.isArray(existing) ? existing : []).map(record => [String(record?.id), record]));
    const records = jobs.map(job => {
      const previous = existingById.get(String(job.id));
      const profileResults = new Map();
      for (const result of Array.isArray(previous?.profileMatches) ? previous.profileMatches : []) {
        if (result?.profileId) profileResults.set(`${result.profileId}:${result.profileVersion || ''}`, result);
      }
      for (const result of Array.isArray(job.profileMatches) ? job.profileMatches : []) {
        if (result?.profileId) profileResults.set(`${result.profileId}:${result.profileVersion || ''}`, result);
      }
      return ({
      ...previous,
      id: job.id,
      title: job.title || '岗位名称待确认',
      company: job.company || '公司信息待确认',
      salary: job.salary || '薪资待确认',
      tags: job.tags || '',
      summary: job.summary || '',
      detailUrl: job.detailUrl || '',
      match: Boolean(job.match),
      reason: job.reason || 'AI 未返回判断',
      manualOverride: Boolean(job.manualOverride),
      matchedProfiles: Array.isArray(job.matchedProfiles) ? job.matchedProfiles : [],
      profileMatches: [...profileResults.values()],
      bestProfile: job.bestProfile || null,
      // 版本是由简历、目标画像和薪资范围内容计算出的指纹，必须保留完整字符串；
      // 旧版这里用 Number() 会把 `v1-xxxxxxxx` 全部写成 1，导致后续无法复用识别结果。
      screeningVersion: String(screeningVersion || screeningVersionFor({})),
      analyzedAt,
    });
    });
    const updatedIds = new Set(records.map(record => String(record.id)));
    const retained = (Array.isArray(existing) ? existing : [])
      .filter(record => !updatedIds.has(String(record?.id)));
    // 岗位识别历史按岗位 ID 去重，不设置固定条数上限。
    await setStored(SCREENING_RECORDS_KEY, [...records, ...retained]);
  }

  const normalize = value => (value || '').replace(/\s+/g, '').trim();
  const escapeHtml = value => String(value || '').replace(/[&<>'"]/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char]);
  const visible = element => {
    const style = getComputedStyle(element);
    const rect = element.getBoundingClientRect();
    return style.display !== 'none' && style.visibility !== 'hidden' && rect.width > 0 && rect.height > 0;
  };

  function isToday(timestamp) {
    if (!timestamp) return false;
    const numeric = Number(timestamp);
    const value = Number.isFinite(numeric) && numeric > 0
      ? (numeric < 100000000000 ? numeric * 1000 : numeric)
      : timestamp;
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return false;
    const today = new Date();
    return date.getFullYear() === today.getFullYear() && date.getMonth() === today.getMonth() && date.getDate() === today.getDate();
  }

  function todayDeliveryCount() {
    const delivered = new Map();
    persistedDeliveredJobs.forEach((record, key) => {
      if (!isToday(record?.deliveredAt || record?.updatedAt)) return;
      delivered.set(deliveryCountKey(record, key), record);
    });
    persistedDeliveryRecords.forEach((record, key) => {
      if (record?.deliveryStatus !== '已投递' || !isToday(record?.deliveredAt || record?.updatedAt)) return;
      const identity = deliveryCountKey(record, key);
      delivered.set(identity, { ...(delivered.get(identity) || {}), ...record });
    });
    return delivered.size;
  }

  function setDailyDeliveryLimit(value) {
    const limit = Number.parseInt(value, 10);
    dailyDeliveryLimit = Number.isFinite(limit) && limit > 0 ? limit : DEFAULT_DAILY_DELIVERY_LIMIT;
    return dailyDeliveryLimit;
  }

  function remainingDailyDeliveryQuota() {
    return Math.max(0, dailyDeliveryLimit - todayDeliveryCount());
  }

  function dailyDeliveryLimitReached() {
    return todayDeliveryCount() >= dailyDeliveryLimit;
  }

  function dailyDeliveryLimitError() {
    const error = new Error(`今日投递已达到设置上限（${dailyDeliveryLimit} 个）`);
    error.code = 'BQA_DAILY_DELIVERY_LIMIT';
    return error;
  }

  function cityCodeFrom(value) {
    const city = String(value || '').trim();
    return CITY_CODES[city] || (/^\d{6,12}$/.test(city) ? city : '');
  }

  function renderDailyDeliveryQuota() {
    const label = document.querySelector(`.${LAUNCHER_CLASS} .bqa-ai-launcher__label`);
    if (label && onJobsPage()) label.textContent = `今日投递 ${todayDeliveryCount()}/${dailyDeliveryLimit}`;
  }

  function deliveryQueueLinkMarkup() {
    return '<a class="bqa-queue-link" href="#" data-open-delivery-queue>查看队列</a>';
  }

  function findVisibleByText(text) {
    const target = normalize(text);
    return [...document.querySelectorAll('button, a, [role="button"], span, div')]
      .find(element => visible(element) && normalize(element.innerText) === target);
  }

  function chatSessionFromLocation() {
    return new URLSearchParams(location.hash.replace(/^#/, '')).get('bqa-chat');
  }

  async function currentChromeTabId() {
    const response = await chrome.runtime.sendMessage({ type: 'BQA_GET_CURRENT_TAB' }).catch(() => null);
    return Number(response?.tabId) || 0;
  }

  function pendingMatchesCurrentDetail(pending) {
    const expected = canonicalJobId(pending?.detailUrl || pending?.jobId);
    const actual = canonicalJobId(location.href);
    if (expected && actual && expected === actual) return true;
    const headerText = normalize(detailHeader()?.innerText || '');
    const expectedTitle = normalize(pending?.title || '');
    const expectedCompany = normalize(pending?.company || '');
    const titleMatches = Boolean(expectedTitle && headerText.includes(expectedTitle));
    const companyMatches = !expectedCompany || headerText.includes(expectedCompany);
    return Boolean(onJobDetailPage() && titleMatches && companyMatches);
  }

  async function pendingMatchesCurrentTab(pending) {
    // 详情页跳转到聊天页会改写 URL，不能再靠 URL 比对；由后台创建新标签页
    // 返回的 tabId 是唯一可靠锚点，避免残留的 #bqa-chat 页面抢走当前任务。
    if (!pending?.chatTabId) return pendingMatchesCurrentDetail(pending);
    const currentTabId = await currentChromeTabId();
    if (currentTabId && Number(pending.chatTabId) === currentTabId) return true;
    // 某些 Chrome 控制/扩展重启时短暂拿不到 tabId；详情 URL 仍是可靠的任务锚点，
    // 不能因此静默放弃点击流程。
    return onJobDetailPage() && pendingMatchesCurrentDetail(pending);
  }

  function selectUnreadMessagesTab() {
    if (!onChatPage()) return false;
    const candidates = [...document.querySelectorAll('button, a, [role="tab"], [role="button"], [class*="tab"], [class*="filter"], div, span')]
      .filter(element => visible(element))
      .map(element => element.closest('button, a, [role="tab"], [role="button"], [class*="tab"], [class*="filter"]') || element)
      .filter((element, index, all) => all.indexOf(element) === index)
      .filter(element => /^未读(?:\s*[（(]?\d+[）)]?)?\s*$/.test(normalize(element.innerText || element.getAttribute('aria-label'))));
    const tab = candidates.find(element => {
      const state = `${element.getAttribute('aria-selected') || ''} ${element.getAttribute('aria-current') || ''} ${element.className || ''}`;
      return !/^(true|page)$/i.test(element.getAttribute('aria-selected') || '')
        && !/active|selected|current/i.test(state);
    });
    if (!tab || Date.now() - lastUnreadTabClickAt < 1000) return false;
    lastUnreadTabClickAt = Date.now();
    tab.click();
    return true;
  }

  function requestedUnreadMessagesTab() {
    return new URLSearchParams(location.hash.replace(/^#/, '')).get('bqa-unread') === '1';
  }

  function clearUnreadMessagesTabRequest() {
    const params = new URLSearchParams(location.hash.replace(/^#/, ''));
    params.delete('bqa-unread');
    const hash = params.toString();
    history.replaceState(null, '', `${location.pathname}${location.search}${hash ? `#${hash}` : ''}`);
  }

  function selectUnreadMessagesTabWhenReady() {
    let attempts = 0;
    const trySelect = () => {
      if (!onChatPage()) return;
      if (selectUnreadMessagesTab()) {
        if (requestedUnreadMessagesTab()) clearUnreadMessagesTabRequest();
        return;
      }
      attempts += 1;
      if (attempts >= 30) {
        if (requestedUnreadMessagesTab()) clearUnreadMessagesTabRequest();
        return;
      }
      setTimeout(trySelect, 500);
    };
    trySelect();
  }

  function makeBatchSessionId() {
    return crypto.randomUUID?.() || `bqa-${Date.now()}-${Math.random().toString(36).slice(2)}`;
  }

  function waitForElement(text, timeout = TIMEOUT_MS) {
    return new Promise((resolve, reject) => {
      const started = Date.now();
      const timer = setInterval(() => {
        const element = findVisibleByText(text);
        if (element) {
          clearInterval(timer);
          resolve(element);
        } else if (Date.now() - started >= timeout) {
          clearInterval(timer);
          reject(new Error(`未找到“${text}”按钮`));
        }
      }, POLL_MS);
    });
  }

  function titleContainer(title) {
    // 按钮与职位名保持同级，避免破坏 BOSS 原有的标题节点结构。
    return title.parentElement;
  }

  function jobCard(title) {
    return title.closest('.job-card-wrapper, .job-card-box, [data-jobid], [data-job-id], li, article')
      || title.parentElement?.parentElement
      || title.parentElement;
  }

  function jobCards() {
    // 不使用 instanceof：页面与扩展处于不同的 JS 执行环境时，DOM 构造函数
    // 可能并不相同，导致职位卡片被误判为空。
    const knownCards = [...document.querySelectorAll('.job-card-wrapper, .job-card-box')];
    if (knownCards.length) return [...new Set(knownCards)];
    // BOSS 经常调整卡片类名。若页面上已有本扩展的“快速投递”按钮，
    // 则从它向上找到尺寸合理的卡片容器，避免因类名变更丢失公司屏蔽入口。
    return [...new Set([...document.querySelectorAll(`.${BUTTON_CLASS}`)].map(button => {
      let node = button.parentElement;
      while (node && node !== document.body) {
        const rect = node.getBoundingClientRect();
        if (rect.width >= 260 && rect.height >= 110 && rect.height <= 560) return node;
        node = node.parentElement;
      }
      return null;
    }).filter(Boolean))];
  }

  function canonicalJobId(value) {
    return globalThis.BqaJobId?.canonicalJobId(value, location.origin) || '';
  }

  function normalizeStoredJob(record) {
    if (!record || typeof record !== 'object') return null;
    const id = canonicalJobId(record.detailUrl || record.jobUrl || record.id || record.jobId || record.encryptJobId);
    // 历史记录可能只有旧版组合 ID。它不能用于岗位去重，但仍必须保留给投递统计和历史展示。
    return id ? { ...record, id } : { ...record };
  }

  function storedJobKey(record, index, source) {
    const id = canonicalJobId(record?.detailUrl || record?.jobUrl || record?.id || record?.jobId || record?.encryptJobId);
    if (id) return id;
    const legacyId = String(record?.id || record?.jobId || record?.encryptJobId || '').trim();
    if (legacyId) return `legacy:${legacyId}`;
    const title = normalize(record?.title);
    const company = normalize(record?.company);
    return `legacy:${source}:${title}|${company}|${index}`;
  }

  function storedJobsMap(records, source) {
    return new Map((Array.isArray(records) ? records : [])
      .map((item, index) => {
        const record = normalizeStoredJob(typeof item === 'string' ? { id: item } : item);
        return record ? [storedJobKey(record, index, source), record] : null;
      })
      .filter(Boolean));
  }

  function deliveryCountKey(record, fallbackKey) {
    const id = canonicalJobId(record?.detailUrl || record?.jobUrl || record?.id || record?.jobId || record?.encryptJobId);
    return id ? `job:${id}` : String(fallbackKey || storedJobKey(record, 0, 'count'));
  }

  function jobId(card) {
    return globalThis.BqaJobId?.fromCard(card, location.origin) || '';
  }

  function jobDetailUrl(card) {
    const href = [...card.querySelectorAll('a[href]')]
      .find(anchor => /(?:^|\/)job_detail\//i.test(anchor.getAttribute('href') || anchor.href || ''))
      ?.getAttribute('href');
    if (!href) return '';
    try { return new URL(href, location.origin).href; } catch { return ''; }
  }

  function comparableJobUrl(value) {
    if (!value) return '';
    try {
      const url = new URL(value, location.origin);
      const match = url.pathname.match(/\/job_detail\/([^/]+?)(?:\.html)?\/?$/i);
      return match ? `job_detail/${match[1]}` : `${url.origin}${url.pathname}`.replace(/\/$/, '');
    } catch {
      return String(value).split(/[?#]/)[0].replace(/\/$/, '');
    }
  }

  function deliveredJobMatches(card) {
    const id = String(jobId(card) || '');
    if (!id) return false;
    return [...persistedDeliveredJobs.values(), ...persistedDeliveryRecords.values()]
      .filter(record => record?.deliveryStatus === '已投递'
        || persistedDeliveredJobs.has(canonicalJobId(record?.detailUrl || record?.jobUrl || record?.id || record?.jobId || record?.encryptJobId)))
      .some(record => [record.detailUrl, record.jobUrl, record.id, record.jobId, record.encryptJobId]
        .map(canonicalJobId)
        .includes(id));
  }

  function dismissedJobMatches(card) {
    const id = jobId(card);
    const detailUrl = jobDetailUrl(card);
    const title = normalize(card.querySelector('[class*="job-name"]')?.innerText);
    const company = companyName(card);
    return [...persistedDismissedJobs.values()].some(job => job.id === id
      || (detailUrl && job.detailUrl === detailUrl)
      || (title && company && normalize(job.title) === title && normalize(job.company) === company));
  }

  function securityIdFrom(card) {
    // 仅检查卡片本身和少量子节点属性；不要复制 outerHTML 或每张卡都扫描整页脚本。
    // securityId 缺失时由 page-bridge 按精确岗位 ID 从接口缓存补充。
    const elements = [card, ...card.querySelectorAll('a[href], [data-security-id], [data-securityid]')].slice(0, 25);
    for (const element of elements) {
      const values = [element.getAttribute('data-security-id'), element.getAttribute('data-securityid'), element.getAttribute('href')];
      for (const attribute of [...(element.attributes || [])].slice(0, 12)) values.push(attribute.value || '');
      for (const value of values) {
        const match = String(value).match(/(?:securityId|security-id)[=:\\"']+([A-Za-z0-9_-]{8,})/i);
        if (match) return match[1];
      }
    }
    const href = card.querySelector('a[href*="job_detail/"]')?.href || '';
    const queryValue = new URL(href || location.href, location.origin).searchParams.get('securityId');
    if (queryValue) return queryValue;
    return '';
  }

  function readJob(card) {
    const title = normalize(card.querySelector('[class*="job-name"]')?.innerText) || '未知岗位';
    const salary = salaryText(card);
    return {
      id: jobId(card), title, company: companyName(card), detailUrl: jobDetailUrl(card),
      securityId: securityIdFrom(card),
      salary,
      // BOSS 使用专用字体显示薪资数字；预览中复用该字体，才能正确显示编码后的文本。
      salaryFont: salary ? salaryFontFamily(card) : '',
      tags: [...card.querySelectorAll('.tag-list li, [class*="tag"]')].map(item => normalize(item.innerText)).filter(Boolean).slice(0, 8),
      summary: normalize(card.innerText).slice(0, 700)
    };
  }

  function detailHeader() {
    return document.querySelector('.job-detail-box, .job-detail, [class*="job-detail"], .detail-content') || document.body;
  }

  function readDetailJob() {
    const header = detailHeader();
    const text = normalize(header.innerText);
    const detailText = selector => normalize(header.querySelector(selector)?.innerText);
    const id = canonicalJobId(location.href);
    return {
      id,
      title: detailText('.job-name, [class*="job-name"], h1') || '未知岗位',
      company: detailText('.company-name, [class*="company-name"], .company-info a, [class*="company"] a'),
      detailUrl: location.href.split('#')[0],
      securityId: securityIdFrom(header),
      salary: detailText('.salary, .job-salary, [class*="salary"]') || text.match(/\d{1,3}(?:\.\d+)?(?:-\d{1,3}(?:\.\d+)?)?K(?:·\d+薪)?/i)?.[0] || '',
      tags: [...header.querySelectorAll('.tag-list li, [class*="tag"]')].map(item => normalize(item.innerText)).filter(Boolean).slice(0, 8),
      cachedJd: text.slice(0, 2400),
      summary: text.slice(0, 700),
    };
  }

  function cardsFingerprint() {
    return jobCards().filter(isVisibleCard).map(jobId).filter(Boolean).join('|');
  }

  function isDisabledControl(element) {
    return !element || element.disabled || element.getAttribute('aria-disabled') === 'true'
      || element.classList.contains('disabled') || /disabled/i.test(String(element.className));
  }

  function pageControl(direction) {
    const labels = direction === 'next'
      ? /^(下一页|下页|next|›|>)$/i
      : /^(上一页|上页|prev|previous|‹|<)$/i;
    return [...document.querySelectorAll('button, a, [role="button"]')].find(element => {
      const label = normalize(element.getAttribute('aria-label') || element.innerText || element.title);
      return visible(element) && labels.test(label) && !isDisabledControl(element);
    });
  }

  function changeVueJobListPage(direction, timeout = 5000) {
    return new Promise(resolve => {
      const requestId = makeBatchSessionId();
      const handler = event => {
        if (event.detail?.requestId !== requestId) return;
        window.removeEventListener('BQA_CHANGE_JOB_PAGE_RESPONSE', handler);
        resolve(Boolean(event.detail?.ok));
      };
      window.addEventListener('BQA_CHANGE_JOB_PAGE_RESPONSE', handler);
      window.dispatchEvent(new CustomEvent('BQA_CHANGE_JOB_PAGE_REQUEST', { detail: { requestId, direction } }));
      setTimeout(() => {
        window.removeEventListener('BQA_CHANGE_JOB_PAGE_RESPONSE', handler);
        resolve(false);
      }, timeout);
    });
  }

  function discoveryStoppedError() {
    const error = new Error('已停止识别岗位');
    error.code = 'BQA_DISCOVERY_STOPPED';
    return error;
  }

  function throwIfDiscoveryCancelled(isCancelled) {
    if (isCancelled?.()) throw discoveryStoppedError();
  }

  async function changeJobListPage(direction, isCancelled, settleDelay = 0) {
    throwIfDiscoveryCancelled(isCancelled);
    await waitForBossRequest('list');
    const before = cardsFingerprint();
    // 与 boss-helper 相同：调用 Vue 的 searchJobAction/onSearch 来替换整份 jobList。
    // 它不是滚动或点击普通分页控件；若找不到该页面方法则直接停止，避免反复刷新同一页。
    if (!(await changeVueJobListPage(direction))) return false;
    // 参考项目也是先触发下一页请求，再等待一段时间后读取新 jobList。
    // 仅在“获取更多岗位”时使用，不影响投递阶段。
    if (settleDelay > 0) await sleepUntilCancelled(settleDelay, isCancelled);
    for (let attempt = 0; attempt < 20; attempt += 1) {
      await sleep(350);
      throwIfDiscoveryCancelled(isCancelled);
      applyListFilters();
      const after = cardsFingerprint();
      if (after && after !== before) return true;
    }
    return false;
  }

  async function screenJobsInChunks(settings, jobs, onProgress, isCancelled, chunkSize = SCREENING_CHUNK_SIZE, onChunkScreened, onLog) {
    const result = [];
    for (let start = 0; start < jobs.length; start += chunkSize) {
      throwIfDiscoveryCancelled(isCancelled);
      const chunk = jobs.slice(start, start + chunkSize);
      onProgress?.(Math.min(start + chunk.length, jobs.length), jobs.length);
      const batch = Math.floor(start / chunkSize) + 1;
      // 设置页可能在这一轮扫描期间更新提示词。每个岗位请求使用发送前的快照，
      // 这样后续请求能拿到新提示词，正在进行的请求仍按旧版本保存结果。
      const requestSettings = {
        ...settings,
        profiles: Array.isArray(settings.profiles) ? settings.profiles.map(profile => ({ ...profile })) : [],
      };
      const startedAt = Date.now();
      onLog?.(`AI 筛选第 ${batch} 批开始：${chunk.length} 个岗位`);
      const waitingTimer = setInterval(() => {
        onLog?.(`AI 正在分析第 ${batch} 批，已等待 ${Math.floor((Date.now() - startedAt) / 1000)} 秒`);
      }, 10000);
      try {
        const response = await sendBackgroundRequest({ type: 'BQA_SCREEN_JOBS', settings: requestSettings, jobs: chunk }, '岗位筛选');
        // 网络请求无法从 content script 中途撤回，但返回后不再处理其结果。
        throwIfDiscoveryCancelled(isCancelled);
        if (!response?.ok) throw new Error(response?.error || 'AI 筛选未完成');
        result.push(...response.jobs);
        const matched = response.jobs.filter(job => job.match).length;
        onLog?.(`AI 筛选第 ${batch} 批完成：匹配 ${matched} 个，排除 ${response.jobs.length - matched} 个，耗时 ${((Date.now() - startedAt) / 1000).toFixed(1)} 秒`);
        // 自动投递需要在单个岗位完成 AI 判断后立刻进入下一步，不能等同页全部筛选完成。
        await onChunkScreened?.(response.jobs);
      } catch (error) {
        if (error?.code !== 'BQA_DISCOVERY_STOPPED') onLog?.(`AI 筛选第 ${batch} 批失败：${error?.message || '未知错误'}`, 'error');
        throw error;
      } finally {
        clearInterval(waitingTimer);
      }
    }
    return result;
  }

  function cardForJob(job) {
    return jobCards().find(card => jobId(card) === job.id) || null;
  }

  // 预览阶段仍停留在命中岗位所在的列表页。此时把 JD 和安全标识一并缓存，
  // 确认投递时便无需依赖会动态变化的推荐列表再次定位这张卡片。
  async function cacheDirectDeliveryData(jobs, listPage, onProgress, isCancelled, onCachedJob, onLog) {
    const cached = [];
    for (let index = 0; index < jobs.length; index += 1) {
      throwIfDiscoveryCancelled(isCancelled);
      const job = jobs[index];
      onProgress?.({ phase: `正在缓存第 ${index + 1}/${jobs.length} 个岗位的 JD`, page: listPage + 1 });
      onLog?.(`第 ${listPage + 1} 页：读取岗位详情 ${index + 1}/${jobs.length}（${job.title || '未命名岗位'}）`);
      const card = cardForJob(job);
      if (!card) {
        onLog?.(`岗位详情暂不可用：${job.title || '未命名岗位'}，稍后投递时会重新读取`, 'warn');
        continue;
      }
      const meta = await getPageJobMeta(job.id);
      const securityId = meta?.securityId || job.securityId || securityIdFrom(card);
      if (!securityId) {
        onLog?.(`岗位详情缺少投递标识：${job.title || '未命名岗位'}，稍后投递时会重新读取`, 'warn');
        continue;
      }
      const jd = await readFullJobDescription(card, isCancelled);
      throwIfDiscoveryCancelled(isCancelled);
      // 详情区偶发未加载时仍保留岗位元数据，使用列表摘要作为 AI 话术生成的兜底上下文。
      const cachedJd = jd || job.summary || `${job.title || ''} ${job.company || ''}`.trim();
      if (!cachedJd) continue;
      const cachedJob = {
        ...job,
        listPage,
        securityId,
        encryptJobId: meta?.encryptJobId || job.id,
        cachedJd,
      };
      cached.push(cachedJob);
      onLog?.(`岗位详情读取完成：${job.title || '未命名岗位'}${jd ? '' : '（使用列表摘要）'}`);
      // 自动投递模式下，在单个岗位完成 AI 判断和详情读取后立即投递。
      await onCachedJob?.(cachedJob);
      onProgress?.({
        phase: `已缓存 ${cached.length}/${jobs.length} 个岗位的 JD`,
        page: listPage + 1,
        cachedJobs: [...cached],
      });
    }
    return cached;
  }

  async function collectAndScreenRecommendedJobs(settings, delivered, onProgress, isCancelled, { shouldAutoDeliver, shouldStopForDailyLimit, onAutoDeliver, onLog } = {}) {
    const recommended = [];
    const analyzed = [];
    let pageNew = 0;
    let pageRepeated = 0;
    const progressSnapshot = extra => {
      const matched = [];
      const excluded = [];
      for (const job of analyzed) {
        if (job.match) matched.push(job);
        else excluded.push(job);
      }
      return {
        eligible,
        recommended: recommended.length,
        screened: analyzed.length,
        matched: matched.length,
        excluded: excluded.length,
        pageNew,
        pageRepeated,
        jobs: [...matched, ...excluded.slice(-MAX_LIVE_EXCLUDED_JOBS)],
        ...extra,
      };
    };
    const seen = new Set();
    // 自动投递的消费者只接受一次同一岗位；完整 JD 缓存属于生产端的后续补全，
    // 不应让它再次触发入队。
    const autoQueuedIds = new Set();
    const storedRecords = await readStorage(SCREENING_RECORDS_KEY, []);
    const profiles = screeningProfilesFor(settings);
    const reusableRecords = new Map((Array.isArray(storedRecords) ? storedRecords : [])
      .filter(record => record?.id)
      .map(record => [String(record.id), record]));
    const mergeAndPersistScreenedJobs = async jobs => {
      const merged = (jobs || []).map(job => combineProfileScreeningResult(
        job,
        reusableRecords.get(String(job.id)),
        job.profileMatches,
        settings,
        profiles,
      ));
      await saveScreeningRecords(merged, settings.screeningVersion);
      merged.forEach(job => reusableRecords.set(String(job.id), {
        ...job,
        screeningVersion: String(settings.screeningVersion || ''),
      }));
      return merged;
    };
    let pagesMoved = 0;
    let eligible = 0;
    let consecutivePagesWithoutNewIds = 0;
    let stoppedForDailyLimit = false;
    let collectionError = null;
    try {
      // 新增岗位条件时按标题类别挑选相关旧记录；简历、提示词或画像版本变化时，
      // 必须复筛该画像下旧版本排除的记录，不能让旧判断覆盖新规则。
      const historicalGroups = new Map();
      for (const record of reusableRecords.values()) {
        if (record.match !== false || record.manualOverride
          || screeningRecordWasDelivered(record, delivered)
          || screeningRecordWasManuallyDismissed(record)
          || screeningRecordWasCompanyHidden(record)) continue;
        const currentResults = validProfileResults(record, profiles, settings.screeningVersion);
        const storedProfileResults = Array.isArray(record.profileMatches) ? record.profileMatches : [];
        const hasLegacyVersionChange = !storedProfileResults.length
          && String(record.screeningVersion || '') !== String(settings.screeningVersion || '');
        const relevantProfiles = profiles.filter(profile => {
          const profileId = String(profile.id);
          if (currentResults.has(profileId)) return false;
          const previousResult = storedProfileResults.find(result => String(result?.profileId) === profileId);
          const profileVersionChanged = Boolean(previousResult)
            && String(previousResult.profileVersion || '') !== String(profile.version || '');
          return profileVersionChanged
            || hasLegacyVersionChange
            || profileCategoryMatchesRecord(record, profile);
        });
        if (!relevantProfiles.length) continue;
        const key = relevantProfiles.map(profile => `${profile.id}:${profile.version}`).sort().join('|');
        if (!historicalGroups.has(key)) historicalGroups.set(key, { profiles: relevantProfiles, records: [] });
        historicalGroups.get(key).records.push(record);
      }
      for (let listPage = 0; recommended.length < dailyDeliveryLimit; listPage += 1) {
        throwIfDiscoveryCancelled(isCancelled);
        if (shouldStopForDailyLimit?.() && dailyDeliveryLimitReached()) {
          stoppedForDailyLimit = true;
          throw dailyDeliveryLimitError();
        }
        applyListFilters();
        onLog?.(`开始读取第 ${listPage + 1} 页岗位`);
        // 总数按本轮从 BOSS 列表读取到的全部岗位统计，不受本插件的任何筛选规则影响。
        const cardsOnPage = jobCards();
        const identifiedPageJobs = cardsOnPage
          .map(card => ({ card, job: { ...readJob(card), listPage } }))
          .filter(({ job }) => job.id);
        // 同一页偶尔会同时命中多个 BOSS 卡片容器选择器；页面内也要立即去重，
        // 否则同一个岗位会在 seen 更新前被算成多个“新增”。
        const pageEntries = [];
        for (const entry of identifiedPageJobs) {
          if (seen.has(entry.job.id)) continue;
          seen.add(entry.job.id);
          pageEntries.push(entry);
        }
        pageNew = pageEntries.length;
        pageRepeated = Math.max(0, identifiedPageJobs.length - pageEntries.length);
        consecutivePagesWithoutNewIds = identifiedPageJobs.length
          ? (pageNew ? 0 : consecutivePagesWithoutNewIds + 1)
          : 0;
        eligible += pageEntries.length;
        // 右侧 BOSS 搜索方案已负责薪资筛选；扩展不再叠加一套隐藏的薪资条件。
        const pageJobs = pageEntries
          .filter(({ card, job }) => isVisibleCard(card) && !delivered.has(job.id))
          .map(({ job }) => job);
        onLog?.(`第 ${listPage + 1} 页读取完成：新增唯一岗位 ${pageEntries.length} 个，重复岗位 ${pageRepeated} 个，${pageJobs.length} 个进入 AI 筛选`);
        // 列表薪资使用自定义字体时，DOM 文本是编码字符；优先使用页面接口中的原始 salaryDesc。
        const candidates = (await Promise.all(pageJobs.map(async job => {
          const meta = await getPageJobMeta(job.id);
          // 在 AI 匹配前就带上直连所需的安全标识。这样匹配通过后消费者可立即
          // 启动，完整 JD 的读取仍由生产端异步补全，不互相阻塞。
          return {
            ...job,
            salary: meta?.salary || job.salary,
            securityId: meta?.securityId || job.securityId || '',
            encryptJobId: meta?.encryptJobId || job.encryptJobId || job.id,
          };
        })));
        if (candidates.length) {
          const canReuseRecord = record => Boolean(record && (
            record.manualOverride
            || validProfileResults(record, profiles, settings.screeningVersion).size > 0
          ));
          const reusable = candidates
            .filter(job => canReuseRecord(reusableRecords.get(String(job.id))))
            .map(job => {
              const record = reusableRecords.get(String(job.id));
              return combineProfileScreeningResult({
                ...job,
                match: Boolean(record.match),
                reason: record.reason || 'AI 未返回判断',
                manualOverride: Boolean(record.manualOverride),
                matchedProfiles: record.matchedProfiles || [],
                profileMatches: record.profileMatches || [],
                bestProfile: record.bestProfile || record.matchedProfiles?.[0] || null,
              }, record, [], settings, profiles);
            });
          const pendingScreening = candidates.filter(job => {
            const record = reusableRecords.get(String(job.id));
            return !canReuseRecord(record);
          });
          if (reusable.length) onLog?.(`复用本地筛选记录：${reusable.length} 个岗位`);
          let cachePipeline = Promise.resolve();
          const processScreenedJobs = async (screened, { alreadyShown = false, startIndex = analyzed.length } = {}) => {
            if (!screened.length) return;
            const matchedJobs = screened.filter(job => job.match);
            if (!alreadyShown) {
              startIndex = analyzed.length;
              analyzed.push(...screened);
              // 先展示 AI 判断结果；只有匹配岗位需要读取后续投递所需的详情。
              onProgress?.(progressSnapshot({ page: listPage + 1, phase: matchedJobs.length ? '正在读取匹配岗位详情' : '当前批次筛选完成' }));
            }
            if (!matchedJobs.length) {
              onProgress?.(progressSnapshot({ page: listPage + 1, phase: '当前批次筛选完成' }));
              return;
            }
            // 不匹配岗位只进入“被排除岗位”列表，不参与投递，无需逐个读取完整 JD。
            const cached = await cacheDirectDeliveryData(matchedJobs, listPage, progress => {
              const cachedJobs = progress.cachedJobs || [];
              const snapshot = progressSnapshot({ page: listPage + 1, phase: '正在整理匹配岗位信息' });
              const cachedById = new Map(cachedJobs.map(job => [String(job.id), job]));
              onProgress?.({ ...snapshot, recommended: recommended.length + cachedJobs.length, ...progress,
                jobs: snapshot.jobs.map(job => cachedById.get(String(job.id)) || job) });
            }, isCancelled, async cachedJob => {
              if (cachedJob.match && shouldAutoDeliver?.() && !autoQueuedIds.has(cachedJob.id)) {
                // 投递已由全局队列串行控制；不能让发送过程阻塞后续岗位的识别和预览渲染。
                autoQueuedIds.add(cachedJob.id);
                void onAutoDeliver?.(cachedJob).catch(error => console.warn('[BOSS 智能投递] 自动投递任务未能启动', error));
              }
            }, onLog);
            const cachedById = new Map(cached.map(job => [job.id, job]));
            for (let index = startIndex; index < startIndex + screened.length; index += 1) {
              const job = analyzed[index];
              const cachedJob = cachedById.get(job.id);
              if (cachedJob) {
                analyzed[index] = { ...job, ...cachedJob };
              } else if (job.match) {
                // 缓存失败不等于无法投递：批量发送时仍可从当前列表卡片重新读取元数据。
                const fallbackJob = { ...job, reason: '岗位信息读取不完整，投递时重新读取' };
                analyzed[index] = fallbackJob;
                if (shouldAutoDeliver?.() && !autoQueuedIds.has(fallbackJob.id)) {
                  autoQueuedIds.add(fallbackJob.id);
                  void onAutoDeliver?.(fallbackJob).catch(error => console.warn('[BOSS 智能投递] 自动投递任务未能启动', error));
                }
              }
            }
            for (const job of cached) {
              recommended.push(job);
              if (recommended.length >= dailyDeliveryLimit) break;
            }
          };
          const autoDelivering = Boolean(shouldAutoDeliver?.());
          const screenedRecordsById = new Map();
          if (reusable.length) await processScreenedJobs(reusable);
          const manualStartIndex = analyzed.length;
          const screened = await screenJobsInChunks(settings, pendingScreening, (current, total) => {
            onProgress?.(progressSnapshot({ page: listPage + 1, total, phase: `正在筛选本页岗位 ${current}/${total}` }));
          }, isCancelled, autoDelivering ? AUTO_SCREENING_CHUNK_SIZE : SCREENING_CHUNK_SIZE, async screenedChunk => {
            const mergedChunk = await mergeAndPersistScreenedJobs(screenedChunk);
            mergedChunk.forEach(job => screenedRecordsById.set(String(job.id), job));
            if (!autoDelivering) {
              analyzed.push(...mergedChunk);
              onProgress?.(progressSnapshot({ page: listPage + 1, phase: '本批岗位筛选完成' }));
              return;
            }
            const startIndex = analyzed.length;
            analyzed.push(...mergedChunk);
            // 每批 AI 结果先进入预览；自动投递必须等待下面的完整职位详情读取完成。
            onProgress?.(progressSnapshot({ page: listPage + 1, phase: '正在读取岗位详情' }));
            cachePipeline = cachePipeline.then(() => processScreenedJobs(mergedChunk, { alreadyShown: true, startIndex }));
          }, onLog);
          // 手动确认模式可统一完成本页 AI 筛选后再缓存；自动模式已在每个岗位完成筛选时处理。
          if (!autoDelivering) {
            const mergedScreened = screened.map(job => screenedRecordsById.get(String(job.id)) || job);
            await processScreenedJobs(mergedScreened, { alreadyShown: true, startIndex: manualStartIndex });
          }
          else await cachePipeline;
        }
        onProgress?.(progressSnapshot({ page: listPage + 1 }));
        if (recommended.length >= dailyDeliveryLimit) break;
        if (consecutivePagesWithoutNewIds >= 2) {
          const endPhase = `连续 2 页没有发现新的岗位 ID，已停止翻页；本轮共读取 ${eligible} 个唯一岗位。扩展不设固定岗位条数上限`;
          onLog?.(endPhase);
          onProgress?.(progressSnapshot({ page: listPage + 1, phase: endPhase }));
          break;
        }
        const pagePause = randomPagePause();
        onLog?.(`本页处理完成：当前符合条件 ${analyzed.filter(job => job.match).length} 个，准备翻到下一页`);
        onProgress?.(progressSnapshot({ page: listPage + 1, phase: `正在获取下一页岗位，等待 ${Math.round(pagePause / 1000)} 秒` }));
        onLog?.(`正在翻页，等待 ${Math.round(pagePause / 1000)} 秒`);
        if (!(await changeJobListPage('next', isCancelled, pagePause))) {
          onLog?.('没有获取到下一页，结束岗位识别');
          break;
        }
        pagesMoved += 1;
        onLog?.(`已切换到第 ${listPage + 2} 页`);
      }
      // 先扫描当前搜索结果，让用户尽快看到本轮读取和筛选结果；历史重评放在后面，
      // 避免旧记录数量较多时，弹窗长时间停留在“读取 0 个岗位”。
      for (const group of historicalGroups.values()) {
        throwIfDiscoveryCancelled(isCancelled);
        // 当前搜索页可能已经按新提示词重筛并保存了部分历史岗位，跳过这些记录，
        // 防止它们在同一轮里重复请求 AI。
        const pendingRecords = group.records.filter(record => {
          const latest = reusableRecords.get(String(record.id)) || record;
          const currentResults = validProfileResults(latest, profiles, settings.screeningVersion);
          return group.profiles.some(profile => !currentResults.has(String(profile.id)));
        });
        if (!pendingRecords.length) continue;
        onLog?.(`开始复筛历史排除岗位：${pendingRecords.length} 个`);
        onProgress?.(progressSnapshot({ phase: `正在复筛历史排除岗位（${pendingRecords.length} 个）` }));
        const jobs = pendingRecords.map(record => ({
          id: String(record.id),
          title: record.title || '岗位名称待确认',
          company: record.company || '公司信息待确认',
          salary: record.salary || '薪资待确认',
          tags: record.tags || '',
          summary: record.summary || '',
          detailUrl: record.detailUrl || record.jobUrl || '',
        }));
        try {
          const targetedSettings = { ...settings, profiles: group.profiles };
          const mergedById = new Map();
          await screenJobsInChunks(targetedSettings, jobs, undefined, isCancelled, SCREENING_CHUNK_SIZE, async screenedChunk => {
            const mergedChunk = screenedChunk.map(job => combineProfileScreeningResult(
              job,
              reusableRecords.get(String(job.id)),
              job.profileMatches,
              settings,
              profiles,
            ));
            await saveScreeningRecords(mergedChunk, settings.screeningVersion);
            mergedChunk.forEach(record => {
              const savedRecord = { ...record, screeningVersion: String(settings.screeningVersion || '') };
              reusableRecords.set(String(record.id), savedRecord);
              mergedById.set(String(record.id), savedRecord);
            });
          }, onLog);
          const merged = [...mergedById.values()];
          const restored = merged.filter(job => job.match).length;
          onLog?.(`历史排除岗位复筛完成：${restored} 个恢复为符合条件，${merged.length - restored} 个继续排除`);
        } catch (error) {
          if (error?.code === 'BQA_DISCOVERY_STOPPED') throw error;
          onLog?.(`历史排除岗位复筛失败：${error?.message || '未知错误'}；原排除状态已保留`, 'error');
        }
      }
    } catch (error) {
      // 主动停止与达到上限按原流程处理；其他错误只终止后续读取，保留已有候选。
      if (error?.code === 'BQA_DISCOVERY_STOPPED' || error?.code === 'BQA_DAILY_DELIVERY_LIMIT') throw error;
      collectionError = error;
      onLog?.(`岗位识别中断：${error?.message || '未知错误'}；已保留当前识别结果`, 'error');
      onProgress?.(progressSnapshot({ phase: '后续岗位获取失败，已保留当前识别结果' }));
    } finally {
      // 主动停止时保留用户当下看到的列表页；只有正常完成识别才回到起始页。
      if (!isCancelled?.() && !stoppedForDailyLimit) {
        if (pagesMoved) onLog?.(`正在返回搜索起始页（共 ${pagesMoved} 页）`);
        for (let index = 0; index < pagesMoved; index += 1) {
          try {
            if (!(await changeJobListPage('prev'))) {
              onLog?.('返回搜索起始页失败，保留当前岗位识别结果', 'error');
              break;
            }
          } catch (error) {
            // 返回起始页失败不应丢弃已经收集好的候选岗位。
            collectionError ||= error;
            onLog?.(`返回搜索起始页失败：${error?.message || '未知错误'}`, 'error');
            break;
          }
        }
      }
    }
    onLog?.(`识别流程结束：读取 ${eligible} 个岗位，符合条件 ${analyzed.filter(job => job.match).length} 个，被排除 ${analyzed.filter(job => !job.match).length} 个`);
    return { jobs: analyzed, eligible, error: collectionError };
  }

  const sleep = milliseconds => new Promise(resolve => setTimeout(resolve, milliseconds));

  async function sendBackgroundRequest(message, actionName, maxAttempts = 2) {
    let lastError;
    for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
      try {
        const response = await chrome.runtime.sendMessage(message);
        if (response) return response;
        throw new Error('后台未返回结果');
      } catch (error) {
        lastError = error;
        // MV3 后台 Service Worker 偶发休眠/重启时，重新发送可唤醒后台并继续请求。
        const recoverable = /message channel closed|receiving end does not exist|could not establish connection/i.test(String(error?.message || error));
        if (!recoverable || attempt === maxAttempts) break;
        await sleep(500 * attempt);
      }
    }
    throw new Error(`${actionName}与扩展后台通讯失败：${lastError?.message || '消息通道已关闭'}；请刷新岗位列表后重试。`);
  }

  async function sleepUntilCancelled(milliseconds, isCancelled) {
    const deadline = Date.now() + milliseconds;
    while (Date.now() < deadline) {
      throwIfDiscoveryCancelled(isCancelled);
      await sleep(Math.min(100, deadline - Date.now()));
    }
    throwIfDiscoveryCancelled(isCancelled);
  }

  // 批量直连按产品约定保留 1–3 秒自然间隔；过去 5–8 秒会与重试、
  // 队列切换叠加，让用户感知为“几分钟没有下一条”。
  const randomDeliveryPause = () => 1000 + Math.floor(Math.random() * 2001);
  // 翻页只需等待列表 DOM 稳定，45–90 秒的旧防抖会让后续页岗位迟迟
  // 无法进入投递队列。保留同样的短随机等待即可。
  const randomPagePause = () => 1000 + Math.floor(Math.random() * 2001);
  async function waitForBossRequest(kind = 'default') {
    if (!hasExtensionContext()) return;
    const response = await sendBackgroundRequest({ type: 'BQA_ACQUIRE_BOSS_REQUEST', kind }, 'BOSS 请求节流');
    if (response?.cooldownUntil && response.cooldownUntil > Date.now()) {
      const error = new Error('BOSS 当前处于频率限制冷却中，请稍后再试');
      error.code = 'BQA_BOSS_COOLDOWN';
      throw error;
    }
  }
  function reportBossRequestError(error) {
    const text = String(error?.message || error || '');
    if (/操作过于频繁|访问受限|异常行为|频率限制|请求过多|too many requests|rate.?limit|429|403/i.test(text)) {
      void sendBackgroundRequest({ type: 'BQA_REPORT_BOSS_THROTTLE', reason: text }, 'BOSS 频率限制上报', 1).catch(() => {});
    }
  }
  const onJobsPage = () => /\/web\/geek\/jobs/.test(location.pathname);
  const onBossHomePage = () => location.pathname === '/' || location.pathname === '/index';
  const onChatPage = () => /\/(?:web\/geek\/)?chat(?:\/|$)/.test(location.pathname);
  const onJobDetailPage = () => /\/job_detail\//.test(location.pathname);

  function isVisibleCard(card) {
    return card && !card.classList.contains('bqa-hidden-card') && visible(card);
  }

  function markActiveCard(card) {
    for (const item of jobCards()) item.classList.remove('bqa-active-card');
    if (card) card.classList.add('bqa-active-card');
  }

  function nextVisibleCard(afterCard) {
    const cards = jobCards().filter(isVisibleCard);
    const oldIndex = jobCards().indexOf(afterCard);
    return cards.find(card => jobCards().indexOf(card) > oldIndex) || cards[0] || null;
  }

  function selectNextCard(afterCard) {
    const nextCard = nextVisibleCard(afterCard);
    if (!nextCard) return;
    // 同步 BOSS 原有的选中状态，使左侧高亮和右侧详情始终指向同一岗位。
    nextCard.click();
    markActiveCard(nextCard);
  }

  function companyElement(card) {
    return card.querySelector('.job-card-footer .boss-info, .boss-info, .company-name a, .company-info a, [class*="company-name"] a, [class*="company-name"], [class*="company-text"], .company-name, .company-text, [class*="company"] a');
  }

  function companyName(card) {
    const element = companyElement(card);
    return normalize(element?.innerText);
  }

  function salaryText(card) {
    const element = card.querySelector('.job-card-title .salary, .job-card-header .salary, .job-card-box .salary, .job-salary, [class*="job-salary"], [class*="salary"], .salary');
    const raw = element?.dataset?.salary || element?.getAttribute('data-salary') || element?.getAttribute('aria-label') || element?.getAttribute('title') || card.dataset.salary;
    const direct = normalize(raw || element?.innerText);
    if (direct) return direct;
    return card.dataset.salary || (card.innerText || '').match(/\d{1,3}(?:\.\d+)?(?:-\d{1,3}(?:\.\d+)?)?K(?:·\d+薪)?/i)?.[0] || '';
  }

  function salaryFontFamily(card) {
    const element = card.querySelector('.job-card-title .salary, .job-card-header .salary, .job-card-box .job-salary, .job-card-box .salary, .job-salary, [class*="job-salary"], [class*="salary"], .salary');
    return element ? getComputedStyle(element).fontFamily : '';
  }

  function sessionHiddenCompanies() {
    try {
      return new Set(JSON.parse(sessionStorage.getItem(HIDDEN_COMPANIES_KEY) || '[]'));
    } catch {
      return new Set();
    }
  }

  async function restorePersistentFilters() {
    const [savedCompanies, savedJobs, savedDelivered, savedDeliveryRecords, settings] = await Promise.all([
      getStored(HIDDEN_COMPANIES_KEY),
      getStored(DISMISSED_JOBS_KEY),
      getStored(DELIVERED_KEY),
      getStored(DELIVERY_RECORDS_KEY),
      getSettings()
    ]);
    setDailyDeliveryLimit(settings.dailyDeliveryLimit);
    // 兼容旧版本：将本次浏览器会话里已有的公司屏蔽迁移到持久化存储。
    persistedHiddenCompanies = new Set([...(savedCompanies || []), ...sessionHiddenCompanies()]);
    persistedDismissedJobs = new Map((savedJobs || []).map(job => {
      const record = typeof job === 'string'
        ? { id: job, title: '已屏蔽岗位', company: '历史记录' }
        : job;
      return [record.id, record];
    }).filter(([id]) => Boolean(id)));
    persistedDeliveryRecords = storedJobsMap(savedDeliveryRecords, 'delivery-record');
    // 旧版本没有记录投递时间；升级时只迁移一次，将这些既有记录归为今天，避免“今日投递”被错误显示为 0。
    const legacyDeliveredAt = Date.now();
    let migratedLegacyDelivered = false;
    persistedDeliveredJobs = new Map((savedDelivered || []).map((job, index) => {
      const source = typeof job === 'string'
        ? { id: job, title: '已沟通岗位', company: '历史记录' }
        : job;
      const record = normalizeStoredJob({ ...source });
      if (!record) return null;
      if (!record.deliveredAt) {
        record.deliveredAt = legacyDeliveredAt;
        migratedLegacyDelivered = true;
      }
      return [storedJobKey(record, index, 'delivered'), record];
    }).filter(Boolean));
    await setStored(HIDDEN_COMPANIES_KEY, [...persistedHiddenCompanies]);
    if (migratedLegacyDelivered) await setStored(DELIVERED_KEY, [...persistedDeliveredJobs.values()]);
    if (onJobsPage()) applyListFilters();
    // 悬浮插件可能早于 storage 记录完成渲染；记录恢复后必须再次刷新今日数量。
    if (onJobsPage()) renderDailyDeliveryQuota();
  }

  async function rememberHiddenCompany(name) {
    persistedHiddenCompanies.add(name);
    await setStored(HIDDEN_COMPANIES_KEY, [...persistedHiddenCompanies]);
  }

  async function rememberDismissedJob(job) {
    if (!job?.id) return;
    persistedDismissedJobs.set(job.id, job);
    await setStored(DISMISSED_JOBS_KEY, [...persistedDismissedJobs.values()]);
  }

  async function rememberDeliveredJob(job) {
    const id = canonicalJobId(job?.id);
    if (!id) return;
    const normalizedJob = { ...job, id };
    const result = await sendBackgroundRequest({ type: 'BQA_RECORD_DELIVERED', job: normalizedJob }, '记录投递结果');
    if (!result?.ok) throw new Error(result?.error || '未能记录投递结果');
    persistedDeliveredJobs.set(id, result.job || { ...normalizedJob, deliveredAt: Date.now() });
    renderDailyDeliveryQuota();
    // 批量投递与单个投递共用同一份成功记录：一旦发送成功，立即从岗位列表移除。
    applyListFilters();
  }

  async function updateDeliveryRecord(job, deliveryStatus, extra = {}) {
    const id = canonicalJobId(job?.id);
    if (!id) return;
    const response = await sendBackgroundRequest({
      type: 'BQA_UPSERT_DELIVERY_RECORD',
      record: {
        id,
        title: job.title,
        company: job.company,
        salary: job.salary,
        salaryFont: job.salaryFont,
        detailUrl: job.detailUrl,
        deliveryStatus,
        ...extra,
      },
    }, '更新投递记录');
    if (!response?.ok) throw new Error(response?.error || '未能更新投递记录');
    recordDeliveryDiagnostic({
      phase: 'delivery-record', action: 'status-update', status: deliveryStatus === '投递失败' ? 'failed' : 'updated',
      stage: deliveryStatus, jobId: id, sessionId: extra.sessionId,
    });
  }

  function isContactedCard(card) {
    // 过滤会在列表刷新时频繁执行。避免每次都递归收集整张卡片的所有 class，
    // 只读取文本和可能表达“已沟通”的节点，并按卡片内容缓存结果。
    const text = normalize(card.textContent);
    const stateNode = card.querySelector('[class*="gray" i], [class*="disabled" i], [class*="communicat" i], [class*="chatted" i], [class*="already-chat" i]');
    const classSignature = `${typeof card.className === 'string' ? card.className : ''}|${typeof stateNode?.className === 'string' ? stateNode.className : ''}`;
    const signature = `${text}|${classSignature}`;
    const cached = contactedCardCache.get(card);
    if (cached?.signature === signature) return cached.value;
    const value = /已沟通|沟通过|已联系|已投递|继续沟通/.test(text)
      || /(^|[-_\s])(gray|disabled|communicated|has-chatted|already-chat)([-_\s]|$)/i.test(classSignature)
      || Number(getComputedStyle(card).opacity) < 0.75;
    contactedCardCache.set(card, { signature, value });
    return value;
  }

  function applyListFilters() {
    for (const card of jobCards()) {
      const id = jobId(card);
      if (id) card.dataset.bqaJobId = id;
      else delete card.dataset.bqaJobId;
      const name = companyName(card);
      // 手动忽略/已投递的标记必须优先于动态过滤，避免 BOSS 更新列表时将卡片重新显示。
      const shouldHide = card.classList.contains('bqa-dismissed-card')
        || dismissedJobMatches(card)
        || deliveredJobMatches(card)
        || (name && persistedHiddenCompanies.has(name))
        || isContactedCard(card);
      card.classList.toggle('bqa-hidden-card', Boolean(shouldHide));
    }
    const activeCard = document.querySelector('.bqa-active-card');
    if (activeCard && !isVisibleCard(activeCard)) selectNextCard(activeCard);
  }

  async function dismissJob(button, title) {
    const sourceCard = jobCard(title);
    if (!sourceCard) return;
    const job = readJob(sourceCard);
    // 统一定位真正承载列表布局的岗位卡片，避免只隐藏内部标题节点后又被列表刷新显示。
    const card = cardForJob(job) || sourceCard;
    // 仅从当前页面移除，不调用 BOSS 的“不感兴趣”接口，也不影响账号推荐。
    card.classList.add('bqa-dismissed-card', 'bqa-hidden-card');
    await rememberDismissedJob({ ...job, detailUrl: job.detailUrl || jobDetailUrl(card) });
    // BOSS 会切换右侧详情；这里同时激活下一张卡，消除“右侧已变、左侧没高亮”的歧义。
    requestAnimationFrame(() => selectNextCard(card));
  }

  async function dismissCompany(button, card) {
    const name = companyName(card);
    if (!name) return;
    await rememberHiddenCompany(name);
    applyListFilters();
  }

  function quickApply(button, title) {
    if (button.disabled) return;
    const card = jobCard(title);
    if (!card) return;
    const job = readJob(card);
    button.disabled = true;
    button.textContent = '排队中…';
    status.set(button, 'waiting');
    const execute = async () => {
      button.textContent = '投递中…';
      try {
      const settings = await getSettings();
      if (pluginGreetingEnabled(settings) && (!settings.apiUrl || !settings.apiKey || !settings.model || !settings.resumePdfText)) {
        button.disabled = false;
        button.textContent = '快速投递';
        showSettings(() => quickApply(button, title));
        return;
      }
      const cached = await cacheDirectDeliveryData([job], 0);
      const prepared = cached[0];
      if (!prepared) throw new Error('无法读取该岗位的 JD 或安全标识，请稍后重试');
      // 复用批量投递入口，确保 AI 话术、直连发送、图片、重试和投递记录完全一致。
      await startBatchDelivery([prepared.id], [prepared], { silentCompletion: true });
      // startBatchDelivery 现在只负责把任务交给后台唯一消费者；入队不等于已经发送。
      // 旧逻辑在这里立即读取“已投递”记录，必然把正常排队误判为投递失败。
      button.textContent = '排队中';
      status.set(button, 'waiting');
      } catch (error) {
        console.warn('[BOSS 快速投递]', error);
        button.disabled = false;
        button.textContent = '重试投递';
        status.set(button, 'error');
      }
    };
    const queued = quickApplyQueue.then(execute, execute);
    // 单个岗位出错不阻塞后续已排队的岗位。
    quickApplyQueue = queued.catch(() => {});
    return queued;
  }

  function quickApplyDetail(button) {
    if (button.disabled) return;
    const execute = async () => {
      button.disabled = true;
      button.textContent = '投递中…';
      try {
        const settings = await getSettings();
        if (pluginGreetingEnabled(settings) && (!settings.apiUrl || !settings.apiKey || !settings.model || !settings.resumePdfText)) {
          button.disabled = false;
          button.textContent = '快速投递';
          showSettings(() => quickApplyDetail(button));
          return;
        }
        const job = readDetailJob();
        if (!job.id) throw new Error('未能读取岗位 ID，请刷新详情页后重试');
        const meta = await getPageJobMeta(job.id);
        const prepared = {
          ...job,
          securityId: meta?.securityId || job.securityId,
          encryptJobId: meta?.encryptJobId || job.id,
          salary: meta?.salary || job.salary,
          cachedJd: job.cachedJd || job.summary || `${job.title || ''} ${job.company || ''}`.trim(),
        };
        if (!prepared.securityId || !prepared.cachedJd) {
          throw new Error('无法读取该岗位的 JD 或安全标识，请稍后重试');
        }
        await startBatchDelivery([prepared.id], [prepared], { silentCompletion: true });
        button.textContent = '排队中';
        status.set(button, 'waiting');
      } catch (error) {
        console.warn('[BOSS 详情页快速投递]', error);
        button.disabled = false;
        button.textContent = '重试投递';
        status.set(button, 'error');
        showNotice(error?.message || '快速投递未能加入队列', 'error');
      }
    };
    const queued = quickApplyQueue.then(execute, execute);
    quickApplyQueue = queued.catch(() => {});
    return queued;
  }

  async function readFullJobDescription(card, isCancelled) {
    card.click();
    markActiveCard(card);
    await sleepUntilCancelled(1300, isCancelled);
    const detail = document.querySelector('.job-detail-box, .job-detail, [class*="job-detail"], .detail-content');
    const sections = [...document.querySelectorAll('.job-sec-text, [class*="job-desc"], [class*="job-sec"]')];
    const text = normalize(detail?.innerText || sections.map(section => section.innerText).join('\n'));
    return text.slice(0, 2400);
  }

  async function openDedicatedChat(card) {
    card.click();
    markActiveCard(card);
    await openDedicatedChatFromDetail();
  }

  function findCommunicationButton(labels) {
    const wanted = labels.map(label => normalize(label)).filter(Boolean);
    return [...document.querySelectorAll('button, a, [role="button"], [class*="btn" i], [class*="chat" i]')]
      .filter(element => visible(element) && !element.closest('.bqa-'))
      .find(element => {
        const text = normalize(element.innerText || element.getAttribute('aria-label') || element.title);
        if (!text) return false;
        // BOSS 会在按钮中追加“/已沟通”等状态文字，不能只做完全相等匹配。
        return wanted.some(label => text === label || text.includes(label));
      }) || null;
  }

  function findExactCommunicationButton(labels) {
    const wanted = new Set(labels.map(label => normalize(label)).filter(Boolean));
    return [...document.querySelectorAll('button, a, [role="button"], [class*="btn" i]')]
      .filter(element => visible(element) && !element.closest('.bqa-'))
      .find(element => wanted.has(normalize(element.innerText || element.getAttribute('aria-label') || element.title))) || null;
  }

  function visibleCommunicationDialog() {
    const candidates = [...document.querySelectorAll(
      '[role="dialog"], .dialog-container, .dialog, .modal, .ui-dialog, [class*="dialog" i], [class*="modal" i]'
    )].filter(element => visible(element) && !element.closest('.bqa-'));
    return candidates.sort((a, b) => {
      const aRect = a.getBoundingClientRect();
      const bRect = b.getBoundingClientRect();
      return (bRect.width * bRect.height) - (aRect.width * aRect.height);
    })[0] || null;
  }

  function continueChatConfirmationButton(excluded = new Set()) {
    // BOSS 的确认层没有稳定的 role/dialog 或 class；不能仅依赖“弹窗容器”。
    // 在已点击“立即沟通”后，从所有可见节点中找精确的“继续沟通”，并只接受
    // 位于最上层的那个节点，从而排除详情页原本可能存在的同名历史会话入口。
    const candidates = [...document.querySelectorAll('button, a, [role="button"], div, span')]
      .filter(element => visible(element) && !element.closest('.bqa-'))
      .filter(element => !excluded.has(element))
      .filter(element => normalize(element.innerText || element.getAttribute('aria-label') || element.title) === '继续沟通')
      .filter(element => {
        const rect = element.getBoundingClientRect();
        if (rect.width < 24 || rect.height < 20) return false;
        const topNode = document.elementFromPoint(rect.left + rect.width / 2, rect.top + rect.height / 2);
        return topNode === element || topNode?.closest('button, a, [role="button"], div, span') === element;
      });
    const dialog = visibleCommunicationDialog();
    if (dialog) {
      const inDialog = candidates.find(element => dialog.contains(element));
      if (inDialog) return inDialog;
    }
    // 确认层通常以 fixed/absolute 和较高层级覆盖详情页，优先选择最上层候选。
    return candidates.sort((a, b) => {
      const styleA = getComputedStyle(a);
      const styleB = getComputedStyle(b);
      const layerA = Number.parseInt(styleA.zIndex, 10) || 0;
      const layerB = Number.parseInt(styleB.zIndex, 10) || 0;
      const positionedA = /fixed|absolute/.test(styleA.position) ? 1 : 0;
      const positionedB = /fixed|absolute/.test(styleB.position) ? 1 : 0;
      return (layerB + positionedB * 100000) - (layerA + positionedA * 100000);
    })[0] || null;
  }

  function pageClickControlDescription(element) {
    if (!element) return '未找到';
    const label = normalize(element.innerText || element.getAttribute('aria-label') || element.title) || '无文字';
    const classes = String(element.className || '').trim().replace(/\s+/g, '.').slice(0, 90);
    return `${element.tagName.toLowerCase()}${classes ? `.${classes}` : ''}[${label.slice(0, 30)}]`;
  }

  function pageClickSnapshot() {
    const controls = [...document.querySelectorAll('button, a, [role="button"], [class*="btn" i]')]
      .filter(element => visible(element) && !element.closest('.bqa-'));
    const labels = controls
      .map(element => normalize(element.innerText || element.getAttribute('aria-label') || element.title))
      .filter(label => /沟通|消息|留在此页/.test(label))
      .slice(0, 8);
    const continueCandidates = [...document.querySelectorAll('button, a, [role="button"], div, span')]
      .filter(element => visible(element) && normalize(element.innerText || element.getAttribute('aria-label') || element.title) === '继续沟通')
      .slice(0, 4)
      .map(pageClickControlDescription);
    return {
      url: location.pathname,
      inChat: onChatPage(),
      dialog: Boolean(visibleCommunicationDialog()),
      detailAction: pageClickControlDescription(detailCommunicationButton()),
      visibleLabels: labels,
      continueCandidates,
    };
  }

  async function reportPageClickStage(stage, extra = '') {
    const pending = await getStored(PENDING_CHAT_KEY);
    const batch = await getStored(BATCH_KEY).catch(() => null);
    const snapshot = pageClickSnapshot();
    const failed = /失败/.test(stage);
    const failureType = !failed ? ''
      : /未出现继续沟通确认弹窗/.test(stage) ? 'confirmation-not-detected'
        : /未进入消息页/.test(stage) ? 'chat-page-not-loaded'
          : /未找到/.test(stage) ? 'communication-control-not-found' : 'page-click-failed';
    recordDeliveryDiagnostic({
      phase: 'page-click', action: 'communication-flow', status: failed ? 'failed' : /停止/.test(stage) ? 'stopped' : 'progress',
      stage, failureType, taskId: batch?.queueTaskId, sessionId: pending?.sessionId,
      jobId: canonicalJobId(pending?.deliveryJob?.id || pending?.jobId), route: snapshot.url,
      inChat: snapshot.inChat, dialog: snapshot.dialog, detailAction: snapshot.detailAction,
      visibleLabels: snapshot.visibleLabels, continueCandidates: snapshot.continueCandidates,
      documentState: document.readyState,
    });
    const details = [
      `页面点击诊断：${stage}`,
      `页面=${snapshot.url}`,
      `详情按钮=${snapshot.detailAction}`,
      `确认层=${snapshot.dialog ? '已发现' : '未发现'}`,
      `继续沟通候选=${snapshot.continueCandidates.join('、') || '无'}`,
      `可见沟通文案=${snapshot.visibleLabels.join('、') || '无'}`,
      extra,
    ].filter(Boolean).join('；');
    if (pending?.deliveryJob) {
      await updateDeliveryRecord(pending.deliveryJob, stage, { sessionId: pending.sessionId, error: details }).catch(() => {});
    }
    return details;
  }

  // PATCH 2026-11-03: 若选中元素是容器 div（如 div.btn-startchat-wrap），
  // 向下钻取到真正的 <a>/<button>，避免点击容器无任何效果。
  function drillToClickable(element) {
    if (!element) return element;
    if (/^(A|BUTTON)$/.test(element.tagName)) return element;
    const inner = [...element.querySelectorAll('a, button, [role="button"]')]
      .find(candidate => visible(candidate));
    return inner || element;
  }

  function detailCommunicationButton() {
    const detail = detailHeader();
    const labelOf = element => normalize(element.innerText || element.getAttribute('aria-label') || element.title);
    const collect = root => [...root.querySelectorAll('button, a, [role="button"], [class*="btn" i], [class*="chat" i], [onclick]')]
      .filter(element => visible(element) && !element.closest('.bqa-'));
    const isAction = element => {
      if (!element || !visible(element) || element.closest('.bqa-')) return false;
      const className = String(element.className || '');
      const style = getComputedStyle(element);
      return element.matches('button, a, [role="button"], [onclick]')
        || /btn|chat|contact|action/i.test(className)
        || style.cursor === 'pointer';
    };
    const actions = [...new Set([...collect(detail), ...collect(document)])];
    // PATCH 2026-11-03: BOSS 的“立即沟通”外层是 div.btn-startchat-wrap（容器），
    // 真正的点击目标在最内层 <a>/<button>，点容器不会触发任何事件。
    const areaOf = (el) => { const r = el.getBoundingClientRect(); return r.width * r.height; };
    const exactLabel = actions.filter(element => labelOf(element) === '立即沟通');
    const direct = exactLabel.filter(el => /^(A|BUTTON)$/.test(el.tagName))
        .sort((a, b) => areaOf(a) - areaOf(b))[0]
      || exactLabel.sort((a, b) => areaOf(a) - areaOf(b))[0]
      || actions.find(element => /立即沟通/.test(labelOf(element)));
    if (direct) return direct;

    // BOSS 会调整详情页按钮标签结构；有些版本把文字放在没有 role/class 的 span/div 中，
    // 这时沿父节点向上找真实可点击控件，仍只接受“立即沟通”文字，不碰“感兴趣”。
    const textNodes = [...document.querySelectorAll('div, span, p')]
      .filter(element => visible(element) && !element.closest('.bqa-') && labelOf(element) === '立即沟通')
      .sort((a, b) => {
        const aRect = a.getBoundingClientRect();
        const bRect = b.getBoundingClientRect();
        return (aRect.width * aRect.height) - (bRect.width * bRect.height);
      });
    for (const node of textNodes) {
      let candidate = node;
      for (let depth = 0; candidate && depth < 5; depth += 1, candidate = candidate.parentElement) {
        if (isAction(candidate)) return candidate;
      }
    }
    return textNodes[0] || null;
  }

  async function waitForJobDetailReady(pending, timeout = 20000) {
    const started = Date.now();
    const expectedId = canonicalJobId(pending?.detailUrl || pending?.jobId);
    const tabId = await currentChromeTabId();
    const openedTargetTab = Boolean(pending?.chatTabId && tabId && Number(pending.chatTabId) === tabId);
    while (Date.now() - started < timeout) {
      const detail = detailHeader();
      const text = normalize(detail?.innerText || '');
      const actualId = canonicalJobId(location.href);
      const titleMatches = Boolean(pending?.title && text.includes(normalize(pending.title)));
      const companyMatches = !pending?.company || text.includes(normalize(pending.company));
      const detailMatchesTarget = titleMatches && companyMatches;
      // 详情页是后台刚打开的专用标签时，以 tabId 为目标锚点；BOSS 重写岗位 ID
      // 或详情头部类名变化，不应让正确页面因为二次校验失败而卡住。
      const routeMatches = openedTargetTab || (expectedId && actualId === expectedId) || detailMatchesTarget;
      // 保留旧版通过详情页自身岗位 ID 判断页面就绪的路径。BOSS 偶尔改写 URL，
      // 新标签页 ID、匹配标题或页面岗位 ID 任一成立即可继续识别沟通入口。
      const hasJob = Boolean(text.length > 20 && (openedTargetTab || routeMatches || readDetailJob().id));
      const action = detailCommunicationButton();
      // “继续沟通”意味着已有会话；同样表示详情页已加载完成，交由调用方
      // 明确阻止自动重发，而不是把它误报成加载超时。
      // 按钮已经在目标详情页可见时，不再要求详情标题容器先通过文字校验；
      // BOSS 某些布局会先渲染沟通按钮，再补齐详情文本，旧条件会白等后报失败。
      if (action) return action;
      if (hasJob && findExactCommunicationButton(['继续沟通'])) return null;
      await sleep(180);
    }
    const detail = detailHeader();
    const text = normalize(detail?.innerText || '');
    const controls = [...document.querySelectorAll('button, a, [role="button"], [class*="btn" i], [class*="chat" i]')]
      .filter(element => visible(element) && !element.closest('.bqa-'))
      .map(element => normalize(element.innerText || element.getAttribute('aria-label') || element.title))
      .filter(label => /沟通|聊天|消息/.test(label))
      .slice(0, 8);
    const diagnostic = [
      `页面=${location.pathname}`,
      `文档状态=${document.readyState}`,
      `岗位ID=${canonicalJobId(location.href) || '未识别'}`,
      `目标岗位=${normalize(pending?.title || '').slice(0, 40) || '未知'}`,
      `详情文本=${text.slice(0, 100) || '空'}`,
      `沟通控件=${controls.join('、') || '未找到'}`,
    ].join('；');
    await reportPageClickStage('页面点击失败：详情页未找到沟通入口', diagnostic).catch(() => {});
    throw new Error(`岗位详情页未找到“立即沟通”按钮。${diagnostic}`);
  }

  async function clickCommunicationButton(labels, timeout = TIMEOUT_MS) {
    const started = Date.now();
    while (Date.now() - started < timeout) {
      const button = findCommunicationButton(labels);
      if (button) {
        button.scrollIntoView({ block: 'center', behavior: 'auto' });
        button.click();
        return button;
      }
      await sleep(POLL_MS);
    }
    throw new Error(`未找到沟通按钮（${labels.join(' / ')}）`);
  }

  async function openDedicatedChatFromDetail(pending) {
    // 详情页由前端异步渲染，必须等真实动作区出现后再点击。
    await waitForJobDetailReady(pending);
    // 第一步仅点击“立即沟通”；“感兴趣”只是收藏，不能点击。
    const started = Date.now();
    let firstButton = null;
    while (Date.now() - started < TIMEOUT_MS) {
      firstButton = detailCommunicationButton();
      if (firstButton) break;
      await sleep(POLL_MS);
    }
    if (!firstButton) {
      if (findExactCommunicationButton(['继续沟通'])) {
        const details = await reportPageClickStage('页面点击已停止：岗位已有沟通记录');
        throw new Error(`该岗位已有沟通记录，详情页仅显示“继续沟通”；为避免重复发送，本次不再自动进入会话。${details}`);
      }
      const details = await reportPageClickStage('页面点击失败：未找到立即沟通');
      throw new Error(`未找到岗位详情页的“立即沟通”按钮。${details}`);
    }
    // 记录点击前详情页已存在的“继续沟通”；它代表历史会话，绝不可当成
    // 新出现的确认弹窗按钮。
    const existingContinueButtons = new Set([...document.querySelectorAll('button, a, [role="button"], div, span')]
      .filter(element => visible(element) && normalize(element.innerText || element.getAttribute('aria-label') || element.title) === '继续沟通'));
    firstButton = drillToClickable(firstButton);
    firstButton.scrollIntoView({ block: 'center', behavior: 'auto' });
    firstButton.click();
    firstButton.setAttribute('data-bqa-clicked', 'true');
    await reportPageClickStage('已点击立即沟通，等待确认弹窗', `点击控件=${pageClickControlDescription(firstButton)}`);

    // 点击“立即沟通”后必须只在弹窗内点击“继续沟通”。详情页已有的
    // “继续沟通”代表历史会话，不能当成确认弹窗按钮，否则可能重复发送。
    const transitionStarted = Date.now();
    let continued = false;
    while (Date.now() - transitionStarted < 20000) {
      if (onChatPage() || findChatInput()) break;
      const continueChat = continueChatConfirmationButton(existingContinueButtons);
      if (continueChat && !continued) {
        continued = true;
        await reportPageClickStage('已发现确认弹窗中的继续沟通', `确认控件=${pageClickControlDescription(continueChat)}`);
        continueChat.scrollIntoView({ block: 'center', behavior: 'auto' });
        continueChat.click();
        await reportPageClickStage('已点击继续沟通，等待消息页', `确认控件=${pageClickControlDescription(continueChat)}`);
        // 点击继续沟通后必须等待页面真正跳转，不能立即返回给投递流程。
        await sleep(250);
        continue;
      }
      await sleep(POLL_MS);
    }

    const chatStarted = Date.now();
    while (Date.now() - chatStarted < 12000) {
      if (onChatPage()) {
        await waitForChatInput(15000);
        return;
      }
      if (findChatInput()) return;
      await sleep(180);
    }
    const failureStage = continued ? '页面点击失败：继续沟通后未进入消息页' : '页面点击失败：未出现继续沟通确认弹窗';
    const details = await reportPageClickStage(failureStage);
    throw new Error(`${continued ? '点击继续沟通后未进入消息页面' : '点击沟通后未出现继续沟通确认弹窗或消息页面'}。${details}`);
  }

  function findChatInput() {
    return [...document.querySelectorAll('div#chat-input, .chat-input[contenteditable], [contenteditable="true"], textarea')]
      .find(element => visible(element));
  }

  async function waitForChatInput(timeout = 15000) {
    const started = Date.now();
    while (Date.now() - started < timeout) {
      const input = findChatInput();
      if (input) return input;
      await sleep(250);
    }
    throw new Error('未找到聊天输入框');
  }

  function insertChatText(input, text) {
    input.focus();
    if (input.isContentEditable || input.getAttribute('contenteditable') === 'true') {
      // BOSS 聊天框由 Vue 控制，单纯写 textContent 不一定更新其内部状态。
      input.textContent = '';
      try { document.execCommand('insertText', false, text); } catch { input.textContent = text; }
      if (normalize(input.innerText || input.textContent) !== normalize(text)) input.textContent = text;
      input.dispatchEvent(new CompositionEvent('compositionstart', { bubbles: true }));
      input.dispatchEvent(new InputEvent('input', { bubbles: true, inputType: 'insertText', data: text }));
      input.dispatchEvent(new CompositionEvent('compositionend', { bubbles: true, data: text }));
    } else {
      const setter = Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, 'value')?.set;
      if (setter) setter.call(input, text); else input.value = text;
      input.dispatchEvent(new Event('input', { bubbles: true }));
    }
  }

  async function sendGreetingInChat(pending) {
    // 用户明确选择“页面点击”时，始终由聊天页输入框发送，不尝试 WebSocket。
    const sentDirectly = pending.greetingMode === 'page' ? false : await sendGreetingDirectly(pending).catch(error => {
      console.warn('[BOSS 智能投递] WebSocket 发送不可用，改用页面输入框', error);
      return false;
    });
    if (sentDirectly) return;
    const input = await waitForChatInput();
    insertChatText(input, pending.greeting);
    await sleep(500);
    const sendButton = [...document.querySelectorAll('button.btn-send, .btn-send, button[class*="send" i], [role="button"][class*="send" i]')]
      .find(element => visible(element) && !element.disabled && !element.classList.contains('disabled'));
    // 只走一种发送路径。此前 Enter 后又点击发送按钮，会在部分 BOSS 版本产生两条相同消息。
    if (sendButton) {
      sendButton.click();
    } else {
      input.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true, cancelable: true }));
      input.dispatchEvent(new KeyboardEvent('keyup', { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true }));
    }
    await sleep(1200);
  }

  function getPageAuth(timeout = 5000) {
    if (cachedPageAuth && Date.now() - cachedPageAuthAt < 5 * 60 * 1000) return Promise.resolve(cachedPageAuth);
    return new Promise(resolve => {
      const handler = event => {
        window.removeEventListener('BQA_PAGE_AUTH_RESPONSE', handler);
        cachedPageAuth = event.detail || {};
        cachedPageAuthAt = Date.now();
        resolve(cachedPageAuth);
      };
      window.addEventListener('BQA_PAGE_AUTH_RESPONSE', handler, { once: true });
      window.dispatchEvent(new CustomEvent('BQA_PAGE_AUTH_REQUEST'));
      setTimeout(() => {
        window.removeEventListener('BQA_PAGE_AUTH_RESPONSE', handler);
        resolve({});
      }, timeout);
    });
  }

  function getPageJobMeta(jobId, timeout = 3000) {
    return new Promise(resolve => {
      const requestId = makeBatchSessionId();
      const handler = event => {
        if (event.detail?.requestId !== requestId) return;
        window.removeEventListener('BQA_JOB_META_RESPONSE', handler);
        resolve(event.detail.job || null);
      };
      window.addEventListener('BQA_JOB_META_RESPONSE', handler);
      window.dispatchEvent(new CustomEvent('BQA_JOB_META_REQUEST', { detail: { requestId, jobId } }));
      setTimeout(() => {
        window.removeEventListener('BQA_JOB_META_RESPONSE', handler);
        resolve(null);
      }, timeout);
    });
  }

  async function readBossJson(response, endpoint) {
    const body = await response.text();
    try {
      const result = JSON.parse(body);
      const text = JSON.stringify(result);
      if (/操作过于频繁|访问受限|异常行为|频率限制|请求过多|too many requests|rate.?limit/i.test(text)) {
        reportBossRequestError(new Error(text.slice(0, 180)));
      } else if (response.ok) {
        void sendBackgroundRequest({ type: 'BQA_REPORT_BOSS_SUCCESS' }, 'BOSS 频率限制恢复', 1).catch(() => {});
      }
      return result;
    } catch (error) {
      reportBossRequestError(error);
      const type = response.headers.get('content-type') || '未知类型';
      throw new Error(`${endpoint} 返回非 JSON 响应（HTTP ${response.status}，${type}）；请确认仍处于登录状态且未触发平台验证`);
    }
  }

  async function fetchBossWithTimeout(url, options, timeout = 20000) {
    const endpoint = String(url instanceof URL ? url.pathname : url || '');
    const kind = /friend\/add|chatremind|uploadSingle/i.test(endpoint) ? 'send'
      : /getBossData|job_detail|jobDetail|zpgeek\/job/i.test(endpoint) ? 'detail' : 'default';
    await waitForBossRequest(kind);
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeout);
    try {
      const response = await fetch(url, { ...options, signal: controller.signal });
      if (response.status === 403 || response.status === 429) reportBossRequestError(new Error(`HTTP ${response.status}`));
      else if (response.ok) void sendBackgroundRequest({ type: 'BQA_REPORT_BOSS_SUCCESS' }, 'BOSS 频率限制恢复', 1).catch(() => {});
      return response;
    } catch (error) {
      if (controller.signal.aborted) throw new Error(`${url instanceof URL ? url.pathname : url} 请求超时（${Math.round(timeout / 1000)} 秒）`);
      reportBossRequestError(error);
      throw error;
    } finally {
      clearTimeout(timer);
    }
  }

  async function getChatTarget(pending, auth) {
    if (!pending.securityId || !auth.encryptedUid) throw new Error('当前岗位未提供安全标识，无法直连发送');
    const form = new FormData();
    form.append('bossId', auth.encryptedUid);
    form.append('securityId', pending.securityId);
    form.append('bossSrc', '0');
    const response = await fetchBossWithTimeout('https://www.zhipin.com/wapi/zpchat/geek/getBossData', {
      method: 'POST', body: form, headers: { Zp_token: auth.bst || '' }
    }).then(result => readBossJson(result, 'getBossData'));
    const boss = response?.zpData?.data;
    if (Number(response?.code) !== 0 || !boss?.bossId || !boss?.encryptBossId) {
      throw new Error(`getBossData：${response?.message || '未能读取会话对方信息'}`);
    }
    return { bossUid: Number(boss.bossId), encryptBossId: boss.encryptBossId, bossSource: boss.bossSource || 0 };
  }

  async function startConversation(pending, auth, { confirmedLimit = false } = {}) {
    if (!pending.securityId || !pending.encryptJobId) {
      throw new Error('当前职位未提供安全标识，无法在列表页建立沟通');
    }
    const url = new URL('https://www.zhipin.com/wapi/zpgeek/friend/add.json');
    url.searchParams.set('securityId', pending.securityId);
    url.searchParams.set('jobId', pending.encryptJobId);
    if (confirmedLimit) url.searchParams.set('cid', '1');
    const response = await fetchBossWithTimeout(url, {
      method: 'POST', headers: { Zp_token: auth.bst || '' }
    }).then(result => readBossJson(result, 'friend/add.json'));
    if (Number(response?.code) === 0) return;

    const dialog = response?.zpData?.bizData?.chatRemindDialog || {};
    const content = String(dialog.content || response?.message || '未知错误');
    // 与 boss-helper 的 sendPublishReq 对齐：BOSS 在触及第一档沟通提醒时，
    // 先确认提醒弹窗，再带 cid=1 重试同一个建立沟通请求。
    if (!confirmedLimit && Number(response?.code) === 1 && /今天已与\d+位BOSS沟通/.test(content) && !content.includes('150位BOSS沟通')) {
      if (!dialog.ba) throw new Error(`friend/add.json：开聊提醒缺少确认标识：${content}`);
      const confirmUrl = new URL('https://www.zhipin.com/wapi/zpCommon/actionLog/geek/chatremind.json');
      confirmUrl.searchParams.set('ba', String(dialog.ba));
      confirmUrl.searchParams.set('action', 'addf-limit-popup-c');
      const confirmResponse = await fetchBossWithTimeout(confirmUrl, {
        method: 'POST', headers: { Zp_token: auth.bst || '' }
      }).then(result => readBossJson(result, 'chatremind.json'));
      if (Number(confirmResponse?.code) !== 0) {
        throw new Error(`chatremind.json：${confirmResponse?.message || '确认开聊提醒失败'}`);
      }
      return startConversation(pending, auth, { confirmedLimit: true });
    }
    if (content.includes('150位BOSS沟通')) {
      const error = new Error(`今日沟通已达平台上限：${content}`);
      error.code = 'BQA_DAILY_DELIVERY_LIMIT';
      throw error;
    }
    if (content.includes('操作过于频繁')) throw new Error(`平台限制：${content}`);
    throw new Error(`friend/add.json：${content}`);
  }

  async function getChatCredentials(auth) {
    const identity = `${auth.token}:${auth.uid}`;
    if (cachedChatCredentials?.identity === identity && cachedChatCredentials.wt) return cachedChatCredentials;
    const wtResponse = await fetchBossWithTimeout('https://www.zhipin.com/wapi/zppassport/get/wt').then(result => readBossJson(result, 'get/wt'));
    const wt = wtResponse?.zpData?.wt2 || wtResponse?.zpData?.wt;
    if (Number(wtResponse?.code) !== 0 || !wt) throw new Error(wtResponse?.message || '未获取到聊天凭据');
    cachedChatCredentials = { identity, token: auth.token, wt, selfUid: auth.uid };
    return cachedChatCredentials;
  }

  async function sendGreetingDirectly(pending, { establishConversation = false } = {}) {
    if (!globalThis.BqaDirectChatClient) throw new Error('聊天客户端未加载');
    const auth = await getPageAuth();
    if (!auth.token || !auth.uid || !auth.encryptedUid || !auth.bst) throw new Error('未读取到完整 BOSS 页面登录态');
    // 先完成不改变沟通关系的准备工作，再建立沟通并立即发送本条话术。
    // 这样全局的岗位间隔只作用于“建立沟通”这一高风险动作，不会让首个岗位
    // 在 getBossData、聊天凭据等内部步骤之间重复等待数十秒。
    const target = await getChatTarget(pending, auth);
    const credentials = await getChatCredentials(auth);
    if (establishConversation) {
      // 这一步会等待所有任务共享的沟通间隔；先把状态写入沟通记录，避免用户看到
      // “排队中”却不知道消费者已经在等待平台节流。
      await updateDeliveryRecord(pending.deliveryJob, '等待全局沟通间隔', { sessionId: pending.sessionId }).catch(() => {});
      await startConversation(pending, auth);
    }
    // WebSocket 发送时 MV3 Service Worker 偶发重启会关闭一次性消息通道。
    // 发送锁已在后台持久化，因此这里可以安全地多次恢复通讯而不会重复发送。
    const sent = await sendBackgroundRequest({
      type: 'BQA_SEND_SHARED_CHAT', credentials, target, greeting: pending.greeting,
      deliveryJob: pending.deliveryJob, conversationPermit: establishConversation,
      sessionId: pending.sessionId,
    }, '发送招呼语', 4);
    if (!sent?.ok) throw new Error(sent?.error || '聊天消息发送失败');
    return sent;
  }

  async function establishConversationWithoutGreeting(pending) {
    const auth = await getPageAuth();
    if (!auth.token || !auth.uid || !auth.encryptedUid || !auth.bst) throw new Error('未读取到完整 BOSS 页面登录态');
    await updateDeliveryRecord(pending.deliveryJob, '正在建立沟通（AI 招呼已关闭）', { sessionId: pending.sessionId }).catch(() => {});
    await startConversation(pending, auth);
    const normalizedJob = { ...pending.deliveryJob, id: canonicalJobId(pending.jobId) };
    const recorded = await sendBackgroundRequest({ type: 'BQA_RECORD_DELIVERED', job: normalizedJob }, '记录沟通结果').catch(error => ({ ok: false, error: error?.message }));
    if (!recorded?.ok) console.warn('[BOSS 智能投递] 沟通已建立，但投递记录同步失败', recorded?.error || '未知错误');
    return { ok: true, synced: Boolean(recorded?.ok), job: recorded?.job || { ...normalizedJob, deliveredAt: Date.now() } };
  }

  function isTitleCandidate(element) {
    if (!(element instanceof HTMLElement) || !visible(element)) return false;
    if (element.closest(`.${BUTTON_CLASS}`)) return false;
    const className = typeof element.className === 'string' ? element.className : '';
    return /(^|\s)job-name(\s|$)/.test(className) || className.includes('job-name');
  }

  function automationBusy() {
    return Boolean(window.__bqaAiFlowRunning || document.querySelector(`.${BATCH_PROGRESS_CLASS}`));
  }

  function removeAutomationButtons() {
    document.querySelectorAll(`.${BUTTON_CLASS}, .${DISMISS_CLASS}, .${COMPANY_DISMISS_CLASS}--inline, .bqa-detail-actions`).forEach(button => button.remove());
  }

  let jobListObserver = null;
  function pauseJobListObserver() {
    jobListObserver?.disconnect();
  }

  function resumeJobListObserver() {
    if (jobListObserver && onJobsPage()) jobListObserver.observe(document.documentElement, { childList: true, subtree: true });
  }

  function addButtons() {
    // 仅处理左侧列表内的职位名，避免给右侧详情标题重复加按钮。
    const cards = jobCards();
    const cardSignature = cards.map(card => jobId(card) || '').join('|');
    if (cardSignature && cardSignature === lastButtonCardSignature
      && cards.every(card => card.querySelector(`.${BUTTON_CLASS}`))) {
      return;
    }
    lastButtonCardSignature = cardSignature;
    if (automationBusy()) {
      removeAutomationButtons();
      return;
    }
    const titles = [...document.querySelectorAll('.job-card-wrapper [class*="job-name"], .job-card-box [class*="job-name"]')]
      .filter(isTitleCandidate);
    for (const title of titles) {
      const container = titleContainer(title);
      if (!container) continue;
      if (!container.querySelector(`.${BUTTON_CLASS}`)) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = BUTTON_CLASS;
        button.textContent = '快速投递';
        button.title = '自动执行：立即沟通 → 留在此页';
        button.addEventListener('click', event => {
          event.preventDefault();
          event.stopPropagation();
          quickApply(button, title);
        });
        container.insertBefore(button, title);
      }
      if (!automationBusy() && !container.querySelector(`.${DISMISS_CLASS}`)) {
        const dismissButton = document.createElement('button');
        dismissButton.type = 'button';
        dismissButton.className = DISMISS_CLASS;
        dismissButton.textContent = '不感兴趣';
        dismissButton.title = '从当前列表隐藏此岗位';
        dismissButton.addEventListener('click', event => {
          event.preventDefault();
          event.stopPropagation();
          dismissJob(dismissButton, title);
        });
        container.insertBefore(dismissButton, title);
      }
    }
    for (const card of cards) {
      if (!card.dataset.bqaSelectionListener) {
        card.dataset.bqaSelectionListener = 'true';
        card.addEventListener('click', event => {
          if (event.target.closest(`.${BUTTON_CLASS}, .${DISMISS_CLASS}, .${COMPANY_DISMISS_CLASS}`)) return;
          requestAnimationFrame(() => markActiveCard(card));
        });
      }
      const company = companyElement(card);
      if (!automationBusy() && company && !company.parentElement?.querySelector(`.${COMPANY_DISMISS_CLASS}--inline`)) {
        const inlineCompanyDismiss = document.createElement('button');
        inlineCompanyDismiss.type = 'button';
        inlineCompanyDismiss.className = `${COMPANY_DISMISS_CLASS} ${COMPANY_DISMISS_CLASS}--inline`;
        inlineCompanyDismiss.textContent = '×';
        inlineCompanyDismiss.title = '屏蔽公司';
        inlineCompanyDismiss.setAttribute('aria-label', '屏蔽公司');
        inlineCompanyDismiss.dataset.tooltip = '屏蔽公司';
        inlineCompanyDismiss.addEventListener('click', event => {
          event.preventDefault();
          event.stopPropagation();
          dismissCompany(inlineCompanyDismiss, card);
        });
        company.insertAdjacentElement('afterend', inlineCompanyDismiss);
      }
    }
    applyListFilters();
  }

  function detailActionHost() {
    const communicate = findCommunicationButton(['继续沟通', '立即沟通', '感兴趣', '立即打招呼']);
    if (!communicate) return null;
    // 尽量挂在 BOSS 动作区，而不是按钮内部的文字节点，避免页面重绘时被一起替换。
    return communicate.closest('[class*="job-btn" i], [class*="job-action" i], [class*="action" i]')
      || communicate.parentElement || null;
  }

  function addDetailButtons() {
    if (automationBusy() || document.querySelector('.bqa-detail-actions')) return;
    const host = detailActionHost();
    const job = readDetailJob();
    if (!host || !job.id) return;
    const actions = document.createElement('span');
    actions.className = 'bqa-detail-actions';
    actions.innerHTML = '<button type="button" class="bqa-quick-apply">快速投递</button><button type="button" class="bqa-not-interested">不感兴趣</button><button type="button" class="bqa-company-dismiss">屏蔽公司</button>';
    const [applyButton, dismissButton, companyButton] = actions.querySelectorAll('button');
    applyButton.title = '加入投递队列，由岗位列表页执行';
    applyButton.addEventListener('click', event => {
      event.preventDefault();
      event.stopPropagation();
      quickApplyDetail(applyButton);
    });
    dismissButton.addEventListener('click', async event => {
      event.preventDefault();
      event.stopPropagation();
      await rememberDismissedJob(readDetailJob());
      actions.remove();
      showNotice('已从插件岗位列表中隐藏该岗位');
    });
    companyButton.addEventListener('click', async event => {
      event.preventDefault();
      event.stopPropagation();
      const current = readDetailJob();
      if (!current.company) {
        showNotice('未能读取公司名称，请刷新详情页后重试', 'error');
        return;
      }
      await rememberHiddenCompany(current.company);
      actions.remove();
      showNotice(`已屏蔽 ${current.company}`);
    });
    host.appendChild(actions);
  }

  function closeModal() { document.querySelector(`.${MODAL_CLASS}`)?.remove(); }

  function restoreDismissButtons() {
    lastButtonCardSignature = '';
    if (onJobsPage()) addButtons();
  }

  function showNotice(message, type = 'success') {
    document.querySelector('.bqa-notice')?.remove();
    const notice = document.createElement('div');
    notice.className = `bqa-notice bqa-notice--${type}`;
    notice.setAttribute('role', 'status');
    notice.textContent = message;
    document.body.appendChild(notice);
    setTimeout(() => notice.remove(), 2600);
  }

  function openHomeAssistant() {
    // 首页入口只打开扩展设置，不在 BOSS 网页上覆盖内容或擅自跳转搜索。
    void showSettings(undefined, { initialTab: 'basic' });
  }

  function modalShell(title, body) {
    closeModal();
    const modal = document.createElement('div');
    modal.className = MODAL_CLASS;
    modal.innerHTML = `<div class="bqa-modal__backdrop"></div><section class="bqa-modal__panel" role="dialog" aria-modal="true" aria-label="${escapeHtml(title || 'BOSS打招呼助手设置')}"><button class="bqa-modal__close" aria-label="关闭">×</button>${title ? `<h2>${escapeHtml(title)}</h2>` : ''}${body}</section>`;
    modal.querySelector('.bqa-modal__close').addEventListener('click', closeModal);
    modal.addEventListener('click', event => {
      const queueLink = event.target.closest('[data-open-delivery-queue]');
      if (!queueLink) return;
      event.preventDefault();
      chrome.runtime.sendMessage({ type: 'BQA_OPEN_SETTINGS', tab: 'contacted' }).then(response => {
        if (!response?.ok) showNotice(`无法打开沟通记录：${response?.error || '请稍后重试'}`, 'error');
      }).catch(() => showNotice('无法打开沟通记录，请稍后重试', 'error'));
    });
    document.body.appendChild(modal);
    return modal;
  }

  function blockedRulesMarkup() {
    const jobs = [...persistedDismissedJobs.values()];
    const companies = [...persistedHiddenCompanies];
    const jobRows = jobs.map(job => `<li><span class="bqa-blocked-rules__type">岗位</span><span>${jobTitleLinkMarkup(job, '已屏蔽岗位')}<small>${escapeHtml(job.company || '公司信息未保存')}</small></span></li>`).join('');
    const companyRows = companies.map(company => `<li><span class="bqa-blocked-rules__type bqa-blocked-rules__type--company">公司</span><span><strong>${escapeHtml(company)}</strong><small>该公司的职位将自动隐藏</small></span></li>`).join('');
    return `<div class="bqa-settings-panel" data-settings-panel="blocked" hidden>
      <section class="bqa-blocked-rules"><h3>屏蔽岗位</h3><ul>${jobRows || '<li class="bqa-blocked-rules__empty">暂时没有屏蔽的岗位</li>'}</ul></section>
      <section class="bqa-blocked-rules"><h3>屏蔽公司</h3><ul>${companyRows || '<li class="bqa-blocked-rules__empty">暂时没有屏蔽的公司</li>'}</ul></section>
    </div>`;
  }

  function jobTitleLinkMarkup(job, fallback) {
    const title = escapeHtml(job.title || fallback);
    let url = '';
    try {
      const candidate = new URL(job.detailUrl || '', location.origin);
      if (candidate.protocol === 'https:' && /(^|\.)zhipin\.com$/i.test(candidate.hostname)) url = candidate.href;
    } catch { /* 历史记录没有详情链接时保持普通文字。 */ }
    return url
      ? `<a class="bqa-job-detail-link" href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer" title="在新标签页查看岗位详情">${title}</a>`
      : `<strong>${title}</strong>`;
  }

  function formatDeliveredAt(timestamp) {
    if (!timestamp) return '时间待记录';
    const value = typeof timestamp === 'number' && timestamp < 100000000000 ? timestamp * 1000 : timestamp;
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '时间待记录';
    const parts = [date.getFullYear(), String(date.getMonth() + 1).padStart(2, '0'), String(date.getDate()).padStart(2, '0')];
    const time = [String(date.getHours()).padStart(2, '0'), String(date.getMinutes()).padStart(2, '0')];
    return `${parts.join('-')} ${time.join(':')}`;
  }

  function deliveredJobsMarkup() {
    const jobs = [...persistedDeliveredJobs.values()]
      .map((job, index) => ({ ...job, _storedIndex: index }))
      .sort((left, right) => {
        if (left.deliveredAt && right.deliveredAt) return right.deliveredAt - left.deliveredAt;
        if (left.deliveredAt) return -1;
        if (right.deliveredAt) return 1;
        return right._storedIndex - left._storedIndex;
      });
    const rows = jobs.map(job => `<div class="bqa-contacted-table__row"><span>${escapeHtml(job.company || '历史记录')}</span>${jobTitleLinkMarkup(job, '已沟通岗位')}<span class="bqa-contacted-table__salary" data-salary-font="${escapeHtml(job.salaryFont || '')}">${escapeHtml(job.salary || '—')}</span><time datetime="${escapeHtml(job.deliveredAt || '')}">${escapeHtml(formatDeliveredAt(job.deliveredAt))}</time></div>`).join('');
    return `<div class="bqa-settings-panel" data-settings-panel="contacted" hidden>
      <section class="bqa-contacted-table"><div class="bqa-contacted-table__head"><span>公司</span><span>岗位名称</span><span>薪资</span><span>沟通时间</span></div>${rows || '<p class="bqa-blocked-rules__empty">暂时没有自动沟通的岗位</p>'}</section>
    </div>`;
  }

  function helpMarkup() {
    return `<div class="bqa-settings-panel" data-settings-panel="help" hidden>
      <section class="bqa-settings-help" aria-label="帮助信息">
        <h3>帮助与反馈</h3>
        <p>可在基础配置中调整岗位筛选提示词、AI 招呼语开关和手动搜索方案。</p>
      </section>
    </div>`;
  }

  async function showSettings(_afterSave, { initialTab = 'basic' } = {}) {
    const response = await chrome.runtime.sendMessage({ type: 'BQA_OPEN_SETTINGS', tab: initialTab }).catch(() => null);
    if (!response?.ok) showNotice(`无法打开设置：${response?.error || '请稍后重试'}`, 'error');
  }
  async function applyReviewBlock(job, action) {
    if (action === 'company' && job.company) {
      await rememberHiddenCompany(job.company);
    } else {
      await rememberDismissedJob(job);
    }
    const card = jobCards().find(item => jobId(item) === job.id);
    card?.classList.add('bqa-dismissed-card', 'bqa-hidden-card');
    applyListFilters();
  }

  function bindReviewActions(container, jobs, onRemoved) {
    container.querySelectorAll('[data-review-action]:not([data-review-action="force-deliver"])').forEach(button => button.addEventListener('click', async event => {
      event.preventDefault();
      event.stopPropagation();
      const job = jobs.find(item => item.id === button.dataset.reviewJobId);
      if (!job || button.disabled) return;
      button.disabled = true;
      try {
        await applyReviewBlock(job, button.dataset.reviewAction);
        onRemoved(job, button.dataset.reviewAction);
      } catch (error) {
        console.warn('[BOSS 求职加速器] 更新候选岗位屏蔽规则失败', error);
        button.disabled = false;
      }
    }));
  }

  function applyReviewSalaryFonts(container) {
    if (!container?.querySelectorAll) return;
    container.querySelectorAll('[data-salary-font]').forEach(element => {
      const fontFamily = element.dataset.salaryFont?.trim();
      if (fontFamily) element.style.fontFamily = fontFamily;
    });
  }

  function reviewRowsMarkup(jobs, delivered, { disabled = false, showSelection = true } = {}) {
    return (Array.isArray(jobs) ? jobs : []).map(job => {
      const id = String(job?.id || '');
      if (!id) return '';
      const isMatched = Boolean(job.match);
      const isDelivered = Boolean(delivered?.has(job.id) || delivered?.has(id));
      const rowClasses = [
        'bqa-review-row',
        showSelection ? '' : 'bqa-review-row--no-selection',
        !isMatched || isDelivered ? 'is-muted' : '',
      ].filter(Boolean).join(' ');
      const selection = showSelection
        ? `<input type="checkbox" value="${escapeHtml(id)}" aria-label="选择${escapeHtml(job.title || '岗位')}" ${isMatched && !isDelivered ? 'checked' : ''} ${disabled || !isMatched || isDelivered ? 'disabled' : ''}>`
        : '';
      const profileNames = Array.isArray(job.matchedProfiles)
        ? job.matchedProfiles.map(profile => typeof profile === 'string' ? profile : profile?.name).filter(Boolean).join('、')
        : '';
      const profileLabel = job.bestProfile?.name || profileNames;
      const titleDetails = [job.company, profileLabel].filter(Boolean).map(escapeHtml).join(' · ');
      const deliveredBadge = isDelivered ? '<span class="bqa-review-row__delivered">已投递</span>' : '';
      const actions = showSelection ? '' : `<div class="bqa-review-row__actions">
        <button type="button" data-review-action="force-deliver" data-review-job-id="${escapeHtml(id)}" ${isDelivered ? 'disabled' : ''}>快速投递</button>
        <button type="button" data-review-action="company" data-review-job-id="${escapeHtml(id)}" ${job.company ? '' : 'disabled'}>屏蔽公司</button>
        <button type="button" data-review-action="job" data-review-job-id="${escapeHtml(id)}">不感兴趣</button>
      </div>`;
      return `<div class="${rowClasses}" data-review-row-job-id="${escapeHtml(id)}">
        ${selection}<span class="bqa-review-row__mark">${isMatched ? '匹配' : '排除'}</span>
        <span class="bqa-review-row__title">${jobTitleLinkMarkup(job, '岗位名称待确认')}${deliveredBadge}${titleDetails ? `<small>${titleDetails}</small>` : ''}${job.reason ? `<small class="bqa-review-row__reason">${escapeHtml(job.reason)}</small>` : ''}</span>
        <span class="bqa-review-row__salary" data-salary-font="${escapeHtml(job.salaryFont || '')}">${escapeHtml(job.salary || '薪资待确认')}</span>
        ${actions}
      </div>`;
    }).join('');
  }

  function showReview(jobs, delivered, eligibleCount = jobs.length) {
    const state = { jobs: [...jobs] };
    const modal = modalShell('这些岗位值得联系', `
      <p class="bqa-modal__intro" data-review-summary></p>
      <div class="bqa-review-list" data-review-list></div>
      <div class="bqa-modal__actions"><button class="bqa-button bqa-button--quiet" data-close>返回列表</button><button class="bqa-button bqa-button--primary" data-deliver>确认投递 <span>0</span> 个</button></div>`);
    modal.querySelector('[data-close]').addEventListener('click', closeModal);
    const summary = modal.querySelector('[data-review-summary]');
    const list = modal.querySelector('[data-review-list]');
    const deliver = modal.querySelector('[data-deliver]');
    const render = () => {
      const selected = state.jobs.filter(job => job.match && !delivered.has(job.id));
      summary.innerHTML = `本轮已读取 <strong>${eligibleCount}</strong> 个岗位，筛出 <strong>${selected.length}</strong> 个值得联系的岗位（今日还可以投递 ${remainingDailyDeliveryQuota()} 个${deliveryQueueLinkMarkup()}）。`;
      list.innerHTML = reviewRowsMarkup(state.jobs, delivered) || '<p class="bqa-empty">当前列表没有可筛选的岗位。</p>';
      applyReviewSalaryFonts(list);
      deliver.disabled = !selected.length;
      deliver.querySelector('span').textContent = selected.length;
      list.querySelectorAll('input[type="checkbox"]').forEach(input => input.addEventListener('change', () => {
        deliver.querySelector('span').textContent = list.querySelectorAll('input:checked').length;
      }));
      bindReviewActions(list, state.jobs, (job, action) => {
        state.jobs = state.jobs.filter(item => action === 'company' ? item.company !== job.company : item.id !== job.id);
        render();
      });
    };
    render();
    deliver.addEventListener('click', async () => {
      const ids = [...list.querySelectorAll('input:checked')].map(input => input.value);
      prepareBatchReview(modal, ids);
      await startBatchDelivery(ids, state.jobs, delivered);
    });
  }

  function createLiveReview(delivered, settings, batchId = '') {
    const state = { cancelled: false, finished: false, autoDeliver: settings.deliveryMode !== 'confirm', autoAttemptedIds: new Set(), autoPendingIds: new Set(), autoDeliveredIds: new Set(), deliveryStatuses: new Map(), deliveryErrors: new Map(), manualQueuedIds: new Set(), manualQueueErrors: new Map(), manualRestoredJobs: new Map(), initiallyDeliveredIds: new Set(delivered), todayDeliveredAtStart: todayDeliveryCount(), jobs: [], eligible: 0, screened: 0, matched: 0, excluded: 0, pageNew: 0, pageRepeated: 0, logs: [], errors: [], removedIds: new Set(), removedCompanies: new Set(), manuallyDeselectedIds: new Set(), autoCompletionTimer: 0, activePanel: 'main' };
    const limitReviewJobs = jobs => {
      const values = Array.isArray(jobs) ? jobs : [];
      return [...values.filter(job => job.match), ...values.filter(job => !job.match).slice(-MAX_LIVE_EXCLUDED_JOBS)];
    };
    const applyManualRestores = jobs => (Array.isArray(jobs) ? jobs : []).map(job => {
      const restored = state.manualRestoredJobs.get(String(job.id));
      return restored ? { ...job, ...restored } : job;
    });
    const modal = modalShell('岗位识别中', `
      <p class="bqa-modal__intro" data-live-summary><span class="bqa-progress-tag is-running">识别中</span>正在识别当前列表中的可投递岗位…</p>
      <p class="bqa-live-delivery-summary" data-auto-delivered-count><span class="bqa-progress-tag is-waiting">待手动启动</span>已投递 0 个，排队中 0 个，处理中 0 个，今日还可以投递 0 个</p>
      <div class="bqa-live-tools"><strong>识别详情</strong><button type="button" data-show-excluded>被排除岗位 <span data-excluded-count>0</span></button><button type="button" data-show-errors>错误报告 <span data-error-count>0</span></button></div>
      <section class="bqa-live-log-wrap is-collapsed" aria-label="实时日志"><header><strong>实时日志</strong><span data-live-log-count>0 条</span><button type="button" class="bqa-live-log-toggle" data-live-log-toggle aria-expanded="false">展开⌄</button></header><div class="bqa-live-log" data-live-logs aria-live="polite"><p class="bqa-live-log__empty">等待识别任务开始…</p></div></section>
      <div data-live-main-view><div class="bqa-review-list" data-live-list><p class="bqa-empty">正在读取岗位，请稍候…</p></div></div>
      <section class="bqa-live-secondary" data-excluded-panel hidden><header><strong>被排除岗位</strong><button type="button" data-live-back>返回符合条件岗位</button></header><div class="bqa-live-secondary__list" data-excluded-list></div></section>
      <section class="bqa-live-secondary" data-errors-panel hidden><header><strong>错误报告</strong><button type="button" data-live-back>返回符合条件岗位</button></header><div class="bqa-live-secondary__list" data-errors-list></div></section>
      <div class="bqa-modal__actions"><label class="bqa-auto-deliver"><input type="checkbox" data-auto-deliver ${settings.deliveryMode !== 'confirm' ? 'checked' : ''}><span>自动投递，无需确认</span></label><button class="bqa-button bqa-button--quiet" data-live-stop>停止识别</button><button class="bqa-button bqa-button--primary" data-live-deliver disabled>确认投递 <span>0</span> 个</button></div>`);
    modal.classList.add('bqa-live-review');
    const heading = modal.querySelector('h2');
    heading.classList.add('bqa-live-review-title');
    const summary = modal.querySelector('[data-live-summary]');
    const list = modal.querySelector('[data-live-list]');
    const liveLogs = modal.querySelector('[data-live-logs]');
    const liveLogCount = modal.querySelector('[data-live-log-count]');
    const liveLogWrap = modal.querySelector('.bqa-live-log-wrap');
    const liveLogToggle = modal.querySelector('[data-live-log-toggle]');
    const excludedCount = modal.querySelector('[data-excluded-count]');
    const errorCount = modal.querySelector('[data-error-count]');
    const excludedPanel = modal.querySelector('[data-excluded-panel]');
    const errorsPanel = modal.querySelector('[data-errors-panel]');
    const mainPanel = modal.querySelector('[data-live-main-view]');
    const excludedList = modal.querySelector('[data-excluded-list]');
    const errorsList = modal.querySelector('[data-errors-list]');
    const stop = modal.querySelector('[data-live-stop]');
    if (batchId) stop.textContent = '停止全部城市';
    const deliver = modal.querySelector('[data-live-deliver]');
    const autoDeliver = modal.querySelector('[data-auto-deliver]');
    const progressTag = (text, tone) => `<span class="bqa-progress-tag ${tone ? `is-${tone}` : ''}">${text}</span>`;
    const safeLogText = value => String(value || '').replace(settings.apiKey || '\u0000', '[已隐藏 API Key]')
      .replace(/sk-[A-Za-z0-9_-]{12,}/g, '[已隐藏密钥]');
    const renderLiveLog = () => {
      if (!liveLogs) return;
      const shouldFollow = liveLogs.scrollHeight - liveLogs.scrollTop - liveLogs.clientHeight < 36;
      liveLogs.innerHTML = state.logs.length
        ? state.logs.map(item => `<div class="bqa-live-log__row is-${item.level}"><time>${escapeHtml(item.time)}</time><span>${escapeHtml(item.message)}</span></div>`).join('')
        : '<p class="bqa-live-log__empty">等待识别任务开始…</p>';
      liveLogCount.textContent = `${state.logs.length} 条`;
      if (shouldFollow) liveLogs.scrollTop = liveLogs.scrollHeight;
    };
    liveLogToggle.addEventListener('click', () => {
      const expanded = liveLogToggle.getAttribute('aria-expanded') !== 'true';
      liveLogToggle.setAttribute('aria-expanded', String(expanded));
      liveLogWrap.classList.toggle('is-collapsed', !expanded);
      liveLogToggle.textContent = expanded ? '收起⌃' : '展开⌄';
      if (expanded) renderLiveLog();
    });
    const appendLiveLog = (message, level = 'info') => {
      const item = { time: new Date().toLocaleTimeString('zh-CN', { hour12: false }), level, message: safeLogText(message) };
      state.logs.push(item);
      if (state.logs.length > 120) state.logs.splice(0, state.logs.length - 120);
      if (level === 'error') {
        state.errors.push(item);
        if (state.errors.length > 300) state.errors.shift();
      }
      renderLiveLog();
      if (errorCount) errorCount.textContent = String(state.errors.length);
      if (errorsList && !errorsPanel.hidden) renderLivePanels();
    };
    const showLivePanel = panel => {
      state.activePanel = panel;
      mainPanel.hidden = panel !== 'main';
      excludedPanel.hidden = panel !== 'excluded';
      errorsPanel.hidden = panel !== 'errors';
      renderLivePanels();
    };
    const renderLivePanels = () => {
      const excludedJobs = state.jobs.filter(job => !job.match);
      excludedCount.textContent = String(state.excluded || excludedJobs.length);
      if (state.activePanel === 'excluded') {
        excludedList.innerHTML = excludedJobs.length ? excludedJobs.map(job => `
          <article class="bqa-live-secondary__row"><div><strong>${jobTitleLinkMarkup(job, '岗位名称待确认')}</strong><small>${escapeHtml(job.company || '公司信息待确认')}　${escapeHtml(job.salary || '薪资待确认')}</small><span>${escapeHtml(job.reason || 'AI 判断为不匹配')}</span></div><div class="bqa-live-secondary__actions"><b>已排除</b><button type="button" data-excluded-deliver="${escapeHtml(job.id)}" ${state.manualQueuedIds.has(String(job.id)) || delivered.has(job.id) || dailyDeliveryLimitReached() ? 'disabled' : ''}>${state.manualQueuedIds.has(String(job.id)) ? '已加入队列' : delivered.has(job.id) ? '已投递' : dailyDeliveryLimitReached() ? '今日额度已满' : state.manualQueueErrors.has(String(job.id)) ? '重试恢复并投递' : '恢复并投递'}</button></div></article>`).join('') : '<p class="bqa-empty">当前还没有被排除的岗位。</p>';
        excludedList.querySelectorAll('[data-excluded-deliver]').forEach(button => button.addEventListener('click', async event => {
          event.preventDefault();
          event.stopPropagation();
          const jobIdValue = button.dataset.excludedDeliver;
          const job = excludedJobs.find(item => String(item.id) === jobIdValue);
          if (!job || button.disabled) return;
          if (dailyDeliveryLimitReached()) {
            showNotice('今日投递额度已满，无法加入队列。', 'error');
            return;
          }
          if (delivered.has(job.id) || state.manualQueuedIds.has(jobIdValue)) return;
          button.disabled = true;
          button.textContent = '恢复并加入中…';
          const restoredJob = { ...job, match: true, manualOverride: true, reason: '用户手动恢复（AI 曾判定不匹配）' };
          state.manualRestoredJobs.set(jobIdValue, restoredJob);
          state.jobs = applyManualRestores(state.jobs);
          // 保存本次人工纠正，后续同一份简历和提示词的识别可复用，不会立刻再次被 AI 排除。
          await saveScreeningRecords([restoredJob], settings.screeningVersion).catch(error => {
            appendLiveLog(`人工恢复结果未能保存：${error?.message || '本地记录写入失败'}`, 'error');
          });
          state.autoAttemptedIds.add(job.id);
          state.autoPendingIds.add(job.id);
          state.deliveryStatuses.set(jobIdValue, '排队中');
          appendLiveLog(`手动恢复 AI 排除岗位并加入投递队列：${job.title || job.id}`);
          renderDeliveryCounter();
          render();
          try {
            const queued = await startBatchDelivery([job.id], [job], { silentCompletion: true, completionNotice: false });
            if (queued?.ok === false) throw new Error(queued.error || '未能加入投递队列');
            if (!queued) throw new Error('未能加入投递队列');
            state.manualQueuedIds.add(jobIdValue);
            state.manualQueueErrors.delete(jobIdValue);
          } catch (error) {
            state.autoPendingIds.delete(job.id);
            state.deliveryStatuses.set(jobIdValue, '投递失败');
            state.deliveryErrors.set(jobIdValue, error?.message || '加入投递队列失败');
            state.manualQueueErrors.set(jobIdValue, error?.message || '加入投递队列失败');
            appendLiveLog(`手动加入被排除岗位失败：${job.title || job.id}；${error?.message || '加入投递队列失败'}`, 'error');
            await updateDeliveryRecord(job, '投递失败', { error: error?.message || '加入投递队列失败' }).catch(() => {});
          }
          renderDeliveryCounter();
          renderLivePanels();
        }));
      }
      if (state.activePanel === 'errors') {
        errorsList.innerHTML = state.errors.length ? [...state.errors].reverse().map(item => `
          <article class="bqa-live-secondary__row bqa-live-secondary__row--error"><div><strong>${escapeHtml(item.time)}　识别错误</strong><span>${escapeHtml(item.message)}</span></div></article>`).join('') : '<p class="bqa-empty">本轮识别没有记录到错误。</p>';
      }
      errorCount.textContent = String(state.errors.length);
    };
    modal.querySelector('[data-show-excluded]').addEventListener('click', () => showLivePanel(state.activePanel === 'excluded' ? 'main' : 'excluded'));
    modal.querySelector('[data-show-errors]').addEventListener('click', () => showLivePanel(state.activePanel === 'errors' ? 'main' : 'errors'));
    modal.querySelectorAll('[data-live-back]').forEach(button => button.addEventListener('click', () => showLivePanel('main')));
    appendLiveLog('识别任务已启动');
    const recognitionStatus = () => {
      if (!state.finished) return ['识别中', 'running'];
      if (state.partialError) return ['识别异常结束', 'error'];
      if (state.cancelled) return ['识别已停止', 'stopped'];
      return ['识别完成', 'done'];
    };
    const deliveryStatus = () => {
      if (state.limitReached) return ['已达上限', 'error'];
      // 重试失败岗位时仍会复用同一投递队列。队列里已有任务应优先显示执行中，
      // 不能因为当前未开启新的自动识别而误显示为“待手动启动”。
      if (state.autoPendingIds.size) return ['投递中', 'running'];
      if (autoProcessingCount()) return ['投递中', 'running'];
      if (!state.autoDeliver) return ['待手动启动', 'waiting'];
      const statuses = [...state.autoAttemptedIds].map(id => state.deliveryStatuses.get(String(id)) || '');
      const hasFailure = statuses.some(value => /失败|停止|额度已满/.test(value))
        || [...state.autoAttemptedIds].some(id => state.deliveryErrors.has(String(id)));
      if (hasFailure) return ['投递失败', 'error'];
      if (state.autoDeliveredIds.size) return ['投递完成', 'done'];
      return state.finished ? ['无可投递岗位', 'waiting'] : ['投递中', 'running'];
    };
    const renderAutoCompletion = (failed) => {
      const expectedAutoDeliveryIds = new Set(visibleJobs()
        .filter(job => job.match && !state.initiallyDeliveredIds.has(job.id))
        .map(job => String(job.id)));
      if (!state.finished || !state.autoDeliver || state.autoPendingIds.size || !expectedAutoDeliveryIds.size || state.autoCompletionShown) return;
      // 识别结束可能早于最后一个匹配岗位完成入队。只有每个待投递岗位都已进入
      // 自动投递链路后，才切换到最终结果，避免提前隐藏列表和二维码被后续状态覆盖。
      if ([...expectedAutoDeliveryIds].some(id => !state.autoAttemptedIds.has(id) && !state.autoAttemptedIds.has(Number(id)))) return;
      state.autoCompletionShown = true;
      const succeeded = state.autoDeliveredIds.size;
      const result = `<div class="bqa-batch-result"><span>投递成功 <strong>${succeeded}</strong> 个</span><i></i><span>投递失败 <strong>${failed.size}</strong> 个</span></div>`;
      heading.textContent = '本轮投递已完成';
      summary.innerHTML = result;
      modal.querySelector('[data-auto-delivered-count]')?.remove();
      modal.querySelector('.bqa-auto-deliver')?.remove();
      deliver.remove();
      stop.textContent = '完成';
      stop.disabled = false;
      stop.onclick = () => closeModal();
      syncAutoRetryButton();
    };
    const waitForAutoCompletion = (attempt = 0) => {
      if (!state.finished || !state.autoDeliver || state.autoCompletionShown || !state.autoAttemptedIds.size) return;
      renderDeliveryCounter();
      if (state.autoCompletionShown || attempt >= 20) return;
      clearTimeout(state.autoCompletionTimer);
      state.autoCompletionTimer = setTimeout(() => waitForAutoCompletion(attempt + 1), 500);
    };
    const renderDeliveryCounter = () => {
      const counter = modal.querySelector('[data-auto-delivered-count]');
      // 投递结果写入 deliveredJobs 与投递记录是异步的，不能只依赖弹窗内存中的
      // autoPendingIds。以岗位 ID 对全局已投递记录做最终校正，避免列表已经显示
      // “已投递”但汇总仍残留排队数量的竞态。
      const attempted = new Set([...state.autoAttemptedIds].map(id => String(id)));
      const deliveredIds = new Set([...persistedDeliveredJobs.keys()].filter(Boolean).map(id => String(id)));
      const completed = new Set([...state.autoDeliveredIds].map(id => String(id)).filter(id => attempted.has(id)));
      attempted.forEach(id => {
        const statusValue = state.deliveryStatuses.get(id) || state.deliveryStatuses.get(Number(id)) || '';
        if (deliveredIds.has(id) || statusValue === '已投递') completed.add(id);
      });
      const failed = new Set([...attempted].filter(id => {
        const status = state.deliveryStatuses.get(id) || '';
        return /失败|停止|额度已满/.test(status) || state.deliveryErrors.has(id);
      }));
      const pending = new Set([...state.autoPendingIds].map(id => String(id)).filter(id => !completed.has(id) && !failed.has(id)));
      const processing = autoProcessingCount();
      state.autoDeliveredIds = completed;
      state.autoPendingIds = pending;
      const [label, tone] = deliveryStatus();
      if (counter) {
        const failures = [...failed].map(id => ({
          job: state.jobs.find(item => String(item.id) === id),
          status: state.deliveryStatuses.get(id) || '',
          error: state.deliveryErrors.get(id) || '',
        }));
        const failureHint = failures.length
          ? `<small class="bqa-live-delivery-error" title="${escapeHtml(failures.map(item => `${item.job?.title || '岗位'}：${item.error || item.status}`).join('\n'))}">失败原因：${escapeHtml(failures.slice(0, 2).map(item => `${item.job?.title || '岗位'}：${item.error || item.status}`).join('；'))}${failures.length > 2 ? ` 等 ${failures.length} 个岗位` : ''}</small>`
          : '';
        counter.innerHTML = `${progressTag(label, tone)}已投递 ${completed.size} 个，排队中 ${pending.size} 个，处理中 ${processing} 个，失败 ${failed.size} 个，今日还可以投递 <strong>${remainingDailyDeliveryQuota()}</strong> 个${deliveryQueueLinkMarkup()}${failureHint}`;
      }
      renderAutoCompletion(failed);
    };
    autoDeliver.addEventListener('change', async () => {
      state.autoDeliver = autoDeliver.checked;
      const saved = await saveSettings({ ...settings, deliveryMode: state.autoDeliver ? 'auto' : 'confirm' });
      if (!saved) showNotice('投递方式保存失败，请稍后重试', 'error');
      else settings.deliveryMode = state.autoDeliver ? 'auto' : 'confirm';
      render();
    });
    const stopRecognition = () => {
      // 即使当前城市已经识别完成，也要取消后台等待中的下一城市任务。
      if (batchId) void chrome.runtime.sendMessage({ type: 'BQA_AUTO_SEARCH_BATCH_ABORT', batchId }).catch(() => {});
      if (state.finished) return;
      state.cancelled = true;
      appendLiveLog('用户停止了本轮识别', 'warn');
      stop.disabled = true;
      stop.textContent = '已停止';
      // 不等待 AI 请求或页面读取结束；立刻把已经识别出的岗位交还给用户操作。
      review.finishAfterCancel();
    };
    modal.querySelector('.bqa-modal__close').addEventListener('click', () => {
      stopRecognition();
      modal.remove();
    });
    stop.addEventListener('click', stopRecognition);
    const visibleJobs = () => state.jobs.filter(job => !state.removedIds.has(job.id) && !state.removedCompanies.has(job.company));
    // “排队中”只表示任务已经写入后台投递队列。已被 AI 匹配但仍在读取详情、
    // 生成投递数据的岗位单列为“处理中”，避免汇总数量看起来无故减少。
    function autoProcessingCount() {
      if (!state.autoDeliver) return 0;
      return visibleJobs().filter(job => job.match
        && !state.initiallyDeliveredIds.has(job.id)
        && !state.autoAttemptedIds.has(job.id)
        && !state.autoAttemptedIds.has(String(job.id))
        && !state.autoDeliveredIds.has(job.id)
        && !state.autoDeliveredIds.has(String(job.id))).length;
    }
    const autoFailedJobs = () => [...state.autoAttemptedIds]
      .map(id => {
        const jobIdValue = String(id);
        const statusValue = state.deliveryStatuses.get(jobIdValue) || '';
        const error = state.deliveryErrors.get(jobIdValue) || '';
        if (!/失败|停止|额度已满/.test(statusValue) && !error) return null;
        const job = state.jobs.find(item => String(item.id) === jobIdValue);
        return job ? { ...job, error: error || statusValue || '投递失败' } : null;
      })
      .filter(Boolean);
    const syncAutoRetryButton = () => {
      const actions = modal.querySelector('.bqa-modal__actions');
      const existing = actions?.querySelector('[data-auto-retry-failed]');
      const failedJobs = autoFailedJobs();
      if (!state.finished || !state.autoDeliver || !failedJobs.length) {
        existing?.remove();
        return;
      }
      if (existing) {
        existing.textContent = `重新投递失败岗位（${failedJobs.length}）`;
        return;
      }
      const retry = document.createElement('button');
      retry.type = 'button';
      retry.className = 'bqa-button bqa-button--primary';
      retry.dataset.autoRetryFailed = 'true';
      retry.textContent = `重新投递失败岗位（${failedJobs.length}）`;
      retry.addEventListener('click', async () => {
        retry.disabled = true;
        try {
          retry.remove();
          modal.querySelector('.bqa-auto-deliver')?.remove();
          await retryFailedBatch(modal, autoFailedJobs());
        } catch (error) {
          retry.disabled = false;
          showNotice(`重新投递失败：${error?.message || '未知错误'}`, 'error');
        }
      });
      actions?.insertBefore(retry, actions.firstChild);
    };
    const beginDelivery = async (ids, { priorSucceeded = 0 } = {}) => {
      if (!modal.isConnected) return;
      if (!ids.length) {
        if (!priorSucceeded) {
          showNotice('请至少选择一个未投递岗位后再确认投递。', 'error');
          return;
        }
        modal.querySelector('.bqa-auto-deliver')?.remove();
        const result = `<div class="bqa-batch-result"><span>投递成功 <strong>${priorSucceeded}</strong> 个</span><i></i><span>投递失败 <strong>0</strong> 个</span></div>`;
        if (summary) summary.innerHTML = `${result}<span>本轮投递已完成。</span>`;
        const completedStop = stop.cloneNode(true);
        completedStop.textContent = '完成';
        completedStop.disabled = false;
        stop.replaceWith(completedStop);
        completedStop.addEventListener('click', closeModal);
        deliver.remove();
        return;
      }
      modal.querySelector('.bqa-auto-deliver')?.remove();
      prepareBatchReview(modal, ids);
      await startBatchDelivery(ids, visibleJobs(), { priorSucceeded });
    };
    const render = () => {
      if (!modal.isConnected) return;
      // 自动投递完成后，异步的 storage 回写不能再把识别列表渲染回最终结果界面。
      if (state.autoCompletionShown) return;
      const allJobs = visibleJobs();
      const candidates = allJobs.filter(job => job.match);
      // 识别统计与投递状态解耦：已投递岗位仍计入本轮 AI 筛出的结果。
      const matchedCount = state.matched || allJobs.filter(job => job.match).length;
      const selected = candidates.filter(job => job.match && !delivered.has(job.id));
      // 识别中只展示岗位和 AI 结果，避免出现灰色、不可操作的复选框。
      // 用户停止识别或识别完成后，且处于手动确认模式时才进入可选择阶段。
      const canSelectJobs = state.finished && !state.autoDeliver;
      list.innerHTML = reviewRowsMarkup(candidates, delivered, { disabled: !canSelectJobs, showSelection: canSelectJobs })
        || `<p class="bqa-empty">${state.finished ? '本轮没有筛出符合条件的岗位。' : '暂未发现符合条件的岗位，正在继续识别…'}</p>`;
      applyReviewSalaryFonts(list);
      renderLivePanels();
      if (state.finished) {
        list.querySelectorAll('input[type="checkbox"]').forEach(input => {
          if (state.manuallyDeselectedIds.has(input.value)) input.checked = false;
        });
      }
      candidates.forEach(job => {
        if (!state.autoAttemptedIds.has(job.id) || delivered.has(job.id)) return;
        const row = [...list.querySelectorAll('.bqa-review-row')].find(item => item.dataset.reviewRowJobId === String(job.id));
        const title = row?.querySelector('.bqa-review-row__title');
        if (!title) return;
        const deliveryState = state.deliveryStatuses.get(String(job.id)) || '已匹配，已加入投递队列';
        const deliveryError = state.deliveryErrors.get(String(job.id)) || '';
        const status = title.querySelector('.bqa-review-row__delivery-status') || document.createElement('small');
        status.className = `bqa-review-row__delivery-status${/失败|停止|额度已满/.test(deliveryState) || deliveryError ? ' is-error' : ''}`;
        status.textContent = deliveryError ? `${deliveryState}：${deliveryError}` : deliveryState;
        status.title = status.textContent;
        if (!status.parentElement) title.appendChild(status);
      });
      const pageText = state.finished ? '' : `。${escapeHtml(state.phase || `正在识别第 ${state.page || 1} 页`)}`;
      const limitText = state.limitReached ? '，今日投递已达上限，自动投递已停止' : '';
      const partialErrorText = state.finished && state.partialError
        ? `<span class="bqa-live-partial-error">后续岗位获取失败，已保留当前结果，可直接确认投递。${escapeHtml(state.partialError)}</span>`
        : '';
      const [recognitionLabel, recognitionTone] = recognitionStatus();
      const hiddenExcluded = Math.max(0, state.excluded - allJobs.filter(job => !job.match).length);
      const previewText = hiddenExcluded ? `，弹窗保留最近 ${MAX_LIVE_EXCLUDED_JOBS} 条排除项，另有 ${hiddenExcluded} 条已保存到设置页` : '';
      summary.innerHTML = `${progressTag(recognitionLabel, recognitionTone)}本轮去重读取 <strong>${state.eligible}</strong> 个，本页新增 <strong>${state.pageNew}</strong> / 重复 <strong>${state.pageRepeated}</strong> 个，已筛选 <strong>${state.screened}</strong> 个，匹配 <strong>${matchedCount}</strong> 个，排除 <strong>${state.excluded}</strong> 个${previewText}${limitText}${pageText}${partialErrorText}`;
      renderDeliveryCounter();
      syncAutoRetryButton();
      deliver.hidden = state.autoDeliver;
      const updateManualDeliverySelection = () => {
        const selectedCount = list.querySelectorAll('input:checked').length;
        deliver.querySelector('span').textContent = selectedCount;
        deliver.disabled = state.limitReached || !selectedCount;
      };
      if (state.finished) {
        updateManualDeliverySelection();
        list.querySelectorAll('input[type="checkbox"]').forEach(input => input.addEventListener('change', () => {
          // Set 没有 toggle 方法：取消勾选时记入手动排除集合，重新勾选则移除。
          if (input.checked) state.manuallyDeselectedIds.delete(input.value);
          else state.manuallyDeselectedIds.add(input.value);
          updateManualDeliverySelection();
        }));
      } else {
        deliver.disabled = true;
        deliver.querySelector('span').textContent = selected.length;
      }
      bindReviewActions(list, candidates, (job, action) => {
        if (action === 'company') state.removedCompanies.add(job.company);
        else state.removedIds.add(job.id);
        render();
      });
      list.querySelectorAll('[data-review-action="force-deliver"]').forEach(button => button.addEventListener('click', async event => {
        event.preventDefault();
        event.stopPropagation();
        const job = candidates.find(item => item.id === button.dataset.reviewJobId);
        if (!job || button.disabled || delivered.has(job.id)) return;
        button.disabled = true;
        state.autoAttemptedIds.add(job.id);
        state.autoPendingIds.add(job.id);
        state.deliveryStatuses.set(String(job.id), '排队中');
        render();
        try {
          const queued = await startBatchDelivery([job.id], [job], { silentCompletion: true, completionNotice: false });
          if (queued?.ok === false) throw new Error(queued.error || '未能加入投递队列');
        } catch (error) {
          state.autoPendingIds.delete(job.id);
          state.deliveryStatuses.set(String(job.id), '投递失败');
          state.deliveryErrors.set(String(job.id), error?.message || '加入投递队列失败');
          appendLiveLog(`手动加入投递队列失败：${job.title || job.id}；${error?.message || '加入投递队列失败'}`, 'error');
          await updateDeliveryRecord(job, '投递失败', { error: error?.message || '加入投递队列失败' }).catch(() => {});
          render();
        }
      }));
    };
    const refreshLiveQuota = () => {
      if (!modal.isConnected) return document.removeEventListener('bqa-delivery-count-changed', refreshLiveQuota);
      render();
    };
    document.addEventListener('bqa-delivery-count-changed', refreshLiveQuota);
    const review = {
      log: appendLiveLog,
      reopen: () => {
        if (modal.isConnected) return false;
        document.body.appendChild(modal);
        return true;
      },
      isCancelled: () => state.cancelled,
      shouldAutoDeliver: () => state.autoDeliver && !state.cancelled && !state.finished,
      shouldStopForDailyLimit: () => state.autoDeliver && !state.cancelled,
      // 实际投递由后台记录驱动；失败岗位在识别结束后提供显式重试入口，避免重复发送。
      markAutoDeliveryStarted: jobIdValue => {
        state.autoAttemptedIds.add(jobIdValue);
        state.autoPendingIds.add(jobIdValue);
        const job = state.jobs.find(item => String(item.id) === String(jobIdValue));
        appendLiveLog(`符合条件岗位已进入投递队列：${job?.title || jobIdValue}`);
        renderDeliveryCounter();
        render();
      },
      markAutoDelivered: jobIdValue => {
        delivered.add(jobIdValue);
        state.autoPendingIds.delete(jobIdValue);
        state.autoDeliveredIds.add(jobIdValue);
        const job = state.jobs.find(item => String(item.id) === String(jobIdValue));
        appendLiveLog(`岗位投递完成：${job?.title || jobIdValue}`);
        renderDeliveryCounter();
        render();
      },
      syncDeliveryRecords: records => {
        state.deliveryStatuses = new Map((Array.isArray(records) ? records : [])
          .filter(record => record?.id && record.deliveryStatus)
          .map(record => [String(record.id), record.deliveryStatus]));
        state.deliveryErrors = new Map((Array.isArray(records) ? records : [])
          .filter(record => record?.id && record.error)
          .map(record => [String(record.id), record.error]));
        // 成功状态由后台投递记录驱动，不依赖入队时那一次异步回调。
        const tracked = new Set([...state.autoPendingIds, ...state.autoDeliveredIds]);
        const succeeded = new Set([...tracked].filter(jobIdValue => state.deliveryStatuses.get(jobIdValue) === '已投递'));
        const stillQueued = new Set([...tracked].filter(jobIdValue => {
          const value = state.deliveryStatuses.get(jobIdValue) || '';
          return value !== '已投递' && !/失败|停止|额度已满/.test(value);
        }));
        state.autoDeliveredIds = succeeded;
        state.autoPendingIds = stillQueued;
        succeeded.forEach(jobIdValue => delivered.add(jobIdValue));
        renderDeliveryCounter();
        render();
      },
      markAutoDeliveryFailed: (jobIdValue, error) => {
        const id = String(jobIdValue);
        state.deliveryStatuses.set(id, '投递失败');
        state.deliveryErrors.set(id, error || '投递任务启动失败');
        state.autoPendingIds.delete(jobIdValue);
        const job = state.jobs.find(item => String(item.id) === id);
        appendLiveLog(`岗位投递失败：${job?.title || id}；${error || '投递任务启动失败'}`, 'error');
        renderDeliveryCounter();
        render();
      },
      finishForDailyLimit: () => {
        state.limitReached = true;
        state.autoDeliver = false;
        review.finish([...state.jobs], state.eligible, { afterCancel: true });
      },
      update: progress => {
        state.eligible = progress.eligible || 0;
        state.screened = Number(progress.screened ?? progress.jobs?.length ?? state.screened);
        state.matched = Number(progress.matched ?? progress.jobs?.filter(job => job.match).length ?? state.matched);
        state.excluded = Number(progress.excluded ?? Math.max(0, state.screened - state.matched));
        state.pageNew = Number(progress.pageNew || 0);
        state.pageRepeated = Number(progress.pageRepeated || 0);
        state.jobs = applyManualRestores(limitReviewJobs(progress.jobs || state.jobs));
        state.page = progress.page;
        state.phase = progress.phase || '';
        render();
      },
      finish: (jobs, eligible, { afterCancel = false, partialError = '' } = {}) => {
        if (!modal.isConnected || state.finished || (state.cancelled && !afterCancel)) return;
        state.finished = true;
        // 用户主动停止后仍保留取消标记，使尚未返回的 AI 请求无法继续后续识别。
        if (!afterCancel) state.cancelled = false;
        state.screened = Math.max(state.screened, Array.isArray(jobs) ? jobs.length : 0);
        state.matched = Math.max(state.matched, (Array.isArray(jobs) ? jobs : []).filter(job => job.match).length);
        state.excluded = Math.max(state.excluded, state.screened - state.matched);
        state.jobs = applyManualRestores(limitReviewJobs(jobs));
        state.eligible = eligible;
        state.partialError = partialError;
        if (partialError && !state.errors.some(item => item.message.includes(safeLogText(partialError)))) {
          appendLiveLog(`识别结束时存在未完成步骤：${partialError}`, 'error');
        }
        appendLiveLog(`识别已结束：符合条件 ${jobs.filter(job => job.match).length} 个，被排除 ${jobs.filter(job => !job.match).length} 个`);
        heading.textContent = '这些岗位值得联系';
        heading.classList.remove('bqa-live-review-title');
        const doneStop = stop.cloneNode(true);
        doneStop.textContent = state.limitReached ? '已达上限' : '停止识别';
        doneStop.disabled = true;
        stop.replaceWith(doneStop);
        stop = doneStop;
        render();
        waitForAutoCompletion();
        deliver.addEventListener('click', async () => {
          const ids = [...list.querySelectorAll('input:checked')].map(input => input.value);
          await beginDelivery(ids);
        });
        // 自动投递只走“单岗位识别完成后立即入队”这一条路径。
        // 识别结束时绝不再统一投递已勾选岗位，避免与即时入队产生重复消息。
      },
      fail: error => {
        const message = error?.message || '岗位识别失败';
        appendLiveLog(`识别流程异常：${message}`, 'error');
        review.finish([...state.jobs], state.eligible, { partialError: message });
      },
    };
    activeLiveReview = review;
    review.finishAfterCancel = () => review.finish([...state.jobs], state.eligible, { afterCancel: true });
    return review;
  }

  function prepareBatchReview(modal, ids) {
    modal.classList.add('bqa-batch-review');
    modal.querySelectorAll('input[type="checkbox"]').forEach(input => { input.disabled = true; });
    modal.querySelectorAll('.bqa-review-row__actions').forEach(actions => actions.remove());
    modal.querySelectorAll('.bqa-review-row').forEach(row => {
      if (!ids.map(String).includes(String(row.dataset.reviewRowJobId || ''))) return;
      const status = document.createElement('span');
      status.className = 'bqa-review-row__status';
      status.textContent = '等待中';
      row.appendChild(status);
    });
    const summary = modal.querySelector('.bqa-modal__intro');
    if (summary) summary.textContent = `已选择 ${ids.length} 个岗位，正在依次投递。`;
    const deliver = modal.querySelector('[data-deliver], [data-live-deliver]');
    if (deliver) deliver.remove();
    const existingStop = modal.querySelector('[data-close], [data-live-stop]');
    if (existingStop) {
      const stop = existingStop.cloneNode(true);
      stop.textContent = '停止投递';
      stop.disabled = false;
      existingStop.replaceWith(stop);
      stop.addEventListener('click', stopBatchDelivery);
    }
  }

  function formatStepElapsed(milliseconds) {
    const seconds = Math.max(0, Math.round((Number(milliseconds) || 0) / 100) / 10);
    return `${seconds % 1 ? seconds.toFixed(1) : seconds.toFixed(0)} 秒`;
  }

  async function startBatchDelivery(ids, jobs, { silentCompletion = false, completionNotice = true, priorSucceeded = 0, controllerTabId = null, queueManaged = false, queueTaskId = '', queueLeaseAt = 0 } = {}) {
    const selected = ids.map(id => jobs.find(job => job.id === id)).filter(Boolean).map(job => {
      // 兼容旧预览数据：即使识别阶段没有完整缓存，也尽量使用当前卡片上的元数据启动投递。
      const card = cardForJob(job);
      const meta = card ? readJob(card) : {};
      return {
        ...job,
        securityId: job.securityId || meta.securityId || '',
        encryptJobId: job.encryptJobId || meta.id || job.id,
        cachedJd: job.cachedJd || job.summary || meta.summary || `${job.title || ''} ${job.company || ''}`.trim(),
      };
    });
    if (!selected.length) return;
    pauseJobListObserver();
    // 单岗位快速投递/队列消费时保留列表上的操作按钮，避免整页按钮消失让用户
    // 误以为岗位列表被清空。正在处理的岗位由按钮自身状态和投递记录展示进度。
    // 看门狗恢复时后台已经确认了目标岗位页；直接复用该 tabId，避免扩展刚重启时
    // 再发一次查询消息因 Service Worker 切换而把可恢复任务误判为失败。
    const tab = controllerTabId
      ? { ok: true, tabId: controllerTabId }
      : await chrome.runtime.sendMessage({ type: 'BQA_GET_CURRENT_TAB' });
    if (!tab?.ok) {
      if (queueManaged) throw new Error(tab?.error || '无法确认当前岗位列表标签页，队列任务未能启动');
      if (silentCompletion) showNotice('快速投递失败：未识别到岗位列表页，请刷新后重试', 'error');
      else modalShell('无法启动投递', '<p class="bqa-modal__intro bqa-modal__error">未识别到当前岗位列表页，请刷新页面后重试。</p>');
      return { ok: false, error: '未识别到当前岗位列表页，请刷新页面后重试' };
    }
    if (!queueManaged) {
      // 必须先展示“已入队”，再让 background 发布 active 任务。
      // 否则岗位页已认领并写入“准备开始投递”后，下面的旧写入会把状态
      // 覆盖回“等待进入投递队列”，造成看起来永远没有消费者的假象。
      await Promise.all(selected.map(job => updateDeliveryRecord(job, '排队中'))).catch(() => {});
      const queued = await sendBackgroundRequest({
        type: 'BQA_ENQUEUE_DELIVERY_TASK',
        task: { ids: selected.map(job => job.id), jobs: selected, options: { silentCompletion, completionNotice, priorSucceeded }, tabId: tab.tabId },
        claimSource: onJobsPage(),
      }, '加入投递队列');
      if (!queued?.ok) throw new Error(queued?.error || '未能加入投递队列');
      // 本次入队若正好成为队首，后台已将任务租约授予当前页面；直接启动，
      // 不等待 storage.onChanged／轮询，避免出现“队列中 N 个但没有消费者”。
      if (queued.task) runQueuedDeliveryTask(queued.task);
      return queued;
    }
    const sessionId = makeBatchSessionId();
    const batch = { jobs: selected, index: 0, active: true, sessionId, controllerTabId: tab.tabId, queueTaskId, queueLeaseAt, dailyDeliveryLimit, stage: '准备开始', stageUpdatedAt: Date.now(), createdAt: Date.now(), silentCompletion, completionNotice, priorSucceeded, stepTimings: [] };
    recordDeliveryDiagnostic({ phase: 'execution', action: 'batch-start', status: 'started', stage: batch.stage, taskId: queueTaskId, sessionId, jobCount: selected.length, index: 0 });
    if (!(await setStored(BATCH_KEY, batch))) {
      throw new Error(lastStorageWriteError || '未能写入当前队列任务的执行状态');
    }
    // 投递记录仅用于展示，写入异常绝不能阻塞已获得队首的实际投递。
    await Promise.all(selected.map(job => updateDeliveryRecord(job, '准备开始投递', { sessionId }))).catch(error => console.warn('[BOSS 智能投递] 更新投递记录失败', error));
    renderBatchProgress(batch);
    await runBatchStep();
  }

  function completeManagedDeliveryTask(batch) {
    if (!batch?.queueTaskId) return Promise.resolve();
    return chrome.runtime.sendMessage({ type: 'BQA_COMPLETE_DELIVERY_TASK', id: batch.queueTaskId, claimedAt: batch.queueLeaseAt })
      .catch(() => null)
      .finally(() => {
        const leaseKey = `${batch.queueTaskId}:${Number(batch.queueLeaseAt || 0)}:${Number(batch.controllerTabId || 0)}`;
        if (startedQueuedTaskLease === leaseKey) startedQueuedTaskLease = '';
      });
  }

  function runQueuedDeliveryTask(task) {
    const leaseKey = deliveryTaskLeaseKey(task);
    if (!task?.id || !task?.jobs?.length || !leaseKey || startedQueuedTaskLease === leaseKey || !onJobsPage()) return;
    startedQueuedTaskLease = leaseKey;
    startBatchDelivery(task.ids || task.jobs.map(job => job.id), task.jobs, {
      // 后台把租约授予当前消费者时会同步更新 claimedTabId/tabId；复用该 ID，
      // 避免再请求后台查询当前标签页失败后任务静默停在“排队中”。
      ...(task.options || {}), controllerTabId: task.claimedTabId || task.tabId || null, queueManaged: true, queueTaskId: task.id, queueLeaseAt: task.claimedAt,
    }).then(result => {
      if (result?.ok === false) throw new Error(result.error || '队列任务未能启动');
    }).catch(error => {
      console.warn('[BOSS 求职加速器] 队列任务启动失败', error);
      // 队列在页面刷新、任务完成交接时可能已切换到下一条任务；这不是岗位投递失败。
      // 释放本页启动标记并让 storage 轮询重新认领当前 active，不能把旧任务误写为失败。
      if (/投递任务已切换|未能写入当前队列任务/.test(String(error?.message || ''))) {
        if (startedQueuedTaskLease === leaseKey) startedQueuedTaskLease = '';
        setTimeout(() => {
          chrome.storage.local.get(DELIVERY_TASK_QUEUE_KEY, data => {
            const active = data[DELIVERY_TASK_QUEUE_KEY]?.active;
            if (active) claimAndRunQueuedDeliveryTask(active);
          });
        }, 250);
        return;
      }
      if (startedQueuedTaskLease === leaseKey) startedQueuedTaskLease = '';
      const failure = `队列任务启动失败：${error.message || '未知错误'}`;
      recordDeliveryDiagnostic({ phase: 'queue', action: 'start-task', status: 'failed', stage: '队列任务启动失败', taskId: task.id, jobCount: task.jobs?.length, failureType: error?.name || 'start-error' });
      void Promise.all((task.jobs || []).map(job => updateDeliveryRecord(job, '投递失败', { error: failure }))).catch(() => {});
      void chrome.runtime.sendMessage({ type: 'BQA_COMPLETE_DELIVERY_TASK', id: task.id, claimedAt: task.claimedAt }).catch(() => {});
    });
  }

  function claimAndRunQueuedDeliveryTask(task) {
    if (!task?.id || !onJobsPage() || startedQueuedTaskLease === deliveryTaskLeaseKey(task)) return;
    chrome.runtime.sendMessage({ type: 'BQA_CLAIM_DELIVERY_TASK', id: task.id }).then(result => {
      if (result?.ok && result.task) runQueuedDeliveryTask(result.task);
    }).catch(error => {
      recordDeliveryDiagnostic({ phase: 'queue', action: 'claim', status: 'failed', stage: '岗位页请求认领队列失败', taskId: task.id, failureType: error?.name || 'claim-error' });
      // 不终止轮询：background 刚从休眠恢复时第一次消息可能丢失，下一次会重试。
      console.warn('[BOSS 求职加速器] 认领投递任务失败，将自动重试', error);
    });
  }

  function renderBatchProgress(batch) {
    document.querySelector(`.${BATCH_PROGRESS_CLASS}`)?.remove();
    const modal = document.querySelector(`.${MODAL_CLASS}.bqa-batch-review`) || (batch?.silentCompletion ? document.querySelector(`.${MODAL_CLASS}`) : null);
    if (!modal || !batch) return;
    const isBatchReview = modal.classList.contains('bqa-batch-review');
    const skipped = new Map((batch.skipped || []).map(job => [job.id, job.error || '投递失败']));
    modal.querySelectorAll('.bqa-review-row').forEach(row => {
      const id = row.querySelector('input')?.value;
      const index = batch.jobs.findIndex(job => job.id === id);
      if (index < 0) return;
      const failure = skipped.get(id);
      const value = failure ? '失败' : index < batch.index ? '已投递' : index === batch.index && batch.active ? batch.stage : batch.stopped ? '已停止' : '等待中';
      if (!isBatchReview) {
        let liveStatus = row.querySelector('.bqa-review-row__delivery-status');
        if (!liveStatus) {
          liveStatus = document.createElement('small');
          liveStatus.className = 'bqa-review-row__delivery-status';
          row.querySelector('.bqa-review-row__title')?.appendChild(liveStatus);
        }
        const latestTiming = batch.lastStepTiming;
        liveStatus.textContent = `${value}${latestTiming ? ` · ${latestTiming.stage} ${formatStepElapsed(latestTiming.elapsed)}` : ''}`;
        liveStatus.classList.toggle('is-error', Boolean(failure));
        return;
      }
      const status = row.querySelector('.bqa-review-row__status');
      if (!status) return;
      status.textContent = value;
      status.className = `bqa-review-row__status ${value === '已投递' ? 'is-done' : value === '失败' ? 'is-error' : ''}`;
      let error = row.querySelector('.bqa-review-row__error');
      if (failure) {
        if (!error) {
          error = document.createElement('small');
          error.className = 'bqa-review-row__error';
          row.querySelector('.bqa-review-row__title')?.appendChild(error);
        }
        error.textContent = failure;
        error.title = failure;
      } else {
        error?.remove();
      }
    });
    const summary = modal.querySelector('.bqa-modal__intro');
    if (isBatchReview && summary) summary.textContent = batch.limitReached
      ? `今日已达 BOSS ${batch.dailyDeliveryLimit || dailyDeliveryLimit} 人沟通上限，本轮投递已停止。`
      : batch.active ? `投递进度 ${Math.min(batch.index + 1, batch.jobs.length)}/${batch.jobs.length} · ${batch.stage}`
        : batch.stage === '投递完成' ? '本轮投递完成。' : '投递已停止。';
    if (isBatchReview) {
      let timings = modal.querySelector('.bqa-batch-timings');
      if ((batch.stepTimings || []).length) {
        if (!timings) {
          timings = document.createElement('div');
          timings.className = 'bqa-batch-timings';
          summary?.insertAdjacentElement('afterend', timings);
        }
        timings.innerHTML = batch.stepTimings.slice(-5).map(item => `<span>${escapeHtml(item.stage)} <b>${formatStepElapsed(item.elapsed)}</b></span>`).join('');
      } else timings?.remove();
    }
  }

  function resetBatchLauncher() {
    const launcher = document.querySelector(`.${LAUNCHER_CLASS}`);
    launcher?.classList.remove('is-running');
    launcher?.removeAttribute('data-progress');
    launcher?.querySelector('.bqa-ai-launcher__label')?.removeAttribute('data-progress');
    renderDailyDeliveryQuota();
    restoreDismissButtons();
    resumeJobListObserver();
  }

  async function stopBatchDelivery() {
    const batch = await getStored(BATCH_KEY);
    if (!batch?.active) { renderBatchProgress(null); resetBatchLauncher(); return; }
    const stoppedBatch = { ...batch, active: false, stopped: true, stage: '已停止投递' };
    await setStored(BATCH_KEY, stoppedBatch);
    await Promise.all((batch.jobs || []).slice(batch.index).map(job => updateDeliveryRecord(job, '已停止投递', { sessionId: batch.sessionId }).catch(() => {})));
    await removeStored(PENDING_CHAT_KEY);
    await completeManagedDeliveryTask(batch);
    renderBatchProgress(stoppedBatch);
    resetBatchLauncher();
  }

  async function stopBatchForDailyLimit(batch, message) {
    const limit = batch.dailyDeliveryLimit || dailyDeliveryLimit;
    const stoppedBatch = { ...batch, active: false, stopped: true, limitReached: true, dailyDeliveryLimit: limit, stage: `今日已达 BOSS ${limit} 人沟通上限` };
    await setStored(BATCH_KEY, stoppedBatch);
    await Promise.all((batch.jobs || []).slice(batch.index).map(job => updateDeliveryRecord(job, '今日额度已满，未投递', { sessionId: batch.sessionId }).catch(() => {})));
    await removeStored(PENDING_CHAT_KEY);
    await completeManagedDeliveryTask(batch);
    renderBatchProgress(stoppedBatch);
    resetBatchLauncher();
    const modal = document.querySelector(`.${MODAL_CLASS}.bqa-batch-review`);
    if (!modal) {
      // 自动识别还在展示时，交由识别流程把原窗口更新为“已达上限”；
      // 不创建新弹窗覆盖用户已看到的候选岗位。
      if (document.querySelector(`.${MODAL_CLASS}`)) return;
      if (batch.silentCompletion) return;
      modalShell('今日投递已达上限', `<p class="bqa-modal__intro bqa-modal__error">今日已达到 BOSS 直聘 ${limit} 人沟通上限，本轮投递已停止。${escapeHtml(message || '')}</p>`);
      return;
    }
    const summary = modal.querySelector('.bqa-modal__intro');
    if (summary) summary.innerHTML = `<strong>今日已达 BOSS ${limit} 人沟通上限</strong><span>本轮投递已停止，未发送的岗位不会计入已投递，可在明天重新尝试。</span>`;
    const stop = modal.querySelector('[data-close], [data-live-stop]');
    if (stop) {
      const close = stop.cloneNode(true);
      close.textContent = '完成';
      close.disabled = false;
      stop.replaceWith(close);
      close.addEventListener('click', closeModal);
    }
  }

  async function stopBatchDeliveryForReachedQuota() {
    const batch = await getStored(BATCH_KEY);
    if (!batch?.active) return;
    const tab = await chrome.runtime.sendMessage({ type: 'BQA_GET_CURRENT_TAB' }).catch(() => null);
    // 存储变化会广播到所有打开的 BOSS 页面，只有发起批次的列表页有权结束它。
    if (batch.controllerTabId && tab?.tabId !== batch.controllerTabId) return;
    await stopBatchForDailyLimit(batch);
  }

  async function retryFailedBatch(modal, failedJobs) {
    const retryIds = failedJobs.map(job => String(job.id || '')).filter(Boolean);
    if (!retryIds.length) return;
    // 清理上一轮的状态和错误，再把失败岗位恢复为可投递的勾选状态。
    modal.querySelectorAll('.bqa-review-row__status, .bqa-review-row__error').forEach(element => element.remove());
    modal.querySelectorAll('.bqa-review-row input[type="checkbox"]').forEach(input => {
      input.checked = retryIds.includes(String(input.value));
      input.disabled = false;
    });
    modal.querySelector('[data-retry-failed]')?.remove();
    prepareBatchReview(modal, retryIds);
    await startBatchDelivery(retryIds, failedJobs);
  }

  async function updateBatchStage(batch, stage, attempt = 0) {
    const latest = await getStored(BATCH_KEY);
    if (!latest?.active || latest.sessionId !== batch.sessionId) {
      const stopped = new Error('投递已停止');
      stopped.code = 'BQA_BATCH_STOPPED';
      throw stopped;
    }
    Object.assign(batch, latest);
    batch.stage = attempt > 1 ? `${stage}（重试 ${attempt - 1}/2）` : stage;
    batch.stageUpdatedAt = Date.now();
    await setStored(BATCH_KEY, batch);
    recordDeliveryDiagnostic({
      phase: 'execution', action: 'stage', status: 'active', stage: batch.stage, taskId: batch.queueTaskId,
      sessionId: batch.sessionId, jobId: canonicalJobId(batch.jobs?.[batch.index]?.id),
      jobCount: batch.jobs?.length, index: batch.index, attempt,
    });
    void updateDeliveryRecord(batch.jobs?.[batch.index], batch.stage, { sessionId: batch.sessionId }).catch(error => console.warn('[BOSS 智能投递] 更新投递记录失败', error));
    renderBatchProgress(batch);
  }

  async function waitForBatchDelay(batch, milliseconds, stage) {
    await updateBatchStage(batch, stage);
    const deadline = Date.now() + milliseconds;
    while (Date.now() < deadline) {
      await sleep(Math.min(500, deadline - Date.now()));
      const latest = await getStored(BATCH_KEY);
      if (!latest?.active || latest.sessionId !== batch.sessionId) {
        const stopped = new Error('投递已停止');
        stopped.code = 'BQA_BATCH_STOPPED';
        throw stopped;
      }
      Object.assign(batch, latest);
    }
  }

  async function retryBatchStep(batch, stage, operation, maxAttempts = 3) {
    let lastError;
    const startedAt = Date.now();
    for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {
      await updateBatchStage(batch, stage, attempt);
      try {
        const result = await operation();
        const timing = { stage, elapsed: Date.now() - startedAt };
        batch.stepTimings = [...(batch.stepTimings || []).slice(-4), timing];
        batch.lastStepTiming = timing;
        await setStored(BATCH_KEY, batch);
        renderBatchProgress(batch);
        return result;
      } catch (error) {
        lastError = error;
        if (attempt < maxAttempts) await sleep(700 * attempt);
      }
    }
    const timing = { stage, elapsed: Date.now() - startedAt };
    batch.stepTimings = [...(batch.stepTimings || []).slice(-4), timing];
    batch.lastStepTiming = timing;
    await setStored(BATCH_KEY, batch);
    renderBatchProgress(batch);
    throw new Error(`${stage}失败（已重试 ${maxAttempts} 次）：${lastError?.message || '未知错误'}`);
  }

  async function runBatchStep() {
    if (!onJobsPage()) return;
    const batch = await getStored(BATCH_KEY);
    if (!batch?.active) return;
    const currentTab = await chrome.runtime.sendMessage({ type: 'BQA_GET_CURRENT_TAB' }).catch(() => null);
    if (!currentTab?.ok || !currentTab.tabId) {
      // 临时后台消息失败不能直接结束步骤：否则 active 批次仍挂在队列里，
      // 而内容页的租约启动标记又会挡住同一任务再次启动。
      if (!batchTabLookupRetryTimer) {
        batchTabLookupRetryTimer = setTimeout(() => {
          batchTabLookupRetryTimer = 0;
          void runBatchStep().catch(error => console.warn('[BOSS 求职加速器] 恢复投递步骤失败', error));
        }, 700);
      }
      return;
    }
    if (batchTabLookupRetryTimer) {
      clearTimeout(batchTabLookupRetryTimer);
      batchTabLookupRetryTimer = 0;
    }
    // 存储状态会同步到所有 BOSS 页面；只有队列拥有者所在的页面能真正执行本批投递。
    if (batch.controllerTabId && currentTab?.tabId !== batch.controllerTabId) return;
    if (batch.waitingForChat) return;
    const currentSettings = await getSettings();
    const nextUsesBossGreeting = usesBossNativeGreeting(currentSettings);
    const nextUsesPluginGreeting = pluginGreetingEnabled(currentSettings);
    if (batch.aiGreetingEnabled !== nextUsesPluginGreeting || batch.useBossNativeGreeting !== nextUsesBossGreeting) {
      // 每个岗位开始时读取开关；切换后从下一岗位生效，当前已开始的岗位保持原流程。
      batch.aiGreetingEnabled = nextUsesPluginGreeting;
      batch.useBossNativeGreeting = nextUsesBossGreeting;
      await setStored(BATCH_KEY, batch);
    }
    setDailyDeliveryLimit(currentSettings.dailyDeliveryLimit);
    // 无论是自动还是手动发起的批次，额度耗尽后都不再读取 JD、生成话术或发送下一岗位。
    if (dailyDeliveryLimitReached()) {
      await stopBatchForDailyLimit(batch);
      return;
    }
    const launcher = document.querySelector(`.${LAUNCHER_CLASS}`);
    launcher?.classList.add('is-running');
    launcher?.removeAttribute('data-progress');
    launcher?.querySelector('.bqa-ai-launcher__label')?.removeAttribute('data-progress');
    renderDailyDeliveryQuota();
    renderBatchProgress(batch);
    if (batch.index >= batch.jobs.length) {
      renderBatchProgress({ ...batch, active: false, stage: '投递完成' });
      await removeStored(BATCH_KEY);
      await completeManagedDeliveryTask(batch);
      resetBatchLauncher();
      const skipped = batch.skipped || [];
      const succeeded = Math.max(0, batch.jobs.length - skipped.length) + Number(batch.priorSucceeded || 0);
      const successLabel = batch.useBossNativeGreeting === true ? 'BOSS 沟通已建立' : batch.aiGreetingEnabled === false ? '已建立沟通' : '投递成功';
      const result = `<div class="bqa-batch-result"><span>${successLabel} <strong>${succeeded}</strong> 个</span><i></i><span>未完成 <strong>${skipped.length}</strong> 个</span></div>`;
      if (batch.silentCompletion) {
        if (batch.completionNotice !== false) {
          showNotice(skipped.length
            ? `快速投递未完成：成功 ${succeeded} 个，失败 ${skipped.length} 个`
            : batch.useBossNativeGreeting === true
              ? `已通过 BOSS 页面建立 ${succeeded} 个沟通；招呼语由 BOSS 自动招呼设置决定`
              : batch.aiGreetingEnabled === false ? `已建立 ${succeeded} 个 BOSS 沟通（未发送插件招呼）` : '快速投递成功，已发送 AI 专属话术', skipped.length ? 'error' : 'success');
        }
        return;
      }
      const reviewModal = document.querySelector(`.${MODAL_CLASS}.bqa-batch-review`);
      if (reviewModal) {
        // 投递完成后，岗位标题旁的灰色“已投递”标签是唯一状态来源；
        // 清理投递过程产生的青色进度状态，避免重复展示。
        const reviewHeading = reviewModal.querySelector('h2');
        if (reviewHeading) reviewHeading.textContent = '本轮投递已完成';
        reviewModal.querySelectorAll('.bqa-review-row__status.is-done').forEach(status => status.remove());
        const summary = reviewModal.querySelector('.bqa-modal__intro');
        if (summary) summary.innerHTML = result;
        const stop = reviewModal.querySelector('[data-close], [data-live-stop]');
        if (stop) {
          const close = stop.cloneNode(true);
          close.textContent = '完成';
          close.disabled = false;
          stop.replaceWith(close);
          close.addEventListener('click', closeModal);
        }
        if (skipped.length) {
          const actions = reviewModal.querySelector('.bqa-modal__actions');
          const retry = document.createElement('button');
          retry.type = 'button';
          retry.className = 'bqa-button bqa-button--primary';
          retry.dataset.retryFailed = 'true';
          retry.textContent = `重新投递失败岗位（${skipped.length}）`;
          retry.addEventListener('click', () => retryFailedBatch(reviewModal, skipped));
          actions?.insertBefore(retry, actions.firstChild);
        }
        return;
      }
      modalShell(skipped.length ? '本轮投递未全部完成' : '本轮投递已完成', skipped.length
        ? `${result}<p class="bqa-modal__intro">失败岗位未计入已投递，你可以稍后重新尝试。</p><div class="bqa-batch-missing">${skipped.map(job => `<span>${escapeHtml(job.title)} · ${escapeHtml(job.company || '公司待确认')}<small>${escapeHtml(job.error || '未完成')}</small></span>`).join('')}</div>`
      : `${result}<p class="bqa-modal__intro">${batch.useBossNativeGreeting === true
        ? '已通过 BOSS 页面点击“立即沟通”建立全部沟通。插件没有生成或发送招呼语；招呼语及是否自动发送由 BOSS 端设置决定。'
        : batch.aiGreetingEnabled === false ? '已完成全部确认岗位的沟通建立，未发送插件招呼。BOSS 端自动招呼仍由 BOSS 设置控制。' : '已完成全部确认岗位的专属招呼与投递。'}你可以继续浏览新的岗位。</p>`);
      return;
    }
    const job = batch.jobs[batch.index];
    try {
      if (!job.cachedJd || !job.securityId || !job.encryptJobId) {
        throw new Error('预览阶段未成功缓存该岗位的 JD 或安全标识');
      }
      const settings = currentSettings;
      let greeting = '';
      if (batch.aiGreetingEnabled !== false) {
        const response = await retryBatchStep(batch, '正在生成专属话术', async () => {
          const result = await sendBackgroundRequest({ type: 'BQA_GENERATE_GREETING', settings, job: { ...job, jd: job.cachedJd } }, '话术生成');
          if (!result?.ok || !result.greeting?.trim()) throw new Error(result?.error || '专属招呼语生成失败');
          return result;
        }, 1);
        greeting = response.greeting;
      }
      const pending = { jobId: job.id, title: job.title, company: job.company, salary: job.salary, salaryFont: job.salaryFont, detailUrl: job.detailUrl, securityId: job.securityId, encryptJobId: job.encryptJobId, greeting, greetingMode: batch.useBossNativeGreeting === true ? 'boss-native' : settings.greetingMode === 'page' ? 'page' : 'background', sessionId: batch.sessionId, deliveryJob: job };
      if (batch.aiGreetingEnabled === false && batch.useBossNativeGreeting !== true) {
        const established = await retryBatchStep(batch, '正在建立 BOSS 沟通（AI 招呼已关闭）', () => establishConversationWithoutGreeting(pending), 1);
        if (established?.synced === false) console.warn('[BOSS 智能投递] 沟通已建立，但投递状态同步失败');
        persistedDeliveredJobs.set(job.id, established?.job || { id: pending.jobId, title: pending.title, company: pending.company, salary: pending.salary, salaryFont: pending.salaryFont, detailUrl: pending.detailUrl, deliveredAt: Date.now() });
        renderDailyDeliveryQuota();
        applyListFilters();
        cardForJob(job)?.classList.add('bqa-dismissed-card', 'bqa-hidden-card');
        batch.index += 1;
        batch.stage = '沟通已建立（AI 招呼已关闭）';
        await setStored(BATCH_KEY, batch);
        if (batch.index < batch.jobs.length) await waitForBatchDelay(batch, randomDeliveryPause(), '沟通已建立，等待下一岗位（1–3 秒）');
        await runBatchStep();
        return;
      }
      if (pending.greetingMode === 'page' || pending.greetingMode === 'boss-native') {
        if (!pending.detailUrl) throw new Error('缺少岗位详情链接，无法打开页面发送招呼语');
        batch.waitingForChat = true;
        batch.stage = pending.greetingMode === 'boss-native' ? '正在通过 BOSS 页面建立沟通' : '正在打开岗位对话页';
        await setStored(BATCH_KEY, batch);
        await updateDeliveryRecord(job, batch.stage, { sessionId: batch.sessionId }).catch(() => {});
        const url = `${pending.detailUrl.split('#')[0]}#bqa-chat=${encodeURIComponent(batch.sessionId)}`;
        const opened = await sendBackgroundRequest({
          type: 'BQA_OPEN_CHAT_TAB',
          url,
          reuseTabId: Number(batch.chatTabId) || 0,
        }, '打开岗位对话页');
        if (!opened?.ok) {
          batch.waitingForChat = false;
          await setStored(BATCH_KEY, batch);
          throw new Error(opened?.error || '未能打开岗位对话页');
        }
        // 先保存共用标签页 ID 再发布待处理任务，其他旧详情页或聊天页无法抢占。
        pending.chatTabId = Number(opened.tabId) || 0;
        if (!pending.chatTabId) throw new Error('新开的岗位对话页未返回标签标识');
        batch.chatTabId = pending.chatTabId;
        await setStored(BATCH_KEY, batch);
        await setStored(PENDING_CHAT_KEY, pending);
        return;
      }
      try {
        const sent = await retryBatchStep(batch, '正在直连建立沟通并发送消息', () => sendGreetingDirectly(pending, { establishConversation: true }), 1);
        if (sent?.blocked) {
          // 发送锁意味着上一轮已发送或仍在发送。宁可提示用户核对，也绝不再发第二条消息。
          await updateDeliveryRecord(job, '已阻止重复发送，待核对', { sessionId: batch.sessionId, error: sent.syncError || '该岗位已被发送锁保护' }).catch(() => {});
          batch.index += 1;
          batch.stage = '已阻止重复发送，准备下一个岗位';
          await setStored(BATCH_KEY, batch);
          if (batch.index < batch.jobs.length) await waitForBatchDelay(batch, randomDeliveryPause(), batch.stage);
          await runBatchStep();
          return;
        }
        // 发送成功后由后台原子写入“已投递”与沟通记录，内容页即使随后被关闭也不会丢状态。
        if (sent?.synced === false) console.warn('[BOSS 智能投递] 消息已发送，但投递状态同步失败', sent.syncError || '未知错误');
        persistedDeliveredJobs.set(job.id, sent?.job || { id: pending.jobId, title: pending.title, company: pending.company, salary: pending.salary, salaryFont: pending.salaryFont, detailUrl: pending.detailUrl, deliveredAt: Date.now() });
        renderDailyDeliveryQuota();
        applyListFilters();
        cardForJob(job)?.classList.add('bqa-dismissed-card', 'bqa-hidden-card');
        batch.index += 1;
        batch.stage = '已发送，准备下一个岗位';
        await setStored(BATCH_KEY, batch);
        // 单岗位完成后立即反馈；只有同一批次存在下一岗位时才保留随机间隔。
        if (batch.index < batch.jobs.length) await waitForBatchDelay(batch, randomDeliveryPause(), '已发送，等待下一岗位（1–3 秒）');
        await runBatchStep();
        return;
      } catch (directError) {
        throw new Error(`列表页直连失败：${directError?.message || String(directError)}`);
      }
    } catch (error) {
      console.warn('[BOSS 智能投递]', error);
      if (error?.code === 'BQA_BATCH_STOPPED') return;
      if (error?.code === 'BQA_DAILY_DELIVERY_LIMIT') {
        await stopBatchForDailyLimit(batch, error.message);
        return;
      }
      batch.skipped = [...(batch.skipped || []), { ...job, error: error.message || '投递过程发生错误' }];
      await updateDeliveryRecord(job, '投递失败', { sessionId: batch.sessionId, error: error.message || '投递过程发生错误' }).catch(() => {});
      batch.index += 1;
      batch.waitingForChat = false;
      await setStored(BATCH_KEY, batch);
      try {
        if (batch.index < batch.jobs.length) await waitForBatchDelay(batch, randomDeliveryPause(), '发送失败，等待下一岗位（1–3 秒）');
      } catch (pauseError) {
        if (pauseError?.code === 'BQA_BATCH_STOPPED') return;
        throw pauseError;
      }
      await runBatchStep();
    }
  }

  async function resumePendingChat() {
    if (!onChatPage()) return;
    const pending = await getStored(PENDING_CHAT_KEY);
    const batch = await getStored(BATCH_KEY);
    // BOSS 聊天页经常会重写 URL 并清掉 #bqa-chat。只要当前活动批次与待处理
    // 岗位一致，就应继续发送；不能再依赖 hash，否则页面点击模式会静默卡住。
    if (!pending || !batch?.active || pending.sessionId !== batch.sessionId || !(await pendingMatchesCurrentTab(pending))) return;
    if (batch?.active) renderBatchProgress(batch);
    let stopped = false;
    try {
      const usesBossGreeting = pending.greetingMode === 'boss-native';
      const sendGreeting = () => sendGreetingInChat(pending);
      const recordCommunication = () => rememberDeliveredJob({ id: pending.jobId, title: pending.title, company: pending.company, salary: pending.salary, salaryFont: pending.salaryFont, detailUrl: pending.detailUrl });
      if (batch?.active) {
        if (usesBossGreeting) await retryBatchStep(batch, '等待 BOSS 自动招呼', () => sleep(1000));
        else await retryBatchStep(batch, '正在发送招呼语', sendGreeting);
        await retryBatchStep(batch, usesBossGreeting ? '正在记录 BOSS 沟通结果' : '正在记录沟通结果', recordCommunication);
      } else {
        if (usesBossGreeting) await sleep(1000);
        else await sendGreeting();
        await recordCommunication();
      }
    } catch (error) {
      console.warn('[BOSS 智能投递]', error);
      if (error?.code === 'BQA_BATCH_STOPPED') stopped = true;
      if (batch?.active) {
        if (!stopped) {
          const job = batch.jobs?.[batch.index] || pending;
          batch.skipped = [...(batch.skipped || []), { ...job, error: error.message || '沟通或招呼流程失败' }];
          await updateDeliveryRecord(job, '投递失败', { sessionId: batch.sessionId, error: error.message || '沟通或招呼流程失败' }).catch(() => {});
        }
      }
    } finally {
      const latest = await getStored(BATCH_KEY);
      if (!stopped && latest?.active && latest.sessionId === batch.sessionId) {
        batch.index += 1;
        batch.waitingForChat = false;
        batch.stage = '正在返回岗位列表';
        await setStored(BATCH_KEY, batch);
        renderBatchProgress(batch);
      }
      await removeStored(PENDING_CHAT_KEY);
      await sleep(700);
      if (!batch?.active || batch.index >= (batch.jobs?.length || 0)) {
        void chrome.runtime.sendMessage({ type: 'BQA_CLOSE_CURRENT_TAB' }).catch(() => {});
      }
    }
  }

  async function failPendingPageClickDelivery(pending, errorMessage, stage = '岗位详情页点击失败，准备下一个岗位') {
    const batch = await getStored(BATCH_KEY);
    if (!batch?.active || batch.sessionId !== pending?.sessionId || !batch.waitingForChat) return false;
    const job = batch.jobs?.[batch.index] || pending.deliveryJob || pending;
    batch.skipped = [...(batch.skipped || []), { ...job, error: errorMessage }];
    batch.index += 1;
    batch.waitingForChat = false;
    batch.stage = stage;
    batch.stageUpdatedAt = Date.now();
    if (!(await setStored(BATCH_KEY, batch))) {
      showNotice(lastStorageWriteError || '投递进度保存失败，稍后会自动重试恢复', 'error');
      return false;
    }
    await updateDeliveryRecord(job, '投递失败', { sessionId: batch.sessionId, error: errorMessage }).catch(() => {});
    const latestPending = await getStored(PENDING_CHAT_KEY).catch(() => null);
    if (latestPending?.sessionId === pending.sessionId && latestPending?.jobId === pending.jobId) {
      await removeStored(PENDING_CHAT_KEY);
    }
    if (!batch.active || batch.index >= (batch.jobs?.length || 0)) {
      void chrome.runtime.sendMessage({ type: 'BQA_CLOSE_CURRENT_TAB' }).catch(() => {});
    }
    return true;
  }

  async function openPendingChatInNewTab() {
    const pending = await getStored(PENDING_CHAT_KEY);
    const batch = await getStored(BATCH_KEY);
    // BOSS 从详情页进入聊天页时经常会重写 URL 并清掉 hash，不能把 hash
    // 当作页面点击投递是否继续的必要条件。待处理任务和活动批次才是唯一依据。
    if (!pending || !batch?.active || pending.sessionId !== batch.sessionId || !(await pendingMatchesCurrentTab(pending))) return;
    if (onChatPage()) { await resumePendingChat(); return; }
    try {
      // 这段会操作 BOSS 页面，不能整段重试，避免页面已响应但扩展未观察到时重复点击。
      await retryBatchStep(batch, '正在进入岗位对话', () => openDedicatedChatFromDetail(pending), 1);
      // BOSS 可能在同一个 SPA 文档内切换到消息页，不会重新执行 content.js。
      // 此时主动继续恢复待发送任务，避免只停在“已进入对话页”。
      if (onChatPage()) await resumePendingChat();
    } catch (error) {
      console.warn('[BOSS 智能投递] 页面点击进入详情页失败', error);
      await reportPageClickStage('页面点击恢复失败', `错误=${error.message || '无法进入岗位对话'}`).catch(() => {});
      await failPendingPageClickDelivery(pending, error.message || '无法进入岗位对话');
    }
  }

  async function recoverPageClickDelivery() {
    if (!onChatPage() && !onJobDetailPage()) return;
    const pending = await getStored(PENDING_CHAT_KEY);
    const batch = await getStored(BATCH_KEY);
    if (!pending || !batch?.active || !['page', 'boss-native'].includes(pending.greetingMode) || pending.sessionId !== batch.sessionId) return;
    if (!(await pendingMatchesCurrentTab(pending))) return;
    if (onChatPage()) return resumePendingChat();
    if (onJobDetailPage() && batch.waitingForChat) return openPendingChatInNewTab();
  }

  // 新标签页的 content script 往往先于 bqa-pending-chat 写入完成。持续短轮询，
  // 确保任务到达后一定会触发详情页的“立即沟通”流程，而不是静默停在详情页。
  function schedulePageClickRecovery() {
    if (!onJobDetailPage() || pageClickRecoveryTimer || pageClickRecoveryRunning) return;
    pageClickRecoveryAttempts = 0;
    const poll = async () => {
      pageClickRecoveryTimer = 0;
      if (!onJobDetailPage() || pageClickRecoveryRunning || pageClickRecoveryAttempts >= 40) return;
      pageClickRecoveryAttempts += 1;
      pageClickRecoveryRunning = true;
      try {
        await recoverPageClickDelivery();
      } catch (error) {
        console.warn('[BOSS 智能投递] 页面点击恢复失败', error);
        const pending = await getStored(PENDING_CHAT_KEY).catch(() => null);
        if (pending?.deliveryJob) {
          await updateDeliveryRecord(pending.deliveryJob, '页面点击恢复失败', { error: error.message || '未知错误' }).catch(() => {});
        }
      } finally {
        pageClickRecoveryRunning = false;
      }
      const pending = await getStored(PENDING_CHAT_KEY).catch(() => null);
      const batch = await getStored(BATCH_KEY).catch(() => null);
      if (onJobDetailPage() && pending && batch?.active && batch.waitingForChat && pageClickRecoveryAttempts < 40) {
        pageClickRecoveryTimer = setTimeout(poll, 500);
      } else if (onJobDetailPage() && pageClickRecoveryAttempts >= 40 && batch?.active && batch.waitingForChat) {
        const message = '页面点击恢复超时：未能开始点击“立即沟通”，请检查岗位详情页是否已加载完成';
        showNotice(message, 'error');
        const finalized = pending && await failPendingPageClickDelivery(pending, message, '页面点击恢复超时，准备下一个岗位');
        if (!finalized && onJobDetailPage()) {
          pageClickRecoveryAttempts = 0;
          pageClickRecoveryTimer = setTimeout(poll, 1000);
        }
      }
    };
    pageClickRecoveryTimer = setTimeout(poll, 250);
  }

  async function startAiFlow({ batchId = '' } = {}) {
    if (window.__bqaAiFlowRunning) {
      const reopened = activeLiveReview?.reopen?.() || false;
      showNotice(reopened ? '已重新打开当前识别窗口；当前请求结束后可重新开始' : '岗位识别正在进行中，请勿重复启动', reopened ? 'success' : 'error');
      if (batchId) void chrome.runtime.sendMessage({ type: 'BQA_AUTO_SEARCH_BATCH_ABORT', batchId }).catch(() => {});
      return;
    }
    let settings;
    try { settings = await getSettings(); } catch (error) {
      if (batchId) void chrome.runtime.sendMessage({ type: 'BQA_AUTO_SEARCH_BATCH_ABORT', batchId }).catch(() => {});
      showNotice(`读取求职助手配置失败：${error?.message || '请检查插件配置'}`, 'error');
      return;
    }
    if (!settings.apiUrl || !settings.apiKey || !settings.model || !settings.resumePdfText) {
      if (batchId) void chrome.runtime.sendMessage({ type: 'BQA_AUTO_SEARCH_BATCH_ABORT', batchId }).catch(() => {});
      showSettings(startAiFlow);
      return;
    }
    window.__bqaAiFlowRunning = true;
    activeAiFlowSettings = settings;
    pauseJobListObserver();
    removeAutomationButtons();
    setDailyDeliveryLimit(settings.dailyDeliveryLimit);
    const launcher = document.querySelector(`.${LAUNCHER_CLASS}`);
    const delivered = await getDelivered();
    launcher?.classList.add('is-thinking');
    // 先展示空预览，避免用户在多页识别与 AI 筛选期间无反馈；自动投递模式也会显示这一过程。
    const liveReview = createLiveReview(delivered, settings, batchId);
    const startedAt = Date.now();
    const runUrl = new URL(location.href);
    let runStatus = {
      runId: `run-${startedAt}-${Math.random().toString(36).slice(2, 7)}`,
      status: 'running', startedAt, updatedAt: startedAt,
      keyword: runUrl.searchParams.get('query') || runUrl.searchParams.get('keyword') || '',
      city: runUrl.searchParams.get('city') || '',
      jobType: runUrl.searchParams.get('jobType') || '',
      eligible: 0, screened: 0, matched: 0, excluded: 0, pageNew: 0, pageRepeated: 0, recommended: 0, page: 0, phase: '准备开始',
    };
    let runStatusTimer = 0;
    const persistRunStatus = (patch = {}, immediate = false) => {
      runStatus = { ...runStatus, ...patch, updatedAt: Date.now() };
      runStatus.phase = String(runStatus.phase || '').replace(settings.apiKey || '\u0000', '[已隐藏 API Key]').replace(/sk-[A-Za-z0-9_-]{12,}/g, '[已隐藏密钥]').slice(0, 100);
      clearTimeout(runStatusTimer);
      const snapshot = { ...runStatus };
      const save = () => chrome.storage.local.set({ [SEARCH_RUN_STATUS_KEY]: snapshot }, () => {
        if (chrome.runtime.lastError) console.warn('[BOSS 求职加速器] 搜索进度保存失败', chrome.runtime.lastError.message);
      });
      if (immediate) save();
      else runStatusTimer = setTimeout(save, 800);
    };
    persistRunStatus({}, true);
    try {
      const collected = await collectAndScreenRecommendedJobs(settings, delivered, progress => {
        persistRunStatus({
          eligible: Number(progress.eligible || 0), screened: Number(progress.screened || 0),
          matched: Number(progress.matched || 0), excluded: Number(progress.excluded || 0),
          pageNew: Number(progress.pageNew || 0), pageRepeated: Number(progress.pageRepeated || 0),
          recommended: Number(progress.recommended || 0), page: Number(progress.page || 0), phase: String(progress.phase || '识别中').slice(0, 100),
        });
        launcher?.querySelector('.bqa-ai-launcher__label')?.setAttribute(
          'data-progress',
          `已识别 ${progress.eligible} · 推荐 ${progress.recommended}/${dailyDeliveryLimit}`,
        );
        liveReview.update(progress);
      }, () => liveReview.isCancelled(), {
        shouldAutoDeliver: () => liveReview.shouldAutoDeliver(),
        shouldStopForDailyLimit: () => liveReview.shouldStopForDailyLimit(),
        onLog: (message, level) => liveReview.log(message, level),
        onAutoDeliver: async job => {
          // 对齐参考项目：单岗位通过筛选并读取完详情后立即投递，不等整轮识别完成。
          liveReview.markAutoDeliveryStarted(job.id);
          try {
            const queued = await startBatchDelivery([job.id], [job], { silentCompletion: true, completionNotice: false });
            if (queued?.ok === false) throw new Error(queued.error || '未能加入投递队列');
            // 额度是生产端与消费者唯一需要共享的业务状态；不能再读取其他任务的执行批次。
            if (dailyDeliveryLimitReached()) throw dailyDeliveryLimitError();
            if ((await getDelivered()).has(job.id)) liveReview.markAutoDelivered(job.id);
          } catch (error) {
            liveReview.markAutoDeliveryFailed(job.id, error?.message || '投递任务启动失败');
            await updateDeliveryRecord(job, '投递失败', { error: error?.message || '投递任务启动失败' }).catch(() => {});
            throw error;
          }
        },
      });
      const jobs = collected.jobs;
      persistRunStatus({ status: collected.error ? 'partial' : 'completed', phase: collected.error ? '识别中断，已保留已有结果' : '识别完成', finishedAt: Date.now() }, true);
      if (!jobs.length) {
        liveReview.finish(jobs, collected.eligible, { partialError: collected.error?.message || '' });
        return;
      }
      liveReview.finish(jobs, collected.eligible, { partialError: collected.error?.message || '' });
    } catch (error) {
      if (error?.code === 'BQA_DISCOVERY_STOPPED') {
        persistRunStatus({ status: 'stopped', phase: '用户停止', finishedAt: Date.now() }, true);
        liveReview.finishAfterCancel();
        return;
      }
      if (error?.code === 'BQA_DAILY_DELIVERY_LIMIT') {
        persistRunStatus({ status: 'daily-limit', phase: '达到今日投递上限', finishedAt: Date.now() }, true);
        liveReview.finishForDailyLimit();
        return;
      }
      persistRunStatus({ status: 'failed', phase: String(error?.message || '识别失败').slice(0, 100), finishedAt: Date.now() }, true);
      liveReview.fail(error);
    } finally {
      if (runStatus.status === 'running') persistRunStatus({ status: 'interrupted', phase: '任务提前结束', finishedAt: Date.now() }, true);
      window.__bqaAiFlowRunning = false;
      if (activeAiFlowSettings === settings) activeAiFlowSettings = null;
      launcher?.classList.remove('is-thinking');
      launcher?.querySelector('.bqa-ai-launcher__label')?.removeAttribute('data-progress');
      restoreDismissButtons();
      resumeJobListObserver();
      if (batchId) {
        const type = liveReview.isCancelled() ? 'BQA_AUTO_SEARCH_BATCH_ABORT' : 'BQA_AUTO_SEARCH_BATCH_COMPLETE';
        void chrome.runtime.sendMessage({ type, batchId }).catch(() => {});
      }
    }
  }

  function ensureAiLauncher() {
    if (document.querySelector(`.${LAUNCHER_CLASS}`)) return;
    const launcher = document.createElement('div');
    launcher.className = LAUNCHER_CLASS;
    const onHome = onBossHomePage();
    launcher.dataset.page = onHome ? 'home' : (onJobsPage() ? 'jobs' : 'other');
    launcher.innerHTML = '<button type="button" class="bqa-ai-launcher__start" aria-label="打开 BOSS打招呼助手" data-bqa-tip="打开 BOSS打招呼助手"><span class="bqa-ai-launcher__spark">✦</span><span class="bqa-ai-launcher__copy"><span class="bqa-ai-launcher__eyebrow">BOSS打招呼助手</span><span class="bqa-ai-launcher__label">AI 岗位筛选</span></span></button><button type="button" class="bqa-ai-launcher__settings" aria-label="插件设置" data-bqa-tip="插件设置"><span aria-hidden="true">⚙</span></button><span class="bqa-ai-launcher__drag" title="按住后上下拖动位置" aria-label="拖动位置"></span>';
    const startButton = launcher.querySelector('.bqa-ai-launcher__start');
    const eyebrow = launcher.querySelector('.bqa-ai-launcher__eyebrow');
    const label = launcher.querySelector('.bqa-ai-launcher__label');
    if (onHome) {
      eyebrow.textContent = 'BOSS 首页';
      label.textContent = '召唤助手';
      startButton.setAttribute('aria-label', '召唤 AI 求职助手');
      startButton.dataset.bqaTip = '使用已保存的搜索条件';
    } else if (onJobsPage()) {
      eyebrow.textContent = 'AI 岗位筛选';
      label.textContent = `今日投递 ${todayDeliveryCount()}/${dailyDeliveryLimit}`;
      startButton.setAttribute('aria-label', '开始 AI 岗位筛选');
      startButton.dataset.bqaTip = '开始 AI 岗位筛选';
    } else {
      eyebrow.textContent = 'AI 求职助手';
      label.textContent = '打开筛选设置';
      startButton.dataset.bqaTip = '打开插件设置';
    }
    startButton.addEventListener('click', () => {
      if (onBossHomePage()) {
        void openHomeAssistant();
        return;
      }
      if (!onJobsPage()) {
        void showSettings(undefined, { initialTab: 'basic' });
        return;
      }
      startAiFlow();
    });
    const settingsButton = launcher.querySelector('.bqa-ai-launcher__settings');
    const openSettings = () => showSettings();
    settingsButton.addEventListener('click', openSettings);
    let startY = 0;
    let startTop = 96;
    let dragging = false;
    const clampTop = value => Math.max(12, Math.min(window.innerHeight - launcher.offsetHeight - 12, value));
    const dragHandle = launcher.querySelector('.bqa-ai-launcher__drag');
    dragHandle.addEventListener('pointerdown', event => {
      if (event.button !== 0) return;
      startY = event.clientY;
      startTop = launcher.getBoundingClientRect().top;
      dragging = false;
      dragHandle.setPointerCapture?.(event.pointerId);
      event.preventDefault();
    });
    dragHandle.addEventListener('pointermove', event => {
      if (!dragHandle.hasPointerCapture?.(event.pointerId)) return;
      const distance = event.clientY - startY;
      if (Math.abs(distance) > 4) dragging = true;
      if (!dragging) return;
      launcher.classList.add('is-dragging');
      launcher.style.top = `${Math.round(clampTop(startTop + distance))}px`;
      event.preventDefault();
    });
    dragHandle.addEventListener('pointerup', event => {
      if (!dragHandle.hasPointerCapture?.(event.pointerId)) return;
      dragHandle.releasePointerCapture?.(event.pointerId);
      launcher.classList.remove('is-dragging');
      if (!dragging) return;
      void setStored(LAUNCHER_POSITION_KEY, Math.round(launcher.getBoundingClientRect().top));
    });
    document.body.appendChild(launcher);
    readStorage(LAUNCHER_POSITION_KEY, 96).then(top => {
      if (!Number.isFinite(Number(top))) return;
      launcher.style.top = `${Math.round(clampTop(Number(top)))}px`;
    });
    renderDailyDeliveryQuota();
  }

  async function startScheduledAutoSearchIfNeeded() {
    if (!onJobsPage()) return;
    try {
      const response = await chrome.runtime.sendMessage({ type: 'BQA_CONSUME_AUTO_SEARCH' });
      if (!response?.ok || !response.run) return;
      // 等待 BOSS 异步挂载岗位卡片后再开始，避免误判为空列表。
      setTimeout(() => startAiFlow({ batchId: response.batchId || '' }), 1400);
    } catch (error) {
      console.warn('[BOSS 求职加速器] 自动搜索启动失败', error);
    }
  }

  let scheduled = false;
  const schedule = () => {
    if (scheduled) return;
    scheduled = true;
    scheduleTimer = setTimeout(() => requestAnimationFrame(() => {
      scheduled = false;
      if (!document.body) {
        document.addEventListener('DOMContentLoaded', schedule, { once: true });
        return;
      }
      ensureAiLauncher();
      if (onJobsPage()) addButtons();
      if (onJobDetailPage()) addDetailButtons();
      if (onChatPage()) syncUnreadMessageBadge();
    }), 500);
  };

  // 所有 BOSS 页面（包括首页）都注入助手入口；岗位动作仍只在岗位页启用。
  schedule();

  jobListObserver = new MutationObserver(mutations => {
    // 自动识别/投递期间页面会持续更新进度和聊天状态，此时不需要重新扫描职位卡片。
    if (!onJobsPage() || automationBusy()) return;
    for (const mutation of mutations) {
      if (mutationAddsJobCard(mutation)) {
        schedule();
        break;
      }
    }
  });
  if (onJobsPage()) jobListObserver.observe(document.documentElement, { childList: true, subtree: true });
  if (onJobDetailPage()) {
    // 详情头部异步渲染，动作区就绪后才注入；十秒后断开，避免常驻扫描。
    const detailObserver = new MutationObserver(() => {
      if (document.querySelector('.bqa-detail-actions')) {
        detailObserver.disconnect();
        return;
      }
      if (detailActionHost()) schedule();
    });
    detailObserver.observe(document.documentElement, { childList: true, subtree: true });
    setTimeout(() => detailObserver.disconnect(), 10000);
    schedule();
  }
  if (onJobsPage()) {
    restorePersistentFilters().catch(error => {
      console.warn('[BOSS 求职加速器] 未能恢复屏蔽记录', error);
    }).finally(() => {
      schedule();
      void startScheduledAutoSearchIfNeeded();
    });
  }
  if (onChatPage()) {
    syncUnreadMessageBadge(true);
    scheduleUnreadBadgePoll();
  }
  if (requestedUnreadMessagesTab()) selectUnreadMessagesTabWhenReady();
  // 页面点击模式不依赖 URL hash 恢复；BOSS 改写地址后仍能继续处理待发送岗位。
  void recoverPageClickDelivery();
  schedulePageClickRecovery();
  chrome.runtime.onMessage.addListener((message = {}, _sender, sendResponse) => {
    if (message.type === 'BQA_SELECT_UNREAD_MESSAGES' && onChatPage()) {
      selectUnreadMessagesTabWhenReady();
      sendResponse({ ok: true });
      return false;
    }
    if (message.type === 'BQA_RUN_QUEUED_DELIVERY_TASK' && onJobsPage()) {
      const task = message.task;
      if (!task?.jobs?.length) { sendResponse({ ok: false, error: '队列任务缺少岗位数据' }); return; }
      sendResponse({ ok: true });
      runQueuedDeliveryTask(task);
      return false;
    }
  });
  chrome.storage.onChanged.addListener((changes = {}) => {
    if (!onJobsPage()) return;
    if (changes[SETTINGS_KEY]) {
      setDailyDeliveryLimit(changes[SETTINGS_KEY].newValue?.dailyDeliveryLimit);
      renderDailyDeliveryQuota();
      if (dailyDeliveryLimitReached()) void stopBatchDeliveryForReachedQuota();
      const saved = changes[SETTINGS_KEY].newValue || {};
      if (window.__bqaAiFlowRunning && activeAiFlowSettings) {
        const previousPrompt = screeningConfigValue(activeAiFlowSettings.screeningPrompt || DEFAULT_SCREENING_PROMPT);
        const updated = {
          ...activeAiFlowSettings,
          resumePdfText: saved.resumePdfText ?? activeAiFlowSettings.resumePdfText,
          targetProfile: saved.targetProfile ?? activeAiFlowSettings.targetProfile,
          screeningPrompt: saved.screeningPrompt || DEFAULT_SCREENING_PROMPT,
          profiles: Array.isArray(saved.profiles) ? saved.profiles.map(profile => ({ ...profile })) : activeAiFlowSettings.profiles,
        };
        Object.assign(activeAiFlowSettings, updated, { screeningVersion: screeningVersionFor(updated) });
        const nextPrompt = screeningConfigValue(activeAiFlowSettings.screeningPrompt || DEFAULT_SCREENING_PROMPT);
        if (nextPrompt !== previousPrompt) {
          activeLiveReview?.log('岗位识别提示词已更新，当前任务从下一条岗位开始使用新提示词');
        }
      }
    }
    if (changes[DELIVERED_KEY]) {
      persistedDeliveredJobs = storedJobsMap(changes[DELIVERED_KEY].newValue, 'delivered');
      applyListFilters();
      renderDailyDeliveryQuota();
      document.dispatchEvent(new Event('bqa-delivery-count-changed'));
      // 本页正在等待下一岗位时，别等延迟结束再发现额度耗尽；立即让批次失效。
      if (dailyDeliveryLimitReached()) void stopBatchDeliveryForReachedQuota();
    }
    if (changes[DELIVERY_RECORDS_KEY]) {
      const records = changes[DELIVERY_RECORDS_KEY].newValue || [];
      persistedDeliveryRecords = storedJobsMap(records, 'delivery-record');
      activeLiveReview?.syncDeliveryRecords(records);
      applyListFilters();
      const byId = new Map(records
        .map(normalizeStoredJob)
        .filter(record => canonicalJobId(record?.id))
        .map(record => [canonicalJobId(record.id), record]));
      document.querySelectorAll(`.${BUTTON_CLASS}`).forEach(button => {
        const id = button.closest('.bqa-detail-actions') ? readDetailJob().id : jobId(jobCard(button));
        const record = byId.get(id);
        if (!record?.deliveryStatus) return;
        if (record.deliveryStatus === '已投递') {
          button.textContent = '已投递';
          button.disabled = true;
          status.set(button, 'done');
        } else if (record.deliveryStatus === '投递失败') {
          button.textContent = '重试投递';
          button.disabled = false;
          status.set(button, 'error');
        } else {
          button.textContent = record.deliveryStatus.includes('排队') ? '排队中' : '投递中…';
          button.disabled = true;
          status.set(button, 'waiting');
        }
      });
    }
    const taskQueueChange = changes[DELIVERY_TASK_QUEUE_KEY];
    if (!taskQueueChange) return;
    const activeTask = taskQueueChange.newValue?.active;
    if (activeTask && onJobsPage()) claimAndRunQueuedDeliveryTask(activeTask);
    const nextBatch = activeTask?.execution;
    const previousBatch = taskQueueChange.oldValue?.active?.execution;
    if (!nextBatch?.active) {
      renderBatchProgress(null);
      resetBatchLauncher();
      if (chatSessionFromLocation()) void chrome.runtime.sendMessage({ type: 'BQA_CLOSE_CURRENT_TAB' }).catch(() => {});
    }
    // 仅在新标签页完成（等待沟通 → 不再等待）时继续下一岗位。
    // 读取 JD、生成话术等阶段也会持久化进度，不能据此再次启动同一岗位。
    if (nextBatch?.active && previousBatch?.waitingForChat && !nextBatch.waitingForChat && onJobsPage() && !chatSessionFromLocation()) {
      setTimeout(runBatchStep, 450);
    }
  });
  // 页面在队列任务已被后台选中之后才加载时，storage.onChanged 不会补发历史事件；
  // 启动时主动读取一次，保证刷新页面也能接管属于自己的任务。
  if (onJobsPage()) {
    const claimCurrentDeliveryTask = () => chrome.storage.local.get(DELIVERY_TASK_QUEUE_KEY, data => {
      const task = data[DELIVERY_TASK_QUEUE_KEY]?.active;
      if (task) claimAndRunQueuedDeliveryTask(task);
      queuePollTimer = setTimeout(claimCurrentDeliveryTask, task ? 3000 : 30000);
    });
    let queuePollTimer = 0;
    claimCurrentDeliveryTask();
    // storage.onChanged 在扩展升级、页面恢复或 worker 重启的极端时序下可能错过一次。
    // 有活动任务时快速轮询，无任务时降频，避免空闲页面持续唤醒扩展。
  }
})();


