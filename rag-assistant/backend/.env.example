# 本地 Ollama 服务地址
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 聊天模型：请先通过 ollama pull 下载
OLLAMA_CHAT_MODEL=qwen3.5:9b
# 向量模型：你的环境说明中已有 bge-m3
OLLAMA_EMBED_MODEL=bge-m3
# CPU 向量化每批分片数；小批次便于及时显示同步进度。
RAG_EMBED_BATCH_SIZE=16
# 每次提问从每个知识库召回的片段数
RAG_TOP_K=4

# 最低相关度（0-1）；先用评测脚本核对，再按自己的资料调整
RAG_MIN_RELEVANCE=0.25
# 单个文件最大 30 MB
MAX_UPLOAD_MB=30

# Local e-commerce integration: keep the same long random value in the e-commerce backend.
ECOM_RAG_SYNC_TOKEN=replace-with-a-long-random-token

# 与 Agent 后端保持一致，使两页共享管理员登录状态。
YUGAN_ADMIN_USERNAME=
YUGAN_ADMIN_PASSWORD_HASH=
YUGAN_AUTH_SIGNING_SECRET=
# 部署前端使用其他域名时，将其完整 Origin 加到列表中，逗号分隔。
RAG_WEB_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
