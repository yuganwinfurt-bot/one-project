# 演示模式无网络、无 Key；接入真实模型时修改下面三项。
YUGAN_PROVIDER=mock
YUGAN_MODEL=demo
YUGAN_API_KEY=
# openai: Responses API；compatible: Chat Completions；anthropic: Messages API
# YUGAN_BASE_URL=https://api.openai.com/v1
# DeepSeek 默认启用思考；用兼容接口调用工具时可设置 YUGAN_THINKING=disabled。
# YUGAN_THINKING=disabled

YUGAN_WORKSPACE=./workspace
YUGAN_DATABASE=./.yugan/memory.db
YUGAN_LOG_FILE=./.yugan/events.jsonl
YUGAN_MAX_STEPS=8
YUGAN_MAX_TOOL_CALLS=24
YUGAN_CONTEXT_CHARS=32000
YUGAN_TOOL_TIMEOUT=10
YUGAN_MODEL_TIMEOUT=60
YUGAN_MAX_OUTPUT_TOKENS=2048
# CLI 中的有副作用工具默认拒绝；Web 桌面操作逐次弹窗确认。
YUGAN_ALLOWED_EFFECTS=[]
# 只读 HTTP 工具仅可调用在此显式配置的固定端点，不跟随重定向。
YUGAN_HTTP_ENDPOINTS={}
# API 默认只监听 127.0.0.1；设置令牌后 /api/* 需要 Bearer 认证。
YUGAN_API_TOKEN=
# Agent 页面与 RAG 页面共享浏览器登录；设置为实际 RAG 网页的来源（协议、域名、端口）。
YUGAN_RAG_WEB_ORIGIN=http://127.0.0.1:4173
# 电商前端可调用 Agent 服务器 Ollama；上线时改成电商网页的实际来源。
YUGAN_ECOMMERCE_WEB_ORIGIN=http://127.0.0.1:5173
# 服务器 Ollama 只供服务器模型选项使用，模型请求由 Agent 代理，不会接收用户 API Key。
YUGAN_SERVER_OLLAMA_URL=http://127.0.0.1:11434
# 管理员登录：Agent 与 RAG 两端使用相同配置以共享登录状态。
YUGAN_ADMIN_USERNAME=
YUGAN_ADMIN_PASSWORD_HASH=
YUGAN_AUTH_SIGNING_SECRET=
